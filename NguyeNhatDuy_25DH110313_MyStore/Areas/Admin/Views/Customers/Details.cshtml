
@model NguyeNhatDuy_25DH110313_MyStore.Models.Customer

@{
    ViewBag.Title = "Chi tiết khách hàng";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .customer-details-page {
        min-height: 100vh;
        padding: 35px 20px;
        background: #f5f7fb;
    }

    .customer-details-header {
        text-align: center;
        margin-bottom: 28px;
    }

        .customer-details-header h2 {
            color: #243247;
            font-size: 27px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .customer-details-header p {
            color: #8492a6;
            font-size: 14px;
            margin: 0;
        }

    .customer-details-container {
        max-width: 620px;
        margin: 0 auto;
    }

    .customer-details-card {
        max-width: 550px;
        margin: 0 auto;
        padding: 30px 38px;
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 16px;
        box-shadow: 0 6px 24px rgba(30, 50, 80, 0.07);
    }

    .details-avatar {
        width: 78px;
        height: 78px;
        margin: 0 auto 14px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e8efff, #d7e3ff);
        color: #3867d6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        font-weight: 700;
        border: 4px solid #f4f7ff;
    }

    .details-customer-name {
        text-align: center;
        color: #243247;
        font-size: 21px;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .details-subtitle {
        text-align: center;
        color: #98a3b3;
        font-size: 13px;
        margin-top: -18px;
        margin-bottom: 25px;
    }

    .details-info {
        padding: 13px 17px;
        margin-bottom: 12px;
        background: #f7f9fc;
        border: 1px solid #edf0f5;
        border-radius: 10px;
        text-align: left;
        transition: all 0.2s ease;
    }

        .details-info:hover {
            background: #f1f5fc;
            border-color: #dce6f8;
        }

        .details-info label {
            display: block;
            color: #8492a6;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .details-info p {
            color: #243247;
            font-size: 14px;
            font-weight: 600;
            margin: 0;
            word-break: break-word;
        }

    .account-badge {
        display: inline-block;
        padding: 5px 12px;
        background: #e8efff;
        color: #3867d6;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .password-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .password-text {
        flex: 1;
        color: #243247;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 2px;
        overflow-wrap: anywhere;
    }

    .btn-show-password {
        border: 1px solid #dce3ef;
        background: #fff;
        color: #536174;
        border-radius: 7px;
        padding: 6px 10px;
        cursor: pointer;
        font-size: 13px;
    }

        .btn-show-password:hover {
            background: #e8efff;
            color: #3867d6;
        }

    .details-actions {
        display: flex;
        justify-content: center;
        gap: 13px;
        margin-top: 27px;
    }

    .btn-edit,
    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 140px;
        padding: 11px 20px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-edit {
        background: #3867d6;
        color: #fff;
    }

        .btn-edit:hover {
            background: #2853bb;
            color: #fff;
            text-decoration: none;
            transform: translateY(-2px);
        }

    .btn-back {
        background: #f0f2f6;
        color: #536174;
    }

        .btn-back:hover {
            background: #e1e6ef;
            color: #243247;
            text-decoration: none;
            transform: translateY(-2px);
        }

    @@media (max-width: 576px) {
        .customer-details-page {
            padding: 25px 12px;
        }

        .customer-details-card {
            padding: 25px 20px;
        }

        .customer-details-header h2 {
            font-size: 23px;
        }

        .details-actions {
            flex-direction: column;
        }

        .btn-edit,
        .btn-back {
            width: 100%;
        }
    }
</style>

<div class="customer-details-page">

    <div class="customer-details-header">
        <h2>Chi tiết khách hàng</h2>
        <p>Xem thông tin chi tiết khách hàng trong hệ thống.</p>
    </div>

    <div class="customer-details-container">

        <div class="customer-details-card">

            <div class="details-avatar">
                @(string.IsNullOrEmpty(Model.CustomerName)
                    ? "C"
                    : Model.CustomerName.Substring(0, 1).ToUpper())
            </div>

            <div class="details-customer-name">
                @Model.CustomerName
            </div>

            <div class="details-subtitle">
                Thông tin khách hàng
            </div>

            <div class="details-info">
                <label>Mã khách hàng</label>
                <p>@Model.CustomerID</p>
            </div>

            <div class="details-info">
                <label>Tên khách hàng</label>
                <p>@Model.CustomerName</p>
            </div>

            <div class="details-info">
                <label>Số điện thoại</label>
                <p>
                    @(string.IsNullOrEmpty(Model.CustomerPhone)
                        ? "Chưa cập nhật"
                        : Model.CustomerPhone)
                </p>
            </div>

            <div class="details-info">
                <label>Email</label>
                <p>
                    @(string.IsNullOrEmpty(Model.CustomerEmail)
                        ? "Chưa cập nhật"
                        : Model.CustomerEmail)
                </p>
            </div>

            <div class="details-info">
                <label>Địa chỉ</label>
                <p>
                    @(string.IsNullOrEmpty(Model.CustomerAddress)
                        ? "Chưa cập nhật"
                        : Model.CustomerAddress)
                </p>
            </div>

            <div class="details-info">
                <label>Tài khoản liên kết</label>
                <p>
                    @if (Model.User != null)
                    {
                        <span class="account-badge">
                            @Model.Username
                        </span>
                    }
                    else
                    {
                        <span>Chưa liên kết tài khoản</span>
                    }
                </p>
            </div>

            <div class="details-actions">

                @Html.ActionLink(
                    "Chỉnh sửa",
                    "Edit",
                    new { id = Model.CustomerID },
                    new { @class = "btn-edit" }
                )

                @Html.ActionLink(
                    "Quay lại",
                    "Index",
                    null,
                    new { @class = "btn-back" }
                )

            </div>

        </div>
    </div>
</div>

<script>
    function toggleCustomerPassword() {
        var passwordElement = document.getElementById("customerPassword");
        var button = document.getElementById("btnShowPassword");

        if (!passwordElement || !button) {
            return;
        }

        if (button.textContent.indexOf("Hiện") >= 0) {
            passwordElement.textContent =
                passwordElement.getAttribute("data-password");

            button.textContent = "🙈 Ẩn";
        } else {
            passwordElement.textContent = "••••••••";
            button.textContent = "👁 Hiện";
        }
    }
</script>
