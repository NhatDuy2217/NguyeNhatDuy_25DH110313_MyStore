
@model NguyeNhatDuy_25DH110313_MyStore.Models.Customer

@{
    ViewBag.Title = "Thêm khách hàng";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .customer-create-page {
        width: 100%;
        min-height: 650px;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 25px 15px;
        box-sizing: border-box;
    }

    .customer-create-card {
        width: 100%;
        max-width: 680px;
        margin: 0 auto;
        padding: 28px 35px;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        box-sizing: border-box;
    }

    .customer-create-title {
        text-align: center;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #edf0f4;
    }

        .customer-create-title h2 {
            color: #263248;
            font-weight: 700;
            margin: 0 0 8px;
        }

        .customer-create-title p {
            color: #7b8495;
            margin: 0;
        }

    .customer-create-form {
        width: 100%;
        max-width: 400px;
        margin: 0 auto;
    }

    .customer-create-group {
        margin-bottom: 14px;
        width: 100%;
    }

        .customer-create-group label {
            display: block;
            width: 100%;
            text-align: center;
            font-weight: 600;
            color: #475569;
            margin-bottom: 7px;
        }

        .customer-create-group .form-control {
            display: block;
            width: 100%;
            height: 40px;
            margin: 0 auto;
            text-align: center;
            border: 1px solid #dbe1ea;
            border-radius: 8px;
            padding: 8px 12px;
            box-shadow: none;
            box-sizing: border-box;
        }

            .customer-create-group .form-control:focus {
                border-color: #2563eb;
                outline: none;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
            }

    .customer-create-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 24px;
        padding-top: 18px;
        border-top: 1px solid #edf0f4;
    }

    .btn-save-customer {
        background: #2563eb;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-save-customer:hover {
            background: #1d4ed8;
            color: white;
        }

    .btn-back-customer {
        display: inline-block;
        background: #e9eef5;
        color: #475569;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none !important;
        font-weight: 600;
    }

        .btn-back-customer:hover {
            background: #dce4ee;
            color: #263248;
        }

    .text-danger {
        display: block;
        margin-top: 5px;
        text-align: center;
    }

    @@media (max-width: 768px) {
        .customer-create-page {
            min-height: auto;
            padding: 15px 0;
        }

        .customer-create-card {
            padding: 22px 15px;
        }

        .customer-create-form {
            max-width: 100%;
        }
    }
</style>

<div class="customer-create-page">
    <div class="customer-create-card">

        <div class="customer-create-title">
            <h2>Thêm khách hàng</h2>
            <p>Nhập thông tin khách hàng mới vào hệ thống MyStore</p>
        </div>

        <div class="customer-create-form">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="customer-create-group">
                    @Html.LabelFor(model => model.CustomerName, "Họ và tên")
                    @Html.EditorFor(model => model.CustomerName, new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control",
                            placeholder = "Nhập họ và tên khách hàng"
                        }
                    })
                    @Html.ValidationMessageFor(model => model.CustomerName, "", new { @class = "text-danger" })
                </div>

                <div class="customer-create-group">
                    @Html.LabelFor(model => model.CustomerPhone, "Số điện thoại")
                    @Html.EditorFor(model => model.CustomerPhone, new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control",
                            placeholder = "Nhập số điện thoại"
                        }
                    })
                    @Html.ValidationMessageFor(model => model.CustomerPhone, "", new { @class = "text-danger" })
                </div>

                <div class="customer-create-group">
                    @Html.LabelFor(model => model.CustomerEmail, "Email")
                    @Html.EditorFor(model => model.CustomerEmail, new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control",
                            placeholder = "Nhập địa chỉ email"
                        }
                    })
                    @Html.ValidationMessageFor(model => model.CustomerEmail, "", new { @class = "text-danger" })
                </div>

                <div class="customer-create-group">
                    @Html.LabelFor(model => model.CustomerAddress, "Địa chỉ")
                    @Html.EditorFor(model => model.CustomerAddress, new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control",
                            placeholder = "Nhập địa chỉ khách hàng"
                        }
                    })
                    @Html.ValidationMessageFor(model => model.CustomerAddress, "", new { @class = "text-danger" })
                </div>

                <div class="customer-create-group">
                    @Html.LabelFor(model => model.Username, "Tài khoản liên kết")
                    @Html.DropDownList(
                        "Username",
                        null,
                        "-- Chọn tài khoản --",
                        new { @class = "form-control" }
                    )
                    @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
                </div>

                <div class="customer-create-actions">
                    <button type="submit" class="btn-save-customer">
                        <i class="glyphicon glyphicon-floppy-disk"></i>
                        Lưu khách hàng
                    </button>

                    @Html.ActionLink(
                        "Quay lại",
                        "Index",
                        "Customers",
                        new { area = "Admin" },
                        new { @class = "btn-back-customer" }
                    )
                </div>
            }

        </div>
    </div>
</div>
