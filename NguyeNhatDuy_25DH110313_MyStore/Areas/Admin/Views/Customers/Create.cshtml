
@model NguyeNhatDuy_25DH110313_MyStore.Models.Customer

@{
    ViewBag.Title = "Thêm khách hàng";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .customer-create-page {
        min-height: 100vh;
        padding: 35px 20px;
        background: #f3f6fc;
    }

    .customer-create-container {
        max-width: 850px;
        margin: 0 auto;
    }

    .customer-create-breadcrumb {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 20px;
        color: #94a3b8;
        font-size: 12px;
    }

        .customer-create-breadcrumb a {
            color: #64748b;
            text-decoration: none;
        }

            .customer-create-breadcrumb a:hover {
                color: #2563eb;
            }

    .customer-create-heading {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .customer-create-heading-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 15px;
        background: linear-gradient(135deg, #1e40af, #3b82f6);
        color: #fff;
        font-size: 22px;
        box-shadow: 0 6px 15px rgba(37, 99, 235, 0.2);
    }

    .customer-create-heading h2 {
        margin: 0 0 6px;
        color: #172554;
        font-size: 24px;
        font-weight: 800;
    }

    .customer-create-heading p {
        margin: 0;
        color: #8490a5;
        font-size: 13px;
    }

    .customer-create-card {
        overflow: hidden;
        border: 1px solid #e8eef8;
        border-radius: 15px;
        background: #fff;
        box-shadow: 0 5px 22px rgba(30, 64, 175, 0.05);
    }

    .customer-create-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 25px;
        border-bottom: 1px solid #edf1f7;
        background: #fbfcff;
    }

    .customer-create-card-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 17px;
    }

    .customer-create-card-header h4 {
        margin: 0 0 4px;
        color: #26344d;
        font-size: 15px;
        font-weight: 800;
    }

    .customer-create-card-header p {
        margin: 0;
        color: #94a3b8;
        font-size: 11px;
    }

    .customer-create-body {
        padding: 28px;
    }

    .customer-create-form {
        max-width: 620px;
        margin: 0 auto;
    }

    .customer-create-group {
        margin-bottom: 20px;
    }

        .customer-create-group label {
            display: block;
            margin-bottom: 8px;
            color: #475569;
            font-size: 12px;
            font-weight: 700;
        }

            .customer-create-group label i {
                width: 19px;
                color: #3b82f6;
            }

        .customer-create-group .form-control {
            width: 100%;
            height: 43px;
            padding: 9px 13px;
            border: 1px solid #dce4f0;
            border-radius: 8px;
            background: #fff;
            color: #334155;
            font-size: 13px;
            box-shadow: none;
            transition: all 0.2s ease;
        }

            .customer-create-group .form-control:focus {
                border-color: #60a5fa;
                outline: none;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            }

            .customer-create-group .form-control::placeholder {
                color: #aab4c3;
            }

    .customer-create-hint {
        margin-top: 6px;
        color: #94a3b8;
        font-size: 11px;
    }

    .customer-create-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf1f7;
    }

    .btn-save-customer,
    .btn-back-customer {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        padding: 0 17px;
        border: none;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none !important;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-save-customer {
        background: #2563eb;
        color: #fff;
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.15);
    }

        .btn-save-customer:hover {
            background: #1d4ed8;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(37, 99, 235, 0.22);
        }

    .btn-back-customer {
        background: #f1f5f9;
        color: #64748b;
    }

        .btn-back-customer:hover {
            background: #e2e8f0;
            color: #334155;
            transform: translateY(-2px);
        }

    .customer-create-validation {
        margin-bottom: 18px;
        padding: 12px 15px;
        border: 1px solid #fecaca;
        border-radius: 8px;
        background: #fef2f2;
        color: #dc2626;
        font-size: 12px;
    }

        .customer-create-validation ul {
            margin: 5px 0 0;
            padding-left: 20px;
        }

    .customer-create-group .field-validation-error {
        display: block;
        margin-top: 6px;
        color: #dc2626;
        font-size: 11px;
    }

    .customer-create-group .input-validation-error {
        border-color: #f87171;
        background: #fffafa;
    }

    @@media (max-width: 768px) {
        .customer-create-page {
            padding: 20px 12px;
        }

        .customer-create-heading h2 {
            font-size: 20px;
        }

        .customer-create-body {
            padding: 20px 15px;
        }

        .customer-create-card-header {
            padding: 17px 15px;
        }

        .customer-create-actions {
            justify-content: stretch;
        }

        .btn-save-customer,
        .btn-back-customer {
            flex: 1;
        }
    }
</style>

<div class="customer-create-page">

    <div class="customer-create-container">

        <!-- ĐƯỜNG DẪN -->
        <div class="customer-create-breadcrumb">
            <a href="@Url.Action("Index", "Home", new { area = "Admin" })">
                <i class="fa fa-home"></i> Tổng quan
            </a>

            <i class="fa fa-angle-right"></i>

            <a href="@Url.Action("Index", "Customers", new { area = "Admin" })">
                Khách hàng
            </a>

            <i class="fa fa-angle-right"></i>

            <span>Thêm khách hàng</span>
        </div>

        <!-- TIÊU ĐỀ -->
        <div class="customer-create-heading">

            <div class="customer-create-heading-icon">
                <i class="fa fa-user-plus"></i>
            </div>

            <div>
                <h2>Thêm khách hàng</h2>
                <p>Thêm thông tin khách hàng mới vào hệ thống BookOra</p>
            </div>

        </div>

        <!-- FORM -->
        <div class="customer-create-card">

            <div class="customer-create-card-header">

                <div class="customer-create-card-icon">
                    <i class="fa fa-address-card"></i>
                </div>

                <div>
                    <h4>Thông tin khách hàng</h4>
                    <p>Vui lòng điền đầy đủ thông tin bên dưới</p>
                </div>

            </div>

            <div class="customer-create-body">

                <div class="customer-create-form">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(
                                 true,
                                 "",
                                 new { @class = "customer-create-validation" }
                             )

                        <div class="customer-create-group">

                            @Html.LabelFor(model => model.CustomerName, "Họ và tên")

                            @Html.EditorFor(model => model.CustomerName, new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control",
                                    placeholder = "Nhập họ và tên khách hàng"
                                }
                            })

                            @Html.ValidationMessageFor(
                                     model => model.CustomerName,
                                     "",
                                     new { @class = "text-danger" }
                                 )

                        </div>

                        <div class="customer-create-group">

                            @Html.LabelFor(model => model.CustomerPhone, "Số điện thoại")

                            @Html.EditorFor(model => model.CustomerPhone, new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control",
                                    placeholder = "Nhập số điện thoại"
                                }
                            })

                            @Html.ValidationMessageFor(
                                     model => model.CustomerPhone,
                                     "",
                                     new { @class = "text-danger" }
                                 )

                        </div>

                        <div class="customer-create-group">

                            @Html.LabelFor(model => model.CustomerEmail, "Email")

                            @Html.EditorFor(model => model.CustomerEmail, new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control",
                                    placeholder = "Nhập địa chỉ email"
                                }
                            })

                            @Html.ValidationMessageFor(
                                     model => model.CustomerEmail,
                                     "",
                                     new { @class = "text-danger" }
                                 )

                        </div>

                        <div class="customer-create-group">

                            @Html.LabelFor(model => model.CustomerAddress, "Địa chỉ")

                            @Html.EditorFor(model => model.CustomerAddress, new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control",
                                    placeholder = "Nhập địa chỉ khách hàng"
                                }
                            })

                            @Html.ValidationMessageFor(
                                     model => model.CustomerAddress,
                                     "",
                                     new { @class = "text-danger" }
                                 )

                        </div>

                        <div class="customer-create-group">

                            @Html.LabelFor(model => model.Username, "Tài khoản liên kết")

                            @Html.DropDownList(
                                     "Username",
                                     null,
                                     "-- Chọn tài khoản --",
                                     new { @class = "form-control" }
                                 )

                            <div class="customer-create-hint">
                                <i class="fa fa-info-circle"></i>
                                Chọn tài khoản để liên kết với hồ sơ khách hàng.
                            </div>

                            @Html.ValidationMessageFor(
                                     model => model.Username,
                                     "",
                                     new { @class = "text-danger" }
                                 )

                        </div>

                        <!-- NÚT CHỨC NĂNG -->
                        <div class="customer-create-actions">

                            <a href="@Url.Action("Index", "Customers", new { area = "Admin" })"
                               class="btn-back-customer">
                                <i class="fa fa-arrow-left"></i>
                                Quay lại
                            </a>

                            <button type="submit" class="btn-save-customer">
                                <i class="fa fa-floppy-o"></i>
                                Lưu khách hàng
                            </button>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
