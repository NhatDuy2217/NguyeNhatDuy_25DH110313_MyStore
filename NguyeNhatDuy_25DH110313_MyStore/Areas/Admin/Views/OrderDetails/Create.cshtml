
@model NguyeNhatDuy_25DH110313_MyStore.Models.OrderDetail

@{
    ViewBag.Title = "Thêm sản phẩm vào đơn hàng";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .detail-create-page {
        min-height: 100vh;
        padding: 35px 20px;
        background: #f5f7fb;
    }

    .detail-create-header {
        text-align: center;
        margin-bottom: 25px;
    }

        .detail-create-header h2 {
            color: #243247;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .detail-create-header p {
            color: #7b8798;
            font-size: 14px;
        }

    .detail-create-container {
        max-width: 750px;
        margin: 0 auto;
    }

    .detail-create-card {
        background: #fff;
        padding: 30px 35px;
        border-radius: 14px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
    }

        .detail-create-card h3 {
            font-size: 20px;
            font-weight: 700;
            color: #26364a;
            margin: 0 0 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid #edf0f5;
        }

    .detail-form-group {
        margin-bottom: 20px;
    }

        .detail-form-group label {
            display: block;
            font-weight: 600;
            color: #344054;
            margin-bottom: 8px;
        }

    .detail-input {
        width: 100%;
        height: 44px;
        padding: 10px 13px;
        border: 1px solid #dce2ea;
        border-radius: 7px;
        font-size: 14px;
        color: #344054;
        background: #fff;
        box-sizing: border-box;
        outline: none;
    }

        .detail-input:focus {
            border-color: #367bf5;
            box-shadow: 0 0 0 3px rgba(54, 123, 245, 0.1);
        }

    .detail-validation {
        display: block;
        color: #dc3545;
        font-size: 13px;
        margin-top: 5px;
    }

    .detail-create-note {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        padding: 13px 15px;
        border-radius: 7px;
        font-size: 13px;
        line-height: 1.6;
        margin-bottom: 22px;
    }

    .detail-price-note {
        display: block;
        color: #7b8798;
        font-size: 12px;
        margin-top: 7px;
    }

    .detail-create-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #edf0f5;
    }

    .btn-detail-create {
        background: #2563eb;
        color: white;
        border: none;
        padding: 11px 25px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-detail-create:hover {
            background: #1d4ed8;
        }

    .btn-detail-back {
        background: #eef2f7;
        color: #475467;
        padding: 11px 25px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-detail-back:hover {
            background: #e0e7ef;
            color: #344054;
            text-decoration: none;
        }

    @@media (max-width: 576px) {
        .detail-create-card {
            padding: 22px 18px;
        }

        .detail-create-actions {
            flex-direction: column;
        }

            .detail-create-actions a,
            .detail-create-actions button {
                width: 100%;
                text-align: center;
                box-sizing: border-box;
            }
    }
</style>

<div class="detail-create-page">

    <div class="detail-create-header">
        <h2>Thêm sản phẩm vào đơn hàng</h2>
        <p>Chọn sản phẩm và nhập số lượng cần thêm vào đơn hàng</p>
    </div>

    <div class="detail-create-container">

        <div class="detail-create-card">

            <h3>Thông tin chi tiết đơn hàng</h3>

            <div class="detail-create-note">
                <strong>Lưu ý:</strong>
                Đơn giá sẽ tự động lấy từ giá bán trong mục Quản lý sách.
                Bạn vẫn có thể tùy chỉnh đơn giá trước khi thêm vào đơn hàng.
                Thành tiền được tính bằng số lượng nhân với đơn giá.
            </div>

            @using (Html.BeginForm("Create", "OrderDetails", FormMethod.Post, new { area = "Admin" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "detail-validation" })

                <div class="detail-form-group">

                    @Html.LabelFor(model => model.OrderID, "Mã đơn hàng")

                    @Html.DropDownList(
                        "OrderID",
                        null,
                        "-- Chọn đơn hàng --",
                        new { @class = "detail-input" }
                    )

                    @Html.ValidationMessageFor(
                        model => model.OrderID,
                        "",
                        new { @class = "detail-validation" }
                    )

                </div>

                <div class="detail-form-group">

                    @Html.LabelFor(model => model.ProductID, "Sản phẩm")

                    @Html.DropDownList(
                        "ProductID",
                        null,
                        "-- Chọn sản phẩm --",
                        new { @class = "detail-input", id = "ProductID" }
                    )

                    @Html.ValidationMessageFor(
                        model => model.ProductID,
                        "",
                        new { @class = "detail-validation" }
                    )

                </div>

                <div class="detail-form-group">

                    @Html.LabelFor(model => model.Quantity, "Số lượng")

                    @Html.TextBoxFor(
                        model => model.Quantity,
                        new
                        {
                            @class = "detail-input",
                            type = "number",
                            min = "1",
                            placeholder = "Nhập số lượng sản phẩm"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.Quantity,
                        "",
                        new { @class = "detail-validation" }
                    )

                </div>

                <div class="detail-form-group">

                    @Html.LabelFor(model => model.UnitPrice, "Đơn giá (VNĐ)")

                    @Html.TextBoxFor(
                        model => model.UnitPrice,
                        new
                        {
                            @class = "detail-input",
                            type = "number",
                            id = "UnitPrice",
                            step = "0.01",
                            min = "0",
                            placeholder = "Chọn sản phẩm hoặc nhập đơn giá"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.UnitPrice,
                        "",
                        new { @class = "detail-validation" }
                    )

                    <small class="detail-price-note">
                        Giá được tự động lấy từ Quản lý sách.
                        Bạn có thể thay đổi đơn giá nếu cần.
                    </small>

                </div>

                <div class="detail-create-actions">

                    <button type="submit" class="btn-detail-create">
                        Thêm vào đơn hàng
                    </button>

                    @Html.ActionLink(
                        "Quay lại",
                        "Index",
                        null,
                        new { @class = "btn-detail-back" }
                    )

                </div>
            }

        </div>

    </div>

</div>

@section scripts {
    <script>
        (function () {
            var productElement = document.getElementById("ProductID");
            var priceElement = document.getElementById("UnitPrice");

            if (!(productElement instanceof HTMLSelectElement)) {
                return;
            }

            if (!(priceElement instanceof HTMLInputElement)) {
                return;
            }

            var productSelect = productElement;
            var priceInput = priceElement;

            productSelect.addEventListener("change", function () {
                var productID = productSelect.value;

                if (productID === "") {
                    priceInput.value = "";
                    return;
                }

                var url = '@Url.Action("GetProductPrice", "OrderDetails", new { area = "Admin" })';

                fetch(url + "?id=" + encodeURIComponent(productID))
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error("Không thể lấy giá sản phẩm.");
                        }

                        return response.json();
                    })
                    .then(function (data) {
                        if (data.success) {
                            priceInput.value = data.price;
                        } else {
                            priceInput.value = "";
                            alert("Không tìm thấy giá sản phẩm.");
                        }
                    })
                    .catch(function (error) {
                        priceInput.value = "";
                        console.error(error);
                        alert("Có lỗi khi lấy giá sản phẩm.");
                    });
            });
        })();
    </script>
}

