
@model IEnumerable<NguyeNhatDuy_25DH110313_MyStore.Models.OrderDetail>

@{
    ViewBag.Title = "Quản lý chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";

    var details = Model ?? Enumerable.Empty<NguyeNhatDuy_25DH110313_MyStore.Models.OrderDetail>();

    int totalDetails = details.Count();
    int totalQuantity = details.Sum(x => x.Quantity);
    decimal totalAmount = details.Sum(x => x.Quantity * x.UnitPrice);
}

<style>
    .order-details-list-page {
        min-height: 100vh;
        padding: 32px 24px;
        background: #f4f7fc;
    }

    .order-details-list-container {
        max-width: 1450px;
        margin: 0 auto;
    }

    .order-details-list-header {
        margin-bottom: 25px;
    }

        .order-details-list-header h2 {
            color: #243247;
            font-size: 27px;
            font-weight: 700;
            margin: 0 0 8px;
        }

        .order-details-list-header p {
            color: #8490a2;
            font-size: 14px;
            margin: 0;
        }

    .order-details-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .order-summary-card {
        display: flex;
        align-items: center;
        gap: 17px;
        background: #fff;
        padding: 22px;
        border: 1px solid #edf0f5;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(31, 45, 61, 0.04);
    }

    .summary-icon {
        width: 53px;
        height: 53px;
        min-width: 53px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 21px;
    }

        .summary-icon.blue {
            color: #2563eb;
            background: #eff6ff;
        }

        .summary-icon.purple {
            color: #7c3aed;
            background: #f5f3ff;
        }

        .summary-icon.green {
            color: #16a34a;
            background: #f0fdf4;
        }

    .summary-info span {
        display: block;
        color: #8490a2;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .summary-info h3 {
        color: #26364a;
        font-size: 23px;
        font-weight: 700;
        margin: 0;
    }

    .order-details-table-card {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 14px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(31, 45, 61, 0.04);
    }

    .order-details-table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 22px;
    }

        .order-details-table-header h3 {
            color: #26364a;
            font-size: 19px;
            font-weight: 700;
            margin: 0;
        }

    .btn-order-create {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 0 17px;
        border-radius: 11px;
        background: #2563eb;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .btn-order-create:hover {
            background: #1d4ed8;
            color: #fff;
            text-decoration: none;
            transform: translateY(-1px);
        }

    .order-details-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .order-details-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 950px;
    }

        .order-details-table thead {
            background: #f6f8fc;
        }

        .order-details-table th {
            padding: 15px 13px;
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
            text-align: left;
            white-space: nowrap;
            border-bottom: 1px solid #e9edf4;
        }

        .order-details-table td {
            padding: 15px 13px;
            border-bottom: 1px solid #edf0f5;
            color: #536174;
            font-size: 13px;
            vertical-align: middle;
        }

        .order-details-table tbody tr {
            transition: background 0.2s ease;
        }

            .order-details-table tbody tr:hover {
                background: #f9fbff;
            }

    .detail-id {
        color: #2563eb !important;
        font-weight: 700;
    }

    .detail-order-id {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 7px;
        background: #f1f5f9;
        color: #475569;
        font-size: 12px;
        font-weight: 600;
    }

    .detail-product {
        color: #26364a !important;
        font-weight: 600;
    }

    .detail-price {
        color: #16a34a !important;
        font-weight: 700;
        white-space: nowrap;
    }

    .detail-unit-price {
        white-space: nowrap;
    }

    .detail-quantity {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        padding: 6px 11px;
        border-radius: 8px;
        background: #eff6ff;
        color: #2563eb;
        font-weight: 700;
    }

    .detail-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

        .detail-actions a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            min-height: 36px;
            padding: 0 11px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }

    .btn-detail-view {
        background: #eff6ff;
        color: #2563eb;
    }

    .btn-detail-edit {
        background: #fffbeb;
        color: #d97706;
    }

    .btn-detail-delete {
        background: #fef2f2;
        color: #dc2626;
    }

    .detail-actions a:hover {
        filter: brightness(0.96);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .order-details-empty {
        text-align: center !important;
        padding: 45px 20px !important;
        color: #98a2b3 !important;
        font-size: 14px !important;
    }

        .order-details-empty i {
            display: block;
            font-size: 30px;
            margin-bottom: 12px;
            color: #cbd5e1;
        }

    @@media (max-width: 900px) {
        .order-details-summary {
            grid-template-columns: 1fr;
            gap: 14px;
        }
    }

    @@media (max-width: 768px) {
        .order-details-list-page {
            padding: 22px 14px;
        }

        .order-details-table-card {
            padding: 18px;
        }

        .order-details-table-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .btn-order-create {
            width: 100%;
        }
    }
</style>

<div class="order-details-list-page">
    <div class="order-details-list-container">

        <div class="order-details-list-header">
            <h2>Quản lý chi tiết đơn hàng</h2>
            <p>Quản lý các sản phẩm được đặt trong từng đơn hàng</p>
        </div>

        <div class="order-details-summary">

            <div class="order-summary-card">
                <div class="summary-icon blue">
                    <i class="fas fa-list-alt"></i>
                </div>
                <div class="summary-info">
                    <span>Tổng số dòng chi tiết</span>
                    <h3>@totalDetails</h3>
                </div>
            </div>

            <div class="order-summary-card">
                <div class="summary-icon purple">
                    <i class="fas fa-boxes-stacked"></i>
                </div>
                <div class="summary-info">
                    <span>Tổng số sản phẩm</span>
                    <h3>@totalQuantity</h3>
                </div>
            </div>

            <div class="order-summary-card">
                <div class="summary-icon green">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
                <div class="summary-info">
                    <span>Tổng giá trị chi tiết</span>
                    <h3>@String.Format("{0:N0} ₫", totalAmount)</h3>
                </div>
            </div>

        </div>

        <div class="order-details-table-card">

            <div class="order-details-table-header">
                <h3>Danh sách chi tiết đơn hàng</h3>

                <a href="@Url.Action("Create", "OrderDetails", new { area = "Admin" })"
                   class="btn-order-create">
                    <i class="fas fa-plus"></i>
                    Thêm sản phẩm vào đơn hàng
                </a>
            </div>

            <div class="order-details-table-wrapper">
                <table class="order-details-table">

                    <thead>
                        <tr>
                            <th>Mã chi tiết</th>
                            <th>Mã đơn hàng</th>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (details.Any())
                        {
                            foreach (var item in details)
                            {
                                <tr>
                                    <td class="detail-id">
                                        #@item.ID
                                    </td>

                                    <td>
                                        <span class="detail-order-id">
                                            #@item.OrderID
                                        </span>
                                    </td>

                                    <td class="detail-product">
                                        @(item.Product != null
                                            ? item.Product.ProductName
                                            : "Không xác định")
                                    </td>

                                    <td>
                                        <span class="detail-quantity">
                                            @item.Quantity
                                        </span>
                                    </td>

                                    <td class="detail-unit-price">
                                        @String.Format("{0:N0} ₫", item.UnitPrice)
                                    </td>

                                    <td class="detail-price">
                                        @String.Format("{0:N0} ₫", item.Quantity * item.UnitPrice)
                                    </td>

                                    <td>
                                        <div class="detail-actions">

                                            @Html.ActionLink(
                                                     "Chi tiết",
                                                     "Details",
                                                     new { id = item.ID },
                                                     new { @class = "btn-detail-view" }
                                                 )

                                            @Html.ActionLink(
                                                     "Sửa",
                                                     "Edit",
                                                     new { id = item.ID },
                                                     new { @class = "btn-detail-edit" }
                                                 )

                                            @Html.ActionLink(
                                                     "Xóa",
                                                     "Delete",
                                                     new { id = item.ID },
                                                     new { @class = "btn-detail-delete" }
                                                 )

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="order-details-empty">
                                    <i class="fas fa-inbox"></i>
                                    Chưa có sản phẩm nào trong chi tiết đơn hàng.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>

    </div>
</div>
