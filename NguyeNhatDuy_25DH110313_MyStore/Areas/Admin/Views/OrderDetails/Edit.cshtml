
@model NguyeNhatDuy_25DH110313_MyStore.Models.OrderDetail

@{
    ViewBag.Title = "Chỉnh sửa chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .detail-edit-page {
        min-height: 100vh;
        padding: 32px 24px;
        background: #f4f7fc;
    }

    .detail-edit-container {
        max-width: 850px;
        margin: 0 auto;
    }

    .detail-edit-header {
        margin-bottom: 25px;
    }

        .detail-edit-header h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #243247;
            font-size: 27px;
            font-weight: 700;
            margin: 0 0 8px;
        }

            .detail-edit-header h2 i {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 45px;
                height: 45px;
                border-radius: 12px;
                background: #fffbeb;
                color: #d97706;
                font-size: 20px;
            }

        .detail-edit-header p {
            color: #8490a2;
            font-size: 14px;
            margin: 0;
        }

    .detail-edit-card {
        background: #fff;
        padding: 30px;
        border: 1px solid #edf0f5;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(31, 45, 61, 0.04);
    }

        .detail-edit-card h3 {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 19px;
            font-weight: 700;
            color: #26364a;
            margin: 0 0 22px;
            padding-bottom: 17px;
            border-bottom: 1px solid #edf0f5;
        }

            .detail-edit-card h3 i {
                color: #d97706;
            }

    .detail-edit-note {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        padding: 14px 16px;
        border-radius: 10px;
        font-size: 13px;
        line-height: 1.7;
        margin-bottom: 25px;
    }

        .detail-edit-note i {
            font-size: 17px;
            margin-top: 2px;
        }

    .detail-form-group {
        margin-bottom: 21px;
    }

        .detail-form-group label {
            display: block;
            font-weight: 600;
            color: #344054;
            font-size: 13px;
            margin-bottom: 9px;
        }

    .detail-input {
        display: block;
        width: 100%;
        height: 45px;
        padding: 10px 13px;
        border: 1px solid #dce2ea;
        border-radius: 9px;
        font-size: 14px;
        color: #344054;
        background: #fff;
        box-sizing: border-box;
        outline: none;
        transition: all 0.2s ease;
    }

        .detail-input:focus {
            border-color: #367bf5;
            box-shadow: 0 0 0 3px rgba(54, 123, 245, 0.1);
        }

    .detail-validation {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 6px;
    }

    .detail-price-note {
        display: block;
        color: #8490a2;
        font-size: 12px;
        margin-top: 8px;
        line-height: 1.5;
    }

    .detail-edit-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf0f5;
    }

    .btn-detail-save,
    .btn-detail-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 0 18px;
        border: none;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-detail-save {
        background: #eff6ff;
        color: #2563eb;
    }

        .btn-detail-save:hover {
            background: #dbeafe;
            color: #1d4ed8;
            transform: translateY(-1px);
        }

    .btn-detail-back {
        background: #f1f5f9;
        color: #536174;
    }

        .btn-detail-back:hover {
            background: #e2e8f0;
            color: #334155;
            text-decoration: none;
            transform: translateY(-1px);
        }

    @@media (max-width: 576px) {
        .detail-edit-page {
            padding: 22px 14px;
        }

        .detail-edit-card {
            padding: 22px 18px;
        }

        .detail-edit-header h2 {
            font-size: 22px;
        }

        .detail-edit-actions {
            flex-direction: column-reverse;
        }

        .btn-detail-save,
        .btn-detail-back {
            width: 100%;
            box-sizing: border-box;
        }
    }
</style>

<div class="detail-edit-page">
    <div class="detail-edit-container">

        <div class="detail-edit-header">
            <h2>
                <i class="fas fa-pen-to-square"></i>
                Chỉnh sửa chi tiết đơn hàng
            </h2>
            <p>Cập nhật sản phẩm, số lượng và đơn giá trong đơn hàng</p>
        </div>

        <div class="detail-edit-card">

            <h3>
                <i class="fas fa-file-invoice"></i>
                Thông tin chi tiết đơn hàng
            </h3>

            <div class="detail-edit-note">
                <i class="fas fa-circle-info"></i>
                <div>
                    <strong>Lưu ý:</strong>
                    Bạn có thể thay đổi sản phẩm, đơn hàng, số lượng và đơn giá.
                    Khi chọn sản phẩm khác, đơn giá sẽ tự động lấy từ Quản lý sản phẩm.
                    Bạn vẫn có thể tùy chỉnh đơn giá trước khi lưu.
                </div>
            </div>

            @using (Html.BeginForm("Edit", "OrderDetails", new { area = "Admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.ID)

                @Html.ValidationSummary(true, "", new { @class = "detail-validation" })

                <div class="detail-form-group">
                    @Html.LabelFor(model => model.OrderID, "Mã đơn hàng")

                    @Html.DropDownList(
                             "OrderID",
                             null,
                             new { @class = "detail-input" }
                         )

                    @Html.ValidationMessageFor(
                             model => model.OrderID,
                             "",
                             new { @class = "detail-validation" }
                         )
                </div>

                <div class="detail-form-group">
                    @Html.LabelFor(model => model.ProductID, "Sản phẩm")

                    @Html.DropDownList(
                             "ProductID",
                             null,
                             new
                             {
                                 @class = "detail-input",
                                 id = "ProductID"
                             }
                         )

                    @Html.ValidationMessageFor(
                             model => model.ProductID,
                             "",
                             new { @class = "detail-validation" }
                         )
                </div>

                <div class="detail-form-group">
                    @Html.LabelFor(model => model.Quantity, "Số lượng")

                    @Html.TextBoxFor(
                             model => model.Quantity,
                             new
                             {
                                 @class = "detail-input",
                                 type = "number",
                                 min = "1",
                                 placeholder = "Nhập số lượng sản phẩm"
                             }
                         )

                    @Html.ValidationMessageFor(
                             model => model.Quantity,
                             "",
                             new { @class = "detail-validation" }
                         )
                </div>

                <div class="detail-form-group">
                    @Html.LabelFor(model => model.UnitPrice, "Đơn giá (VNĐ)")

                    @Html.TextBoxFor(
                             model => model.UnitPrice,
                             new
                             {
                                 @class = "detail-input",
                                 type = "number",
                                 id = "UnitPrice",
                                 step = "0.01",
                                 min = "0",
                                 placeholder = "Nhập đơn giá"
                             }
                         )

                    @Html.ValidationMessageFor(
                             model => model.UnitPrice,
                             "",
                             new { @class = "detail-validation" }
                         )

                    <small class="detail-price-note">
                        Đơn giá hiện tại được giữ nguyên khi mở trang.
                        Nếu chọn sản phẩm khác, giá sẽ tự động cập nhật.
                    </small>
                </div>

                <div class="detail-edit-actions">

                    <a href="@Url.Action("Index", "OrderDetails", new { area = "Admin" })"
                       class="btn-detail-back">
                        <i class="fas fa-arrow-left"></i>
                        Quay lại
                    </a>

                    <button type="submit" class="btn-detail-save">
                        <i class="fas fa-save"></i>
                        Lưu thay đổi
                    </button>

                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var productElement = document.getElementById("ProductID");
            var priceElement = document.getElementById("UnitPrice");

            if (!(productElement instanceof HTMLSelectElement)) {
                return;
            }

            if (!(priceElement instanceof HTMLInputElement)) {
                return;
            }

            var productSelect = productElement;
            var priceInput = priceElement;

            productSelect.addEventListener("change", function () {
                var productID = productSelect.value;

                if (productID === "") {
                    priceInput.value = "";
                    return;
                }

                var url = '@Url.Action("GetProductPrice", "OrderDetails", new { area = "Admin" })';

                fetch(url + "?id=" + encodeURIComponent(productID))
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error("Không thể lấy giá sản phẩm.");
                        }

                        return response.json();
                    })
                    .then(function (data) {
                        if (data.success) {
                            priceInput.value = data.price;
                        } else {
                            priceInput.value = "";
                            alert("Không tìm thấy giá sản phẩm.");
                        }
                    })
                    .catch(function (error) {
                        priceInput.value = "";
                        console.error(error);
                        alert("Có lỗi khi lấy giá sản phẩm.");
                    });
            });
        })();
    </script>
}
