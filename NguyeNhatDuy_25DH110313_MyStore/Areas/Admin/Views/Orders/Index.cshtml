
@model IEnumerable<NguyeNhatDuy_25DH110313_MyStore.Models.Order>
@using System.Linq

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";

    var orders = Model != null
        ? Model.ToList()
        : new List<NguyeNhatDuy_25DH110313_MyStore.Models.Order>();

    int totalOrders = orders.Count;
    decimal totalRevenue = orders.Sum(o => o.TotalAmount);
    int paidOrders = orders.Count(o =>
        o.PaymentStatus == "Đã thanh toán");
    int unpaidOrders = orders.Count(o =>
        o.PaymentStatus == "Chưa thanh toán");
}

<style>
    .orders-page {
        min-height: 100vh;
        padding: 32px 25px 55px;
        background: #f4f7fc;
    }

    .orders-container {
        max-width: 1500px;
        margin: 0 auto;
    }

    /* Header */
    .orders-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 27px;
    }

        .orders-header h2 {
            color: #1d2b45;
            font-size: 27px;
            font-weight: 750;
            margin: 0 0 8px;
        }

        .orders-header p {
            color: #8794a8;
            font-size: 13px;
            margin: 0;
        }

    .btn-create-order {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 12px 20px;
        background: linear-gradient(135deg, #3867d6, #527fe5);
        color: #fff;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 5px 13px rgba(56, 103, 214, 0.18);
        transition: all 0.2s ease;
    }

        .btn-create-order:hover {
            color: #fff;
            background: #2854b8;
            text-decoration: none;
            transform: translateY(-2px);
            box-shadow: 0 7px 16px rgba(56, 103, 214, 0.25);
        }

    /* Summary */
    .orders-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .orders-summary-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 0;
        padding: 20px;
        background: #fff;
        border: 1px solid #e9eef6;
        border-radius: 14px;
        box-shadow: 0 5px 18px rgba(30, 50, 80, 0.04);
        transition: all 0.2s ease;
    }

        .orders-summary-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 9px 22px rgba(30, 50, 80, 0.08);
        }

    .summary-icon {
        width: 49px;
        height: 49px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 20px;
    }

        .summary-icon.blue {
            color: #3867d6;
            background: #edf3ff;
        }

        .summary-icon.green {
            color: #15966d;
            background: #e8f8f1;
        }

        .summary-icon.orange {
            color: #d58a18;
            background: #fff5e5;
        }

        .summary-icon.purple {
            color: #8060d8;
            background: #f1edff;
        }

    .summary-content {
        min-width: 0;
    }

        .summary-content span {
            display: block;
            color: #8794a8;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .summary-content strong {
            display: block;
            color: #243247;
            font-size: 22px;
            font-weight: 750;
            word-break: break-word;
        }

            .summary-content strong.money {
                font-size: 19px;
                color: #15966d;
            }

    /* Table */
    .orders-table-container {
        background: #fff;
        border: 1px solid #e9eef6;
        border-radius: 15px;
        box-shadow: 0 6px 22px rgba(30, 50, 80, 0.05);
        overflow: hidden;
    }

    .orders-table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding: 21px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .orders-table-title {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .orders-table-title-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #edf3ff;
        color: #3867d6;
        font-size: 16px;
    }

    .orders-table-title h4 {
        color: #243247;
        font-size: 16px;
        font-weight: 750;
        margin: 0 0 4px;
    }

    .orders-table-title p {
        color: #98a3b3;
        font-size: 11px;
        margin: 0;
    }

    .orders-count {
        padding: 7px 12px;
        color: #3867d6;
        background: #edf3ff;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .orders-table-scroll {
        width: 100%;
        overflow-x: auto;
    }

    .orders-table {
        width: 100%;
        min-width: 1120px;
        border-collapse: collapse;
    }

        .orders-table thead {
            background: #f8faff;
        }

        .orders-table th {
            padding: 16px 13px;
            color: #718096;
            font-size: 11px;
            font-weight: 750;
            text-align: center;
            white-space: nowrap;
            border-bottom: 1px solid #e9eef6;
        }

        .orders-table td {
            padding: 16px 13px;
            color: #536174;
            font-size: 12px;
            text-align: center;
            vertical-align: middle;
            border-bottom: 1px solid #f0f2f6;
        }

        .orders-table tbody tr {
            transition: background 0.2s ease;
        }

            .orders-table tbody tr:hover {
                background: #f8faff;
            }

            .orders-table tbody tr:last-child td {
                border-bottom: none;
            }

    .order-id {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        color: #3867d6;
        background: #edf3ff;
        border-radius: 7px;
        font-weight: 750;
        white-space: nowrap;
    }

    .order-customer {
        color: #26364e;
        font-weight: 700;
    }

    .order-date {
        color: #718096;
        white-space: nowrap;
    }

    .order-amount {
        color: #15966d;
        font-weight: 750;
        white-space: nowrap;
    }

    .order-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 750;
        white-space: nowrap;
    }

        .order-status.paid {
            color: #13845f;
            background: #e7f8f0;
        }

        .order-status.unpaid {
            color: #dc3545;
            background: #fff0f0;
            border: 1px solid #ffd9dd;
        }

        .order-status.other {
            color: #64748b;
            background: #eef2f7;
        }

    .order-address {
        max-width: 210px;
        min-width: 150px;
        text-align: left !important;
        line-height: 1.6;
        word-break: break-word;
    }

    /* Action buttons */
    .order-actions {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 8px;
        white-space: nowrap;
    }

        .order-actions a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 32px;
            padding: 0 10px;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }

    .btn-order-details {
        color: #2563eb;
        background: #eff6ff;
    }

    .btn-order-edit {
        color: #d97706;
        background: #fffbeb;
    }

    .btn-order-delete {
        color: #dc2626;
        background: #fef2f2;
    }

    .order-actions a:hover {
        transform: translateY(-2px);
        filter: brightness(0.97);
        text-decoration: none;
    }

    /* Empty */
    .orders-empty {
        padding: 65px 20px !important;
        text-align: center !important;
    }

    .orders-empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #8ba5d9;
        background: #edf3ff;
        border-radius: 18px;
        font-size: 27px;
    }

    .orders-empty strong {
        display: block;
        color: #526176;
        font-size: 15px;
        margin-bottom: 6px;
    }

    .orders-empty span {
        color: #98a3b3;
        font-size: 12px;
    }

    /* Responsive */
    @@media (max-width: 1100px) {
        .orders-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .orders-page {
            padding: 23px 13px 40px;
        }

        .orders-header {
            align-items: flex-start;
        }

            .orders-header h2 {
                font-size: 23px;
            }

        .btn-create-order {
            width: 100%;
        }

        .orders-summary {
            gap: 10px;
        }

        .orders-summary-card {
            padding: 14px 12px;
            gap: 10px;
        }

        .summary-icon {
            width: 40px;
            height: 40px;
            font-size: 16px;
        }

        .summary-content span {
            font-size: 10px;
        }

        .summary-content strong {
            font-size: 18px;
        }

            .summary-content strong.money {
                font-size: 15px;
            }

        .orders-table-header {
            padding: 17px;
        }
    }
</style>

<div class="orders-page">
    <div class="orders-container">

        <!-- Header -->
        <div class="orders-header">
            <div>
                <h2>Quản lý đơn hàng</h2>
                <p>Theo dõi và quản lý toàn bộ đơn hàng trong hệ thống BookOra.</p>
            </div>

            @Html.ActionLink(
                     "＋ Thêm đơn hàng",
                     "Create",
                     null,
                     new { @class = "btn-create-order" }
                 )
        </div>

        <!-- Summary -->
        <div class="orders-summary">

            <div class="orders-summary-card">
                <div class="summary-icon blue">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <div class="summary-content">
                    <span>Tổng số đơn hàng</span>
                    <strong>@totalOrders</strong>
                </div>
            </div>

            <div class="orders-summary-card">
                <div class="summary-icon green">
                    <i class="fas fa-wallet"></i>
                </div>
                <div class="summary-content">
                    <span>Tổng giá trị đơn hàng</span>
                    <strong class="money">
                        @String.Format("{0:N0} ₫", totalRevenue)
                    </strong>
                </div>
            </div>

            <div class="orders-summary-card">
                <div class="summary-icon purple">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="summary-content">
                    <span>Đã thanh toán</span>
                    <strong>@paidOrders</strong>
                </div>
            </div>

            <div class="orders-summary-card">
                <div class="summary-icon orange">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="summary-content">
                    <span>Chưa thanh toán</span>
                    <strong>@unpaidOrders</strong>
                </div>
            </div>

        </div>

        <!-- Orders table -->
        <div class="orders-table-container">

            <div class="orders-table-header">
                <div class="orders-table-title">
                    <div class="orders-table-title-icon">
                        <i class="fas fa-list-alt"></i>
                    </div>

                    <div>
                        <h4>Danh sách đơn hàng</h4>
                        <p>Thông tin các đơn hàng đã được tạo trong hệ thống</p>
                    </div>
                </div>

                <span class="orders-count">
                    @totalOrders đơn hàng
                </span>
            </div>

            <div class="orders-table-scroll">
                <table class="orders-table">

                    <thead>
                        <tr>
                            <th>MÃ ĐƠN</th>
                            <th>KHÁCH HÀNG</th>
                            <th>NGÀY ĐẶT</th>
                            <th>TỔNG TIỀN</th>
                            <th>TRẠNG THÁI THANH TOÁN</th>
                            <th>ĐỊA CHỈ GIAO HÀNG</th>
                            <th>CHỨC NĂNG</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (orders.Any())
                        {
                            foreach (var item in orders)
                            {
                                <tr>
                                    <td>
                                        <span class="order-id">
                                            #@item.OrderID
                                        </span>
                                    </td>

                                    <td>
                                        <span class="order-customer">
                                            @(item.Customer != null
                                                ? item.Customer.CustomerName
                                                : "Không xác định")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="order-date">
                                            @item.OrderDate.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="order-amount">
                                            @String.Format("{0:N0} ₫", item.TotalAmount)
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.PaymentStatus == "Đã thanh toán")
                                        {
                                            <span class="order-status paid">
                                                <i class="fas fa-check-circle"></i>
                                                Đã thanh toán
                                            </span>
                                        }
                                        else if (item.PaymentStatus == "Chưa thanh toán")
                                        {
                                            <span class="order-status unpaid">
                                                <i class="fas fa-clock"></i>
                                                Chưa thanh toán
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="order-status other">
                                                @(string.IsNullOrWhiteSpace(item.PaymentStatus)
                                                    ? "Chưa xác định"
                                                    : item.PaymentStatus)
                                            </span>
                                        }
                                    </td>

                                    <td class="order-address">
                                        @(string.IsNullOrWhiteSpace(item.AddressDelivery)
                                            ? "Chưa cập nhật"
                                            : item.AddressDelivery)
                                    </td>

                                    <td>
                                        <div class="order-actions">

                                            @Html.ActionLink(
                                                     "Chi tiết",
                                                     "Details",
                                                     new { id = item.OrderID },
                                                     new { @class = "btn-order-details" }
                                                 )

                                            @Html.ActionLink(
                                                     "Sửa",
                                                     "Edit",
                                                     new { id = item.OrderID },
                                                     new { @class = "btn-order-edit" }
                                                 )

                                            @Html.ActionLink(
                                                     "Xóa",
                                                     "Delete",
                                                     new { id = item.OrderID },
                                                     new { @class = "btn-order-delete" }
                                                 )

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="orders-empty">
                                    <div class="orders-empty-icon">
                                        <i class="fas fa-box-open"></i>
                                    </div>
                                    <strong>Chưa có đơn hàng nào</strong>
                                    <span>Hiện tại hệ thống chưa có dữ liệu đơn hàng.</span>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>

    </div>
</div>
