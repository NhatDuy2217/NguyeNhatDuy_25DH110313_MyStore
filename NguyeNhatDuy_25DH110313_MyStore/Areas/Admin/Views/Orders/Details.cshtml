
@model NguyeNhatDuy_25DH110313_MyStore.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .order-details-page {
        min-height: 100vh;
        padding: 35px 25px 55px;
        background: #f4f7fc;
    }

    .order-details-container {
        max-width: 850px;
        margin: 0 auto;
    }

    /* Tiêu đề */
    .order-details-header {
        text-align: center;
        margin-bottom: 25px;
    }

        .order-details-header h2 {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: #26364a;
            font-size: 27px;
            font-weight: 750;
            margin: 0 0 9px;
        }

        .order-details-header .header-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background: #eff6ff;
            color: #2563eb;
            font-size: 21px;
        }

        .order-details-header p {
            color: #8491a3;
            font-size: 14px;
            margin: 0;
        }

    /* Thẻ thông tin */
    .order-details-card {
        background: #fff;
        border: 1px solid #e9eef5;
        border-radius: 18px;
        box-shadow: 0 6px 25px rgba(35, 55, 85, 0.055);
        overflow: hidden;
    }

    .order-card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 23px 30px;
        border-bottom: 1px solid #edf1f6;
        background: #fff;
    }

        .order-card-heading .heading-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            border-radius: 12px;
            background: #f0f5ff;
            color: #3975dc;
            font-size: 19px;
        }

        .order-card-heading h3 {
            color: #26364a;
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 4px;
        }

        .order-card-heading p {
            color: #98a2b3;
            font-size: 12px;
            margin: 0;
        }

    .order-details-content {
        padding: 15px 30px 28px;
    }

    /* Mã đơn hàng */
    .order-id-highlight {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 19px;
        margin: 10px 0 18px;
        border: 1px solid #e4edfc;
        border-radius: 12px;
        background: #f7faff;
    }

    .order-id-label {
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
    }

    .order-id-value {
        color: #2563eb;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: .3px;
    }

    /* Các dòng thông tin */
    .order-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        padding: 19px 5px;
        border-bottom: 1px solid #edf1f6;
    }

    .order-detail-label {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #718096;
        font-size: 13px;
        font-weight: 600;
        flex: 0 0 42%;
    }

        .order-detail-label .detail-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            flex-shrink: 0;
            border-radius: 9px;
            background: #f1f5f9;
            color: #6480a8;
            font-size: 14px;
        }

    .order-detail-value {
        color: #344054;
        font-size: 13px;
        font-weight: 650;
        text-align: right;
        overflow-wrap: anywhere;
        line-height: 1.6;
        flex: 1;
    }

    .order-detail-amount {
        color: #16a34a;
        font-size: 17px;
        font-weight: 800;
    }

    /* Trạng thái thanh toán */
    .order-payment-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 13px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
    }

        .order-payment-status.unpaid {
            color: #dc2626;
            background: #fef2f2;
        }

        .order-payment-status.paid {
            color: #16a34a;
            background: #f0fdf4;
        }

        .order-payment-status.other {
            color: #64748b;
            background: #f1f5f9;
        }

    /* Nút chức năng */
    .order-details-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 11px;
        padding-top: 25px;
        margin-top: 15px;
        border-top: 1px solid #edf1f6;
    }

    .btn-order-edit,
    .btn-order-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 155px;
        height: 44px;
        padding: 0 20px;
        border: none;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-order-edit {
        background: #fffbeb;
        color: #d97706;
    }

        .btn-order-edit:hover {
            background: #fef3c7;
            color: #b45309;
            transform: translateY(-2px);
            text-decoration: none;
        }

    .btn-order-back {
        background: #f1f5f9;
        color: #536174;
    }

        .btn-order-back:hover {
            background: #e2e8f0;
            color: #334155;
            transform: translateY(-2px);
            text-decoration: none;
        }

    @@media (max-width: 650px) {
        .order-details-page {
            padding: 25px 13px 40px;
        }

        .order-details-header h2 {
            font-size: 22px;
        }

        .order-card-heading {
            padding: 20px;
        }

        .order-details-content {
            padding: 12px 18px 22px;
        }

        .order-detail-row {
            flex-direction: column;
            gap: 10px;
            padding: 16px 3px;
        }

        .order-detail-label {
            flex: auto;
        }

        .order-detail-value {
            width: 100%;
            text-align: left;
            padding-left: 42px;
            box-sizing: border-box;
        }

        .order-id-highlight {
            padding: 15px;
        }

        .order-details-actions {
            flex-direction: column-reverse;
        }

        .btn-order-edit,
        .btn-order-back {
            width: 100%;
        }
    }
</style>

<div class="order-details-page">
    <div class="order-details-container">

        <div class="order-details-header">
            <h2>
                <span class="header-icon">▤</span>
                Chi tiết đơn hàng
            </h2>
            <p>Xem đầy đủ thông tin đơn hàng trong hệ thống BookOra</p>
        </div>

        <div class="order-details-card">

            <div class="order-card-heading">
                <div class="heading-icon">📋</div>
                <div>
                    <h3>Thông tin đơn hàng</h3>
                    <p>Thông tin chi tiết của đơn hàng được lưu trong hệ thống</p>
                </div>
            </div>

            <div class="order-details-content">

                <div class="order-id-highlight">
                    <span class="order-id-label">Mã đơn hàng</span>
                    <span class="order-id-value">#@Model.OrderID</span>
                </div>

                <div class="order-detail-row">
                    <span class="order-detail-label">
                        <span class="detail-icon">👤</span>
                        Khách hàng
                    </span>
                    <span class="order-detail-value">
                        @(Model.Customer != null
                            ? Model.Customer.CustomerName
                            : "Chưa có thông tin")
                    </span>
                </div>

                <div class="order-detail-row">
                    <span class="order-detail-label">
                        <span class="detail-icon">📅</span>
                        Ngày đặt hàng
                    </span>
                    <span class="order-detail-value">
                        @Model.OrderDate.ToString("dd/MM/yyyy")
                    </span>
                </div>

                <div class="order-detail-row">
                    <span class="order-detail-label">
                        <span class="detail-icon">💰</span>
                        Tổng tiền
                    </span>
                    <span class="order-detail-value order-detail-amount">
                        @String.Format("{0:N0} ₫", Model.TotalAmount)
                    </span>
                </div>

                <div class="order-detail-row">
                    <span class="order-detail-label">
                        <span class="detail-icon">💳</span>
                        Trạng thái thanh toán
                    </span>

                    <span class="order-detail-value">
                        @if (Model.PaymentStatus == "Chưa thanh toán")
                        {
                            <span class="order-payment-status unpaid">
                                ● Chưa thanh toán
                            </span>
                        }
                        else if (Model.PaymentStatus == "Đã thanh toán")
                        {
                            <span class="order-payment-status paid">
                                ● Đã thanh toán
                            </span>
                        }
                        else
                        {
                            <span class="order-payment-status other">
                                @(String.IsNullOrWhiteSpace(Model.PaymentStatus)
                                    ? "Chưa cập nhật"
                                    : Model.PaymentStatus)
                            </span>
                        }
                    </span>
                </div>

                <div class="order-detail-row">
                    <span class="order-detail-label">
                        <span class="detail-icon">📍</span>
                        Địa chỉ giao hàng
                    </span>
                    <span class="order-detail-value">
                        @(String.IsNullOrWhiteSpace(Model.AddressDelivery)
                            ? "Chưa cập nhật"
                            : Model.AddressDelivery)
                    </span>
                </div>

                <div class="order-details-actions">

                    @Html.ActionLink(
                             "← Quay lại danh sách",
                             "Index",
                             null,
                             new { @class = "btn-order-back" }
                         )

                    @Html.ActionLink(
                             "✎ Chỉnh sửa đơn hàng",
                             "Edit",
                             new { id = Model.OrderID },
                             new { @class = "btn-order-edit" }
                         )

                </div>

            </div>
        </div>
    </div>
</div>
