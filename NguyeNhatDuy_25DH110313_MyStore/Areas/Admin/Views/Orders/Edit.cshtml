
@model NguyeNhatDuy_25DH110313_MyStore.Models.Order

@{
    ViewBag.Title = "Chỉnh sửa đơn hàng";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .order-edit-page {
        min-height: 100vh;
        padding: 35px 25px 55px;
        background: #f4f7fc;
    }

    .order-edit-container {
        max-width: 850px;
        margin: 0 auto;
    }

    /* Tiêu đề */
    .order-edit-header {
        margin-bottom: 25px;
    }

        .order-edit-header h2 {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: #26364a;
            font-size: 27px;
            font-weight: 750;
            margin: 0 0 9px;
        }

            .order-edit-header h2 .header-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 46px;
                height: 46px;
                border-radius: 14px;
                background: #eff6ff;
                color: #2563eb;
                font-size: 22px;
            }

        .order-edit-header p {
            text-align: center;
            color: #8491a3;
            font-size: 14px;
            margin: 0;
        }

    /* Thẻ biểu mẫu */
    .order-edit-card {
        background: #fff;
        border: 1px solid #e9eef5;
        border-radius: 18px;
        box-shadow: 0 6px 25px rgba(35, 55, 85, 0.055);
        overflow: hidden;
    }

    .order-card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 23px 30px;
        border-bottom: 1px solid #edf1f6;
        background: #fff;
    }

        .order-card-heading .heading-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            border-radius: 12px;
            background: #f0f5ff;
            color: #3975dc;
            font-size: 19px;
        }

        .order-card-heading h3 {
            color: #26364a;
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 4px;
        }

        .order-card-heading p {
            color: #98a2b3;
            font-size: 12px;
            margin: 0;
        }

    .order-edit-form {
        padding: 30px;
    }

    /* Nhóm nhập liệu */
    .order-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 23px 22px;
    }

    .order-form-group {
        min-width: 0;
    }

        .order-form-group.full-width {
            grid-column: 1 / -1;
        }

        .order-form-group label {
            display: block;
            color: #344054;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 9px;
        }

            .order-form-group label .field-icon {
                display: inline-block;
                width: 20px;
                color: #7290bd;
                text-align: center;
                margin-right: 4px;
            }

    .order-input {
        display: block;
        width: 100%;
        height: 47px;
        padding: 0 14px;
        border: 1px solid #e0e6ef;
        border-radius: 10px;
        outline: none;
        background: #fbfcfe;
        color: #344054;
        font-size: 13px;
        box-sizing: border-box;
        transition: all .2s ease;
    }

        .order-input:hover {
            border-color: #bdcce2;
            background: #fff;
        }

        .order-input:focus {
            border-color: #78a5f5;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, .09);
        }

    select.order-input {
        cursor: pointer;
    }

    .order-validation {
        display: block;
        color: #dc3545;
        font-size: 12px;
        margin-top: 6px;
    }

        .order-validation ul {
            margin: 5px 0 0;
            padding-left: 20px;
        }

    /* Gợi ý */
    .order-form-note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        padding: 13px 15px;
        margin-top: 25px;
        border: 1px solid #e4edfc;
        border-radius: 10px;
        background: #f7faff;
        color: #64748b;
        font-size: 12px;
        line-height: 1.6;
    }

        .order-form-note span {
            color: #4285e9;
            font-size: 15px;
        }

    /* Nút chức năng */
    .order-form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 11px;
        padding-top: 25px;
        margin-top: 27px;
        border-top: 1px solid #edf1f6;
    }

    .btn-order-save,
    .btn-order-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 155px;
        height: 44px;
        padding: 0 20px;
        border: none;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-order-save {
        background: #eff6ff;
        color: #2563eb;
    }

        .btn-order-save:hover {
            background: #dbeafe;
            color: #1d4ed8;
            transform: translateY(-2px);
        }

    .btn-order-back {
        background: #f1f5f9;
        color: #536174;
    }

        .btn-order-back:hover {
            background: #e2e8f0;
            color: #334155;
            text-decoration: none;
            transform: translateY(-2px);
        }

    @@media (max-width: 650px) {
        .order-edit-page {
            padding: 25px 13px 40px;
        }

        .order-edit-header h2 {
            font-size: 22px;
        }

        .order-card-heading {
            padding: 20px;
        }

        .order-edit-form {
            padding: 22px 18px;
        }

        .order-form-grid {
            grid-template-columns: 1fr;
            gap: 19px;
        }

        .order-form-group.full-width {
            grid-column: auto;
        }

        .order-form-actions {
            flex-direction: column-reverse;
        }

        .btn-order-save,
        .btn-order-back {
            width: 100%;
        }
    }
</style>

<div class="order-edit-page">
    <div class="order-edit-container">

        <div class="order-edit-header">
            <h2>
                <span class="header-icon">✎</span>
                Chỉnh sửa đơn hàng
            </h2>
            <p>Cập nhật và quản lý thông tin đơn hàng trong hệ thống BookOra</p>
        </div>

        <div class="order-edit-card">

            <div class="order-card-heading">
                <div class="heading-icon">📋</div>
                <div>
                    <h3>Thông tin đơn hàng</h3>
                    <p>Chỉnh sửa các thông tin cần thiết bên dưới</p>
                </div>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.OrderID)

                <div class="order-edit-form">

                    @Html.ValidationSummary(true, "", new { @class = "order-validation" })

                    <div class="order-form-grid">

                        <div class="order-form-group">
                            @Html.LabelFor(model => model.CustomerID, "Khách hàng")
                            <label for="CustomerID" style="display:none;"></label>

                            <div>
                                @Html.DropDownList(
                                         "CustomerID",
                                         null,
                                         "-- Chọn khách hàng --",
                                         new { @class = "order-input" }
                                     )
                            </div>

                            @Html.ValidationMessageFor(
                                     model => model.CustomerID,
                                     "",
                                     new { @class = "order-validation" }
                                 )
                        </div>

                        <div class="order-form-group">
                            @Html.LabelFor(model => model.OrderDate, "Ngày đặt hàng")

                            @Html.TextBoxFor(
                                     model => model.OrderDate,
                                     "{0:yyyy-MM-dd}",
                                     new
                                     {
                                         @class = "order-input",
                                         type = "date"
                                     }
                                 )

                            @Html.ValidationMessageFor(
                                     model => model.OrderDate,
                                     "",
                                     new { @class = "order-validation" }
                                 )
                        </div>

                        <div class="order-form-group">
                            @Html.LabelFor(model => model.TotalAmount, "Tổng tiền (VNĐ)")

                            @Html.TextBoxFor(
                                     model => model.TotalAmount,
                                     new
                                     {
                                         @class = "order-input",
                                         type = "number",
                                         min = "0",
                                         placeholder = "Nhập tổng tiền đơn hàng"
                                     }
                                 )

                            @Html.ValidationMessageFor(
                                     model => model.TotalAmount,
                                     "",
                                     new { @class = "order-validation" }
                                 )
                        </div>

                        <div class="order-form-group">
                            @Html.LabelFor(model => model.PaymentStatus, "Trạng thái thanh toán")

                            @Html.DropDownListFor(
                                     model => model.PaymentStatus,
                                     new SelectList(
                                         new[]
                                         {
                                        new {
                                            Value = "Chưa thanh toán",
                                            Text = "Chưa thanh toán"
                                        },
                                        new {
                                            Value = "Đã thanh toán",
                                            Text = "Đã thanh toán"
                                        }
                             },
                                         "Value",
                                         "Text",
                                         Model.PaymentStatus
                                     ),
                                     "-- Chọn trạng thái thanh toán --",
                                     new { @class = "order-input" }
                                 )

                            @Html.ValidationMessageFor(
                                     model => model.PaymentStatus,
                                     "",
                                     new { @class = "order-validation" }
                                 )
                        </div>

                        <div class="order-form-group full-width">
                            @Html.LabelFor(model => model.AddressDelivery, "Địa chỉ giao hàng")

                            @Html.TextBoxFor(
                                     model => model.AddressDelivery,
                                     new
                                     {
                                         @class = "order-input",
                                         placeholder = "Nhập địa chỉ giao hàng"
                                     }
                                 )

                            @Html.ValidationMessageFor(
                                     model => model.AddressDelivery,
                                     "",
                                     new { @class = "order-validation" }
                                 )
                        </div>

                    </div>

                    <div class="order-form-note">
                        <span>ⓘ</span>
                        <div>
                            Vui lòng kiểm tra kỹ thông tin khách hàng, tổng tiền và trạng thái thanh toán
                            trước khi lưu thay đổi.
                        </div>
                    </div>

                    <div class="order-form-actions">

                        @Html.ActionLink(
                                 "← Quay lại",
                                 "Index",
                                 null,
                                 new { @class = "btn-order-back" }
                             )

                        <button type="submit" class="btn-order-save">
                            ✓ Lưu thay đổi
                        </button>

                    </div>

                </div>
            }

        </div>
    </div>
</div>
