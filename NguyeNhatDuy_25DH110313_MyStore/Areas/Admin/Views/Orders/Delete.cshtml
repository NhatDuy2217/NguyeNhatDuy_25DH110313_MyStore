
@model NguyeNhatDuy_25DH110313_MyStore.Models.Order

@{
    ViewBag.Title = "Xóa đơn hàng";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";

    int orderDetailCount = ViewBag.OrderDetailCount == null
        ? 0
        : (int)ViewBag.OrderDetailCount;

    string deleteError = ViewBag.DeleteError as string;
}

<style>
    .order-delete-page {
        min-height: 100vh;
        padding: 35px 25px 55px;
        background: #f4f7fc;
    }

    .order-delete-container {
        max-width: 850px;
        margin: 0 auto;
    }

    /* Tiêu đề */
    .order-delete-header {
        text-align: center;
        margin-bottom: 25px;
    }

        .order-delete-header h2 {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: #26364a;
            font-size: 27px;
            font-weight: 750;
            margin: 0 0 9px;
        }

        .order-delete-header .header-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background: #fef2f2;
            color: #dc2626;
            font-size: 21px;
        }

        .order-delete-header p {
            color: #8491a3;
            font-size: 14px;
            margin: 0;
        }

    /* Thẻ chính */
    .order-delete-card {
        background: #fff;
        border: 1px solid #e9eef5;
        border-radius: 18px;
        box-shadow: 0 6px 25px rgba(35, 55, 85, 0.055);
        overflow: hidden;
    }

    .order-card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 23px 30px;
        border-bottom: 1px solid #edf1f6;
        background: #fff;
    }

        .order-card-heading .heading-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            border-radius: 12px;
            background: #fef2f2;
            color: #dc5555;
            font-size: 19px;
        }

        .order-card-heading h3 {
            color: #26364a;
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 4px;
        }

        .order-card-heading p {
            color: #98a2b3;
            font-size: 12px;
            margin: 0;
        }

    .order-delete-content {
        padding: 25px 30px 28px;
    }

    /* Cảnh báo */
    .order-delete-warning,
    .order-delete-error {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px 18px;
        border-radius: 11px;
        margin-bottom: 23px;
        font-size: 13px;
        line-height: 1.7;
    }

    .order-delete-warning {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #c2410c;
    }

    .order-delete-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
    }

    .warning-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        border-radius: 9px;
        background: rgba(234, 88, 12, .1);
        font-size: 16px;
    }

    .order-delete-error .warning-icon {
        background: rgba(220, 38, 38, .1);
    }

    .warning-content strong {
        display: block;
        margin-bottom: 3px;
        font-size: 14px;
    }

    /* Mã đơn hàng */
    .order-id-highlight {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 19px;
        margin-bottom: 18px;
        border: 1px solid #e4edfc;
        border-radius: 12px;
        background: #f7faff;
    }

    .order-id-label {
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
    }

    .order-id-value {
        color: #2563eb;
        font-size: 20px;
        font-weight: 800;
    }

    /* Thông tin đơn hàng */
    .order-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        padding: 18px 5px;
        border-bottom: 1px solid #edf1f6;
    }

    .order-detail-label {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #718096;
        font-size: 13px;
        font-weight: 600;
        flex: 0 0 42%;
    }

    .detail-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        flex-shrink: 0;
        border-radius: 9px;
        background: #f1f5f9;
        color: #6480a8;
        font-size: 14px;
    }

    .order-detail-value {
        color: #344054;
        font-size: 13px;
        font-weight: 650;
        text-align: right;
        overflow-wrap: anywhere;
        line-height: 1.6;
        flex: 1;
    }

    .order-detail-amount {
        color: #16a34a;
        font-size: 17px;
        font-weight: 800;
    }

    /* Trạng thái thanh toán */
    .order-payment-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 13px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
    }

        .order-payment-status.unpaid {
            color: #dc2626;
            background: #fef2f2;
        }

        .order-payment-status.paid {
            color: #16a34a;
            background: #f0fdf4;
        }

        .order-payment-status.other {
            color: #64748b;
            background: #f1f5f9;
        }

    /* Số chi tiết sản phẩm */
    .order-detail-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 27px;
        padding: 0 9px;
        border-radius: 8px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 12px;
        font-weight: 700;
    }

    /* Nút chức năng */
    .order-delete-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 11px;
        padding-top: 25px;
        margin-top: 15px;
        border-top: 1px solid #edf1f6;
    }

    .btn-order-delete,
    .btn-order-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 155px;
        height: 44px;
        padding: 0 20px;
        border: none;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-order-delete {
        background: #fef2f2;
        color: #dc2626;
    }

        .btn-order-delete:hover:not(:disabled) {
            background: #fee2e2;
            color: #b91c1c;
            transform: translateY(-2px);
        }

        .btn-order-delete:disabled {
            background: #f1f5f9;
            color: #94a3b8;
            cursor: not-allowed;
        }

    .btn-order-back {
        background: #f1f5f9;
        color: #536174;
    }

        .btn-order-back:hover {
            background: #e2e8f0;
            color: #334155;
            text-decoration: none;
            transform: translateY(-2px);
        }

    @@media (max-width: 650px) {
        .order-delete-page {
            padding: 25px 13px 40px;
        }

        .order-delete-header h2 {
            font-size: 22px;
        }

        .order-card-heading {
            padding: 20px;
        }

        .order-delete-content {
            padding: 20px 18px 22px;
        }

        .order-detail-row {
            flex-direction: column;
            gap: 10px;
            padding: 16px 3px;
        }

        .order-detail-label {
            flex: auto;
        }

        .order-detail-value {
            width: 100%;
            text-align: left;
            padding-left: 42px;
            box-sizing: border-box;
        }

        .order-id-highlight {
            padding: 15px;
        }

        .order-delete-actions {
            flex-direction: column-reverse;
        }

        .btn-order-delete,
        .btn-order-back {
            width: 100%;
        }
    }
</style>

<div class="order-delete-page">
    <div class="order-delete-container">

        <div class="order-delete-header">
            <h2>
                <span class="header-icon">✕</span>
                Xóa đơn hàng
            </h2>
            <p>Kiểm tra thông tin trước khi thực hiện xóa đơn hàng trong BookOra</p>
        </div>

        <div class="order-delete-card">

            <div class="order-card-heading">
                <div class="heading-icon">🗑</div>
                <div>
                    <h3>Thông tin đơn hàng</h3>
                    <p>Kiểm tra thông tin đơn hàng trước khi xác nhận thao tác</p>
                </div>
            </div>

            <div class="order-delete-content">

                @if (!String.IsNullOrEmpty(deleteError))
                {
                    <div class="order-delete-error">
                        <span class="warning-icon">✕</span>
                        <div class="warning-content">
                            <strong>Không thể xóa đơn hàng!</strong>
                            @deleteError
                        </div>
                    </div>
                }
                else if (orderDetailCount > 0)
                {
                    <div class="order-delete-warning">
                        <span class="warning-icon">⚠</span>
                        <div class="warning-content">
                            <strong>Đơn hàng đang có dữ liệu liên kết!</strong>
                            Đơn hàng này đang có
                            <strong>@orderDetailCount chi tiết sản phẩm</strong>
                            liên kết. Bạn không thể xóa đơn hàng này để bảo toàn lịch sử mua hàng.
                        </div>
                    </div>
                }
                else
                {
                    <div class="order-delete-warning">
                        <span class="warning-icon">⚠</span>
                        <div class="warning-content">
                            <strong>Bạn có chắc chắn muốn xóa đơn hàng này?</strong>
                            Thao tác xóa không thể hoàn tác. Vui lòng kiểm tra kỹ thông tin trước khi xác nhận.
                        </div>
                    </div>
                }

                <div class="order-id-highlight">
                    <span class="order-id-label">Mã đơn hàng</span>
                    <span class="order-id-value">#@Model.OrderID</span>
                </div>

                <div class="order-detail-row">
                    <span class="order-detail-label">
                        <span class="detail-icon">👤</span>
                        Khách hàng
                    </span>
                    <span class="order-detail-value">
                        @(Model.Customer != null
                            ? Model.Customer.CustomerName
                            : "Chưa có thông tin")
                    </span>
                </div>

                <div class="order-detail-row">
                    <span class="order-detail-label">
                        <span class="detail-icon">📅</span>
                        Ngày đặt hàng
                    </span>
                    <span class="order-detail-value">
                        @Model.OrderDate.ToString("dd/MM/yyyy")
                    </span>
                </div>

                <div class="order-detail-row">
                    <span class="order-detail-label">
                        <span class="detail-icon">💰</span>
                        Tổng tiền
                    </span>
                    <span class="order-detail-value order-detail-amount">
                        @String.Format("{0:N0} ₫", Model.TotalAmount)
                    </span>
                </div>

                <div class="order-detail-row">
                    <span class="order-detail-label">
                        <span class="detail-icon">💳</span>
                        Trạng thái thanh toán
                    </span>
                    <span class="order-detail-value">
                        @if (Model.PaymentStatus == "Chưa thanh toán")
                        {
                            <span class="order-payment-status unpaid">
                                ● Chưa thanh toán
                            </span>
                        }
                        else if (Model.PaymentStatus == "Đã thanh toán")
                        {
                            <span class="order-payment-status paid">
                                ● Đã thanh toán
                            </span>
                        }
                        else
                        {
                            <span class="order-payment-status other">
                                @(String.IsNullOrWhiteSpace(Model.PaymentStatus)
                                    ? "Chưa cập nhật"
                                    : Model.PaymentStatus)
                            </span>
                        }
                    </span>
                </div>

                <div class="order-detail-row">
                    <span class="order-detail-label">
                        <span class="detail-icon">📍</span>
                        Địa chỉ giao hàng
                    </span>
                    <span class="order-detail-value">
                        @(String.IsNullOrWhiteSpace(Model.AddressDelivery)
                            ? "Chưa cập nhật"
                            : Model.AddressDelivery)
                    </span>
                </div>

                <div class="order-detail-row">
                    <span class="order-detail-label">
                        <span class="detail-icon">📦</span>
                        Số chi tiết sản phẩm
                    </span>
                    <span class="order-detail-value">
                        <span class="order-detail-count">
                            @orderDetailCount
                        </span>
                    </span>
                </div>

                @using (Html.BeginForm(
                    "Delete",
                    "Orders",
                    new { area = "Admin", id = Model.OrderID },
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="order-delete-actions">

                        @Html.ActionLink(
                                 "← Quay lại danh sách",
                                 "Index",
                                 "Orders",
                                 new { area = "Admin" },
                                 new { @class = "btn-order-back" }
                             )

                        @if (orderDetailCount > 0 || !String.IsNullOrEmpty(deleteError))
                        {
                            <button type="button"
                                    class="btn-order-delete"
                                    disabled>
                                Không thể xóa
                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    class="btn-order-delete"
                                    onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng #@Model.OrderID không?');">
                                ✕ Xác nhận xóa
                            </button>
                        }

                    </div>
                }

            </div>
        </div>
    </div>
</div>
