
@model NguyeNhatDuy_25DH110313_MyStore.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .details-product-page {
        padding: 28px;
        min-height: 100vh;
        background: #f4f7fb;
        color: #243247;
        font-family: Arial, sans-serif;
    }

    .page-heading {
        margin-bottom: 25px;
    }

        .page-heading h2 {
            margin: 0 0 8px;
            font-size: 28px;
            font-weight: 700;
            color: #1e293b;
        }

        .page-heading p {
            margin: 0;
            color: #718096;
            font-size: 14px;
        }

    .breadcrumb-text {
        margin-bottom: 12px;
        color: #64748b;
        font-size: 13px;
    }

        .breadcrumb-text span {
            color: #2563eb;
        }

    .details-product-card {
        max-width: 1000px;
        padding: 30px;
        background: #fff;
        border: 1px solid #e5eaf2;
        border-radius: 14px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.05);
    }

    .details-card-heading {
        margin-bottom: 25px;
        padding-bottom: 18px;
        border-bottom: 1px solid #edf0f5;
    }

        .details-card-heading h3 {
            margin: 0 0 7px;
            font-size: 20px;
            font-weight: 700;
        }

        .details-card-heading p {
            margin: 0;
            color: #718096;
            font-size: 13px;
        }

    .product-details-content {
        display: flex;
        align-items: flex-start;
        gap: 32px;
    }

    .product-cover-section {
        flex: 0 0 290px;
        text-align: center;
    }

    .product-cover {
        display: block;
        box-sizing: border-box;
        width: 260px;
        height: 350px;
        object-fit: contain;
        margin: 0 auto;
        padding: 8px;
        background: #f8fafc;
        border: 1px solid #e5eaf2;
        border-radius: 10px;
    }

    .no-product-cover {
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        width: 200px;
        height: 270px;
        margin: 0 auto;
        padding: 15px;
        color: #94a3b8;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        font-size: 14px;
    }

    .product-id {
        display: inline-block;
        margin-top: 15px;
        padding: 7px 12px;
        color: #475569;
        background: #f1f5f9;
        border-radius: 7px;
        font-size: 13px;
    }

    .product-info-section {
        flex: 1;
        min-width: 0;
    }

    .product-name {
        margin: 0 0 22px;
        color: #1e293b;
        font-size: 24px;
        font-weight: 700;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .detail-row {
        padding: 15px 0;
        border-bottom: 1px solid #edf0f5;
    }

    .detail-label {
        display: block;
        margin-bottom: 7px;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
    }

    .detail-value {
        color: #334155;
        font-size: 14px;
        line-height: 1.7;
        overflow-wrap: anywhere;
        white-space: pre-line;
    }

    .product-price {
        color: #2563eb;
        font-size: 22px;
        font-weight: 700;
    }

    .product-description {
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #edf0f5;
    }

    .btn-edit,
    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 43px;
        padding: 0 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        box-sizing: border-box;
    }

    .btn-edit {
        color: #fff;
        background: #2563eb;
        border: 1px solid #2563eb;
    }

        .btn-edit:hover {
            color: #fff;
            background: #1d4ed8;
            border-color: #1d4ed8;
            text-decoration: none;
        }

    .btn-back {
        color: #475569;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .btn-back:hover {
            color: #1e293b;
            background: #f8fafc;
            text-decoration: none;
        }

    @@media (max-width: 768px) {
        .details-product-page {
            padding: 16px;
        }

        .details-product-card {
            padding: 20px;
        }

        .product-details-content {
            flex-direction: column;
            align-items: stretch;
            gap: 25px;
        }

        .product-cover-section {
            flex-basis: auto;
        }

        .product-info-section {
            width: 100%;
        }
    }
</style>

<div class="details-product-page">

    <div class="page-heading">
        <div class="breadcrumb-text">
            Admin / Sản phẩm / <span>Chi tiết sản phẩm</span>
        </div>

        <h2>Chi tiết sản phẩm</h2>
        <p>Xem thông tin chi tiết của sản phẩm trong hệ thống MyStore.</p>
    </div>

    <div class="details-product-card">

        <div class="details-card-heading">
            <h3>Thông tin sản phẩm</h3>
            <p>Thông tin được lấy từ dữ liệu sản phẩm hiện có.</p>
        </div>

        <div class="product-details-content">

            <div class="product-cover-section">

                @if (!string.IsNullOrWhiteSpace(Model.ProductImage))
                {
                    <img class="product-cover"
                         src="@Url.Content(Model.ProductImage)"
                         alt="@Model.ProductName"
                         id="bookCoverImage" />

                    <div class="no-product-cover"
                         id="bookCoverFallback"
                         style="display:none;">
                        Không tải được ảnh bìa
                    </div>
                }
                else
                {
                    <div class="no-product-cover">
                        Chưa có ảnh bìa
                    </div>
                }

                <div class="product-id">
                    Mã sản phẩm: #@Model.ProductID
                </div>

            </div>

            <div class="product-info-section">

                <h3 class="product-name">
                    @(string.IsNullOrWhiteSpace(Model.ProductName)
                        ? "Chưa có tên sản phẩm"
                        : Model.ProductName)
                </h3>

                <div class="detail-row">
                    <span class="detail-label">Danh mục sản phẩm</span>
                    <div class="detail-value">
                        @(Model.Category != null
                            ? Model.Category.CategoryName
                            : "Chưa phân loại")
                    </div>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Giá sản phẩm</span>
                    <div class="product-price">
                        @Model.ProductPrice.ToString("N0") VNĐ
                    </div>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Mô tả sản phẩm</span>
                    <div class="detail-value product-description">
                        @(string.IsNullOrWhiteSpace(Model.ProductDecription)
                            ? "Chưa có mô tả sản phẩm."
                            : Model.ProductDecription)
                    </div>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Đường dẫn hình ảnh</span>
                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.ProductImage)
                            ? "Chưa có đường dẫn hình ảnh."
                            : Model.ProductImage)
                    </div>
                </div>

            </div>
        </div>

        <div class="form-actions">

            @Html.ActionLink(
                "Chỉnh sửa sản phẩm",
                "Edit",
                "Product",
                new { id = Model.ProductID, area = "Admin" },
                new { @class = "btn-edit" })

            @Html.ActionLink(
                "Quay lại danh sách",
                "Index",
                "Product",
                new { area = "Admin" },
                new { @class = "btn-back" })

        </div>

    </div>
</div>


<script>
        (function () {
            var imgElement = document.getElementById("bookCoverImage");
            var fallbackElement = document.getElementById("bookCoverFallback");

            if (
                !(imgElement instanceof HTMLImageElement) ||
                !(fallbackElement instanceof HTMLElement)
            ) {
                return;
            }

            var img = imgElement;
            var fallback = fallbackElement;

            img.addEventListener("error", function () {
                img.style.display = "none";
                fallback.style.display = "flex";
            });
        })();
</script>

