
@model NguyeNhatDuy_25DH110313_MyStore.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .details-product-page {
        min-height: 100vh;
        padding: 30px;
        background: #f4f7fc;
        color: #243247;
        font-family: Arial, sans-serif;
    }

    .page-heading {
        margin-bottom: 25px;
    }

    .breadcrumb-text {
        margin-bottom: 13px;
        color: #64748b;
        font-size: 13px;
    }

        .breadcrumb-text span {
            color: #2563eb;
            font-weight: 600;
        }

    .page-title-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 8px;
    }

    .page-title-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #1e40af);
        border-radius: 13px;
        font-size: 21px;
        box-shadow: 0 5px 12px rgba(37, 99, 235, 0.2);
    }

    .page-heading h2 {
        margin: 0;
        color: #172554;
        font-size: 27px;
        font-weight: 700;
    }

    .page-heading p {
        margin: 0;
        color: #718096;
        font-size: 14px;
    }

    .details-product-card {
        max-width: 1100px;
        padding: 30px;
        background: #fff;
        border: 1px solid #e5eaf2;
        border-radius: 16px;
        box-shadow: 0 6px 24px rgba(15, 23, 42, 0.05);
    }

    .details-card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 27px;
        padding-bottom: 20px;
        border-bottom: 1px solid #edf0f5;
    }

    .details-heading-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        color: #2563eb;
        background: #eff6ff;
        border-radius: 11px;
        font-size: 18px;
    }

    .details-card-heading h3 {
        margin: 0 0 6px;
        color: #1e293b;
        font-size: 19px;
        font-weight: 700;
    }

    .details-card-heading p {
        margin: 0;
        color: #718096;
        font-size: 13px;
    }

    .product-details-content {
        display: flex;
        align-items: flex-start;
        gap: 38px;
    }

    .product-cover-section {
        flex: 0 0 290px;
        text-align: center;
    }

    .product-cover-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 370px;
        padding: 15px;
        background: #f8fafc;
        border: 1px solid #e5eaf2;
        border-radius: 13px;
    }

    .product-cover {
        display: block;
        box-sizing: border-box;
        width: 100%;
        max-width: 260px;
        height: 340px;
        object-fit: contain;
        border-radius: 7px;
    }

    .no-product-cover {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        width: 100%;
        max-width: 230px;
        height: 310px;
        padding: 15px;
        color: #94a3b8;
        background: #f1f5f9;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        font-size: 14px;
        gap: 12px;
    }

        .no-product-cover i {
            font-size: 42px;
            color: #94a3b8;
        }

    .product-id {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
        padding: 9px 14px;
        color: #1d4ed8;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

    .product-info-section {
        flex: 1;
        min-width: 0;
    }

    .product-name {
        margin: 0 0 20px;
        color: #172554;
        font-size: 25px;
        font-weight: 700;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .product-category-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 12px;
        padding: 7px 11px;
        color: #1d4ed8;
        background: #eff6ff;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
    }

    .detail-row {
        padding: 17px 0;
        border-bottom: 1px solid #edf0f5;
    }

    .detail-label {
        display: block;
        margin-bottom: 8px;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
    }

    .detail-value {
        color: #334155;
        font-size: 14px;
        line-height: 1.8;
        overflow-wrap: anywhere;
        white-space: pre-line;
    }

    .product-price {
        color: #2563eb;
        font-size: 25px;
        font-weight: 700;
    }

    .product-description {
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .image-path {
        padding: 10px 12px;
        color: #475569;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 13px;
        word-break: break-all;
    }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
        padding-top: 23px;
        border-top: 1px solid #edf0f5;
    }

    .btn-edit,
    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 0 21px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

    .btn-edit {
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        border: 1px solid #2563eb;
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.17);
    }

        .btn-edit:hover {
            color: #fff;
            background: #1e40af;
            border-color: #1e40af;
            text-decoration: none;
            transform: translateY(-3px);
            box-shadow: 0 7px 15px rgba(37, 99, 235, 0.22);
        }

    .btn-back {
        color: #475569;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .btn-back:hover {
            color: #1e40af;
            background: #eff6ff;
            border-color: #93c5fd;
            text-decoration: none;
            transform: translateY(-3px);
        }

    @@media (max-width: 768px) {
        .details-product-page {
            padding: 18px 14px;
        }

        .details-product-card {
            padding: 20px;
        }

        .product-details-content {
            flex-direction: column;
            align-items: stretch;
            gap: 25px;
        }

        .product-cover-section {
            flex-basis: auto;
            width: 100%;
        }

        .product-info-section {
            width: 100%;
        }

        .page-heading h2 {
            font-size: 23px;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-edit,
        .btn-back {
            width: 100%;
        }
    }
</style>

<div class="details-product-page">

    <div class="page-heading">
        <div class="breadcrumb-text">
            Admin / Sản phẩm / <span>Chi tiết sản phẩm</span>
        </div>

        <div class="page-title-row">
            <div class="page-title-icon">
                <i class="fa fa-book"></i>
            </div>

            <h2>Chi tiết sản phẩm</h2>
        </div>

        <p>Xem đầy đủ thông tin sản phẩm trong hệ thống BookOra.</p>
    </div>

    <div class="details-product-card">

        <div class="details-card-heading">
            <div class="details-heading-icon">
                <i class="fa fa-info-circle"></i>
            </div>

            <div>
                <h3>Thông tin sản phẩm</h3>
                <p>Thông tin được lấy từ dữ liệu sản phẩm hiện có.</p>
            </div>
        </div>

        <div class="product-details-content">

            <div class="product-cover-section">

                <div class="product-cover-wrapper">

                    @if (!string.IsNullOrWhiteSpace(Model.ProductImage))
                    {
                        <img class="product-cover"
                             src="@Url.Content(Model.ProductImage)"
                             alt="@Model.ProductName" />
                    }
                    else
                    {
                        <div class="no-product-cover">
                            <i class="fa fa-book"></i>
                            <span>Chưa có ảnh bìa</span>
                        </div>
                    }

                </div>

                <div class="product-id">
                    <i class="fa fa-barcode"></i>
                    Mã sản phẩm: #@Model.ProductID
                </div>

            </div>

            <div class="product-info-section">

                <div class="product-category-badge">
                    <i class="fa fa-folder-open"></i>

                    @(Model.Category != null
                        ? Model.Category.CategoryName
                        : "Chưa phân loại")
                </div>

                <h3 class="product-name">
                    @(string.IsNullOrWhiteSpace(Model.ProductName)
                        ? "Chưa có tên sản phẩm"
                        : Model.ProductName)
                </h3>

                <div class="detail-row">
                    <span class="detail-label">Giá sản phẩm</span>

                    <div class="product-price">
                        @Model.ProductPrice.ToString("N0") VNĐ
                    </div>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Mô tả sản phẩm</span>

                    <div class="detail-value product-description">
                        @(string.IsNullOrWhiteSpace(Model.ProductDecription)
                            ? "Chưa có mô tả sản phẩm."
                            : Model.ProductDecription)
                    </div>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Đường dẫn hình ảnh</span>

                    <div class="image-path">
                        @(string.IsNullOrWhiteSpace(Model.ProductImage)
                            ? "Chưa có đường dẫn hình ảnh."
                            : Model.ProductImage)
                    </div>
                </div>

            </div>
        </div>

        <div class="form-actions">

            @Html.ActionLink(
                     "Chỉnh sửa sản phẩm",
                     "Edit",
                     "Product",
                     new { id = Model.ProductID, area = "Admin" },
                     new { @class = "btn-edit" })

            @Html.ActionLink(
                     "Quay lại danh sách",
                     "Index",
                     "Product",
                     new { area = "Admin" },
                     new { @class = "btn-back" })

        </div>

    </div>
</div>
