
@model NguyeNhatDuy_25DH110313_MyStore.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .delete-product-page {
        min-height: 100vh;
        padding: 30px;
        background: #f4f7fb;
        color: #243247;
        font-family: Arial, sans-serif;
    }

    .page-heading {
        margin-bottom: 25px;
    }

    .breadcrumb-text {
        margin-bottom: 12px;
        color: #64748b;
        font-size: 13px;
    }

        .breadcrumb-text span {
            color: #dc2626;
            font-weight: 600;
        }

    .page-heading h2 {
        margin: 0 0 8px;
        color: #172554;
        font-size: 28px;
        font-weight: 700;
    }

    .page-heading p {
        margin: 0;
        color: #718096;
        font-size: 14px;
    }

    .delete-product-card {
        max-width: 1050px;
        padding: 30px;
        background: #fff;
        border: 1px solid #e5eaf2;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
    }

    .delete-card-heading {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 1px solid #edf0f5;
    }

    .delete-heading-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 48px;
        width: 48px;
        height: 48px;
        color: #dc2626;
        background: #fef2f2;
        border-radius: 13px;
        font-size: 21px;
    }

    .delete-card-heading h3 {
        margin: 0 0 7px;
        color: #1e293b;
        font-size: 20px;
        font-weight: 700;
    }

    .delete-card-heading p {
        margin: 0;
        color: #718096;
        font-size: 13px;
        line-height: 1.6;
    }

    .delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 28px;
        padding: 16px 18px;
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 10px;
        font-size: 14px;
        line-height: 1.7;
    }

        .delete-warning i {
            margin-top: 3px;
            font-size: 18px;
        }

    .product-details-content {
        display: flex;
        align-items: flex-start;
        gap: 35px;
    }

    .product-cover-section {
        flex: 0 0 280px;
        text-align: center;
    }

    .product-cover-wrapper {
        position: relative;
        width: 250px;
        height: 340px;
        margin: 0 auto;
        overflow: hidden;
        background: #f8fafc;
        border: 1px solid #e5eaf2;
        border-radius: 12px;
    }

    .no-product-cover {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: #94a3b8;
        background: #f8fafc;
        font-size: 14px;
    }

        .no-product-cover i {
            font-size: 42px;
        }

    .product-cover {
        position: relative;
        z-index: 1;
        display: block;
        box-sizing: border-box;
        width: 100%;
        height: 100%;
        padding: 8px;
        object-fit: contain;
        background: #f8fafc;
    }

    .product-id {
        display: inline-block;
        margin-top: 15px;
        padding: 8px 13px;
        color: #475569;
        background: #f1f5f9;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

    .product-info-section {
        flex: 1;
        min-width: 0;
    }

    .product-name {
        margin: 0 0 22px;
        color: #172554;
        font-size: 25px;
        font-weight: 700;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .detail-row {
        padding: 16px 0;
        border-bottom: 1px solid #edf0f5;
    }

    .detail-label {
        display: block;
        margin-bottom: 8px;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
    }

    .detail-value {
        color: #334155;
        font-size: 14px;
        line-height: 1.8;
        overflow-wrap: anywhere;
        white-space: pre-line;
    }

    .product-price {
        color: #2563eb;
        font-size: 23px;
        font-weight: 700;
    }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
        padding-top: 23px;
        border-top: 1px solid #edf0f5;
    }

    .btn-delete,
    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 0 21px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-delete {
        color: #fff;
        background: #dc2626;
        border: 1px solid #dc2626;
    }

        .btn-delete:hover {
            color: #fff;
            background: #b91c1c;
            border-color: #b91c1c;
            transform: translateY(-3px);
            box-shadow: 0 6px 14px rgba(220, 38, 38, 0.2);
        }

    .btn-cancel {
        color: #475569;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .btn-cancel:hover {
            color: #1e293b;
            background: #f1f5f9;
            text-decoration: none;
            transform: translateY(-3px);
            box-shadow: 0 5px 12px rgba(15, 23, 42, 0.08);
        }

    @@media (max-width: 768px) {
        .delete-product-page {
            padding: 16px;
        }

        .delete-product-card {
            padding: 20px;
        }

        .product-details-content {
            flex-direction: column;
            align-items: stretch;
            gap: 25px;
        }

        .product-cover-section {
            flex-basis: auto;
        }

        .product-info-section {
            width: 100%;
        }

        .product-name {
            font-size: 21px;
        }
    }

    @@media (max-width: 480px) {
        .form-actions {
            flex-direction: column;
        }

        .btn-delete,
        .btn-cancel {
            width: 100%;
        }
    }
</style>

<div class="delete-product-page">

    <div class="page-heading">
        <div class="breadcrumb-text">
            Admin / Sản phẩm / <span>Xóa sản phẩm</span>
        </div>

        <h2>
            <i class="fa fa-trash"></i>
            Xóa sản phẩm
        </h2>

        <p>Kiểm tra thông tin sản phẩm trước khi thực hiện thao tác xóa.</p>
    </div>

    <div class="delete-product-card">

        <div class="delete-card-heading">
            <div class="delete-heading-icon">
                <i class="fa fa-exclamation-triangle"></i>
            </div>

            <div>
                <h3>Xác nhận xóa sản phẩm</h3>
                <p>Vui lòng kiểm tra kỹ thông tin sản phẩm trước khi xác nhận.</p>
            </div>
        </div>

        <div class="delete-warning">
            <i class="fa fa-exclamation-circle"></i>
            <div>
                <strong>Lưu ý:</strong>
                Bạn đang chuẩn bị xóa sản phẩm này khỏi hệ thống.
                Hãy chắc chắn rằng bạn muốn thực hiện thao tác này trước khi tiếp tục.
            </div>
        </div>

        <div class="product-details-content">

            <div class="product-cover-section">

                <div class="product-cover-wrapper">

                    <div class="no-product-cover">
                        <i class="fa fa-book"></i>
                        <span>Không có ảnh bìa</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ProductImage))
                    {
                        <img class="product-cover"
                             src="@Url.Content(Model.ProductImage)"
                             alt="@Model.ProductName" />
                    }

                </div>

                <div class="product-id">
                    Mã sản phẩm: #@Model.ProductID
                </div>

            </div>

            <div class="product-info-section">

                <h3 class="product-name">
                    @(string.IsNullOrWhiteSpace(Model.ProductName)
                        ? "Chưa có tên sản phẩm"
                        : Model.ProductName)
                </h3>

                <div class="detail-row">
                    <span class="detail-label">Danh mục sản phẩm</span>

                    <div class="detail-value">
                        @(Model.Category != null
                            ? Model.Category.CategoryName
                            : "Chưa phân loại")
                    </div>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Giá sản phẩm</span>

                    <div class="product-price">
                        @Model.ProductPrice.ToString("N0") VNĐ
                    </div>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Mô tả sản phẩm</span>

                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.ProductDecription)
                            ? "Chưa có mô tả sản phẩm."
                            : Model.ProductDecription)
                    </div>
                </div>

            </div>

        </div>

        @using (Html.BeginForm(
            "Delete",
            "Product",
            new { area = "Admin", id = Model.ProductID },
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ProductID)

            <div class="form-actions">

                <button type="submit"
                        class="btn-delete"
                        onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?');">
                    <i class="fa fa-trash"></i>
                    Xác nhận xóa
                </button>

                @Html.ActionLink(
                         "Hủy",
                         "Index",
                         "Product",
                         new { area = "Admin" },
                         new { @class = "btn-cancel" }
                     )

            </div>
        }

    </div>
</div>
