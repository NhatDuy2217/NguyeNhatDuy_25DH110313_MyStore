
@model IEnumerable<NguyeNhatDuy_25DH110313_MyStore.Models.Product>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";

    int currentPage = ViewBag.CurrentPage == null ? 1 : (int)ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages == null ? 0 : (int)ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems == null ? 0 : (int)ViewBag.TotalItems;
    int pageSizeValue = ViewBag.PageSize == null ? 5 : (int)ViewBag.PageSize;

    string currentFilter = ViewBag.CurrentFilter as string ?? "";
    string currentSort = ViewBag.CurrentSort as string ?? "";

    int? currentCategoryId = ViewBag.CurrentCategoryId == null
        ? (int?)null
        : (int?)ViewBag.CurrentCategoryId;
}

<style>
    .product-page {
        color: #243047;
        padding-bottom: 30px;
    }

    .product-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }

        .product-heading h2 {
            margin: 0;
            color: #172554;
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .product-heading p {
            color: #718096;
            margin: 7px 0 0;
            font-size: 14px;
        }

    .product-heading-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        margin-right: 9px;
        border-radius: 13px;
        color: #fff;
        background: linear-gradient(135deg, #263d83, #4778d5);
        box-shadow: 0 5px 13px rgba(38, 61, 131, .2);
        vertical-align: middle;
        font-size: 19px;
    }

    .btn-add-product {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 12px 19px;
        border-radius: 11px;
        color: #fff !important;
        background: linear-gradient(135deg, #263d83, #4169bd);
        box-shadow: 0 5px 13px rgba(38, 61, 131, .18);
        text-decoration: none !important;
        font-weight: 700;
        font-size: 14px;
        transition: all .2s ease;
    }

        .btn-add-product:hover {
            color: #fff;
            transform: translateY(-3px);
            box-shadow: 0 9px 18px rgba(38, 61, 131, .25);
        }

    .product-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 17px;
        padding: 17px;
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(31, 48, 80, .045);
    }

    .product-search {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        flex: 1;
    }

        .product-search input[type="text"],
        .product-search select {
            height: 42px;
            padding: 9px 12px;
            border: 1px solid #dce3ef;
            border-radius: 9px;
            outline: none;
            background: #fff;
            color: #34425b;
            font-size: 13px;
            transition: all .2s ease;
        }

        .product-search input[type="text"] {
            width: 260px;
            max-width: 100%;
        }

        .product-search select {
            min-width: 190px;
            max-width: 100%;
        }

            .product-search input:focus,
            .product-search select:focus {
                border-color: #5279d0;
                box-shadow: 0 0 0 3px rgba(82, 121, 208, .12);
            }

    .btn-search,
    .btn-reset {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        height: 42px;
        padding: 0 15px;
        border: none;
        border-radius: 9px;
        text-decoration: none !important;
        cursor: pointer;
        font-weight: 700;
        font-size: 13px;
        transition: all .2s ease;
    }

    .btn-search {
        background: #31549e;
        color: #fff !important;
    }

        .btn-search:hover {
            background: #243f7d;
            transform: translateY(-2px);
        }

    .btn-reset {
        background: #eef2f8;
        color: #52627b !important;
    }

        .btn-reset:hover {
            background: #e1e8f2;
            transform: translateY(-2px);
        }

    .page-size-selector {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #63718a;
        font-size: 13px;
        white-space: nowrap;
    }

        .page-size-selector label {
            margin: 0;
        }

        .page-size-selector select {
            height: 39px;
            padding: 7px 11px;
            border: 1px solid #dce3ef;
            border-radius: 9px;
            background: #fff;
            color: #34425b;
            outline: none;
        }

    .product-sort-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 17px;
    }

    .sort-label {
        font-weight: 700;
        color: #42516b;
        margin-right: 3px;
        font-size: 13px;
    }

    .product-sort-links a {
        display: inline-block;
        padding: 8px 12px;
        background: #fff;
        color: #536582;
        border: 1px solid #e0e7f1;
        border-radius: 9px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        transition: all .2s ease;
    }

        .product-sort-links a:hover,
        .product-sort-links a.sort-active {
            background: #eaf0ff;
            border-color: #b9c9f0;
            color: #294b99;
        }

    .product-count {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        color: #718096;
        margin-bottom: 13px;
        font-size: 13px;
    }

        .product-count strong {
            color: #294b99;
        }

    .product-table-wrapper {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 15px;
        padding: 19px;
        box-shadow: 0 5px 20px rgba(31, 48, 80, .05);
        overflow-x: auto;
    }

    .product-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin-bottom: 0;
        table-layout: auto;
    }

        .product-table th {
            background: #f3f6fc;
            color: #52617b;
            padding: 14px 12px;
            text-align: left;
            white-space: nowrap;
            border-top: 1px solid #e8edf5;
            border-bottom: 1px solid #e3e9f3;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .35px;
        }

            .product-table th:first-child {
                border-radius: 9px 0 0 0;
            }

            .product-table th:last-child {
                border-radius: 0 9px 0 0;
            }

        .product-table td {
            padding: 14px 12px;
            border-bottom: 1px solid #edf0f6;
            vertical-align: middle;
            color: #526078;
            font-size: 13px;
        }

        .product-table tbody tr {
            transition: background .2s ease;
        }

            .product-table tbody tr:hover {
                background: #f8faff;
            }

            .product-table tbody tr:last-child td {
                border-bottom: none;
            }

    .product-name {
        font-weight: 700;
        color: #293b60 !important;
        width: 180px;
        min-width: 150px;
        max-width: 180px;
        overflow-wrap: anywhere;
    }

    .product-description {
        width: 260px;
        min-width: 200px;
        max-width: 260px;
        line-height: 1.6;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .product-description-text {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        overflow: hidden;
    }

    .product-price {
        color: #16845c !important;
        font-weight: 800;
        white-space: nowrap;
    }

    .product-image-column {
        width: 125px;
        min-width: 125px;
    }

    .product-cover {
        width: 105px;
        height: 145px;
        object-fit: contain;
        background: #f7f9fd;
        border: 1px solid #e5eaf2;
        border-radius: 9px;
        display: block;
        padding: 4px;
        transition: all .2s ease;
    }

        .product-cover:hover {
            transform: scale(1.04);
            box-shadow: 0 5px 14px rgba(35, 57, 103, .12);
        }

    .product-no-image {
        width: 100px;
        height: 130px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #f1f4fa;
        color: #8290a7;
        border: 1px dashed #cbd5e4;
        border-radius: 9px;
        font-size: 12px;
        text-align: center;
    }

        .product-no-image i {
            font-size: 23px;
        }

    .product-actions {
        white-space: nowrap;
        min-width: 185px;
    }

        .product-actions a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            margin: 3px 2px;
            padding: 8px 10px;
            border-radius: 8px;
            text-decoration: none !important;
            font-size: 12px;
            font-weight: 700;
            transition: all .2s ease;
        }

            .product-actions a:hover {
                transform: translateY(-3px);
                box-shadow: 0 5px 11px rgba(31, 48, 80, .13);
            }

    .action-edit {
        background: #fff5df;
        color: #986b12 !important;
    }

    .action-details {
        background: #eaf1ff;
        color: #31549e !important;
    }

    .action-delete {
        background: #fff0f0;
        color: #c04444 !important;
    }

    .empty-products {
        text-align: center;
        color: #8290a7 !important;
        padding: 38px 20px !important;
        font-size: 14px !important;
    }

    .product-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 20px;
    }

    .pagination-info {
        color: #8490a4;
        font-size: 12px;
    }

        .pagination-info strong {
            color: #344d87;
        }

    .pagination-buttons {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 5px;
    }

        .pagination-buttons a,
        .pagination-buttons span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 36px;
            min-height: 35px;
            padding: 7px 11px;
            text-align: center;
            border-radius: 8px;
            text-decoration: none;
            border: 1px solid #e0e7f1;
            font-size: 12px;
            font-weight: 600;
            transition: all .2s ease;
        }

        .pagination-buttons a {
            color: #526b9e;
            background: #fff;
        }

            .pagination-buttons a:hover {
                background: #edf2ff;
                border-color: #c4d1ee;
            }

        .pagination-buttons .active-page {
            background: #31549e;
            color: #fff;
            border-color: #31549e;
            box-shadow: 0 3px 8px rgba(49, 84, 158, .2);
        }

        .pagination-buttons .disabled-page {
            color: #b2bac8;
            background: #f7f8fb;
            cursor: not-allowed;
        }

    @@media (max-width: 768px) {
        .product-heading h2 {
            font-size: 22px;
        }

        .product-toolbar {
            align-items: stretch;
        }

        .product-search {
            align-items: stretch;
            flex-direction: column;
        }

            .product-search input[type="text"],
            .product-search select,
            .product-search button,
            .product-search .btn-reset {
                width: 100%;
                box-sizing: border-box;
            }

        .page-size-selector {
            justify-content: flex-end;
        }

        .product-table-wrapper {
            padding: 11px;
        }

        .product-cover,
        .product-no-image {
            width: 80px;
            height: 110px;
        }

        .product-image-column {
            min-width: 95px;
        }

        .product-pagination {
            align-items: flex-start;
        }
    }
</style>

<div class="product-page">

    <div class="product-heading">
        <div>
            <h2>
                <span class="product-heading-icon">
                    <i class="fa fa-book"></i>
                </span>
                Quản lý sản phẩm
            </h2>
            <p>Quản lý danh sách sách, giá bán và danh mục trong cửa hàng BookOra</p>
        </div>

        <div>
            @Html.ActionLink(
                     "+ Thêm sản phẩm",
                     "Create",
                     "Product",
                     new { area = "Admin" },
                     new { @class = "btn-add-product" }
                 )
        </div>
    </div>

    @using (Html.BeginForm(
        "Index",
        "Product",
        new { area = "Admin" },
        FormMethod.Get))
    {
        <div class="product-toolbar">

            <div class="product-search">

                <input type="text"
                       name="searchString"
                       value="@currentFilter"
                       placeholder="Nhập tên sản phẩm cần tìm..." />

                @Html.DropDownList(
                         "categoryId",
                         ViewBag.Categories as IEnumerable<System.Web.Mvc.SelectListItem>,
                         "-- Tất cả danh mục --",
                         new { @class = "category-select" }
                     )

                <input type="hidden"
                       name="sortOrder"
                       value="@currentSort" />

                <button type="submit" class="btn-search">
                    <i class="fa fa-search"></i> Tìm kiếm
                </button>

                @Html.ActionLink(
                         "Làm mới",
                         "Index",
                         "Product",
                         new { area = "Admin" },
                         new { @class = "btn-reset" }
                     )

            </div>

            <div class="page-size-selector">
                <label for="pageSize">Sản phẩm/trang:</label>

                <select id="pageSize" name="pageSize">
                    <option value="5" @(pageSizeValue == 5 ? "selected=\"selected\"" : "")>5</option>
                    <option value="10" @(pageSizeValue == 10 ? "selected=\"selected\"" : "")>10</option>
                    <option value="20" @(pageSizeValue == 20 ? "selected=\"selected\"" : "")>20</option>
                </select>
            </div>

        </div>
    }

    <div class="product-sort-links">
        <span class="sort-label">Sắp xếp:</span>

        @Html.ActionLink(
                 "Tên A → Z",
                 "Index",
                 new
                 {
                     searchString = currentFilter,
                     sortOrder = "name_asc",
                     pageSize = pageSizeValue,
                     categoryId = currentCategoryId
                 },
                 new
                 {
                     @class = currentSort == "name_asc" ? "sort-active" : ""
                 }
             )

        @Html.ActionLink(
                 "Tên Z → A",
                 "Index",
                 new
                 {
                     searchString = currentFilter,
                     sortOrder = "name_desc",
                     pageSize = pageSizeValue,
                     categoryId = currentCategoryId
                 },
                 new
                 {
                     @class = currentSort == "name_desc" ? "sort-active" : ""
                 }
             )

        @Html.ActionLink(
                 "Giá thấp → cao",
                 "Index",
                 new
                 {
                     searchString = currentFilter,
                     sortOrder = "price_asc",
                     pageSize = pageSizeValue,
                     categoryId = currentCategoryId
                 },
                 new
                 {
                     @class = currentSort == "price_asc" ? "sort-active" : ""
                 }
             )

        @Html.ActionLink(
                 "Giá cao → thấp",
                 "Index",
                 new
                 {
                     searchString = currentFilter,
                     sortOrder = "price_desc",
                     pageSize = pageSizeValue,
                     categoryId = currentCategoryId
                 },
                 new
                 {
                     @class = currentSort == "price_desc" ? "sort-active" : ""
                 }
             )
    </div>

    <div class="product-count">
        <i class="fa fa-list"></i>
        <span>Tìm thấy <strong>@totalItems</strong> sản phẩm</span>

        @if (!string.IsNullOrWhiteSpace(currentFilter))
        {
            <span>
                với từ khóa "<strong>@currentFilter</strong>"
            </span>
        }

        @if (currentCategoryId.HasValue)
        {
            <span>trong danh mục đã chọn</span>
        }
    </div>

    <div class="product-table-wrapper">

        <table class="product-table">
            <thead>
                <tr>
                    <th>Tên sản phẩm</th>
                    <th>Mô tả</th>
                    <th>Giá bán</th>
                    <th>Ảnh bìa</th>
                    <th>Danh mục</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="product-name">
                                @item.ProductName
                            </td>

                            <td class="product-description">
                                <div class="product-description-text">
                                    @item.ProductDecription
                                </div>
                            </td>

                            <td class="product-price">
                                @item.ProductPrice.ToString("N0") VNĐ
                            </td>

                            <td class="product-image-column">
                                @if (!string.IsNullOrWhiteSpace(item.ProductImage))
                                {
                                    <img src="@Url.Content(item.ProductImage)"
                                         alt="@item.ProductName"
                                         class="product-cover" />
                                }
                                else
                                {
                                    <div class="product-no-image">
                                        <i class="fa fa-image"></i>
                                        <span>Chưa có ảnh</span>
                                    </div>
                                }
                            </td>

                            <td>
                                @(item.Category == null
                                    ? "Chưa phân loại"
                                    : item.Category.CategoryName)
                            </td>

                            <td class="product-actions">

                                @Html.ActionLink(
                                              "Chi tiết",
                                              "Details",
                                              "Product",
                                              new
                                              {
                                                  id = item.ProductID,
                                                  area = "Admin"
                                              },
                                              new { @class = "action-details" }
)

                                @Html.ActionLink(
                                              "Sửa",
                                              "Edit",
                                              "Product",
                                              new
                                              {
                                                  id = item.ProductID,
                                                  area = "Admin"
                                              },
                                              new { @class = "action-edit" }
                                          )

                                @Html.ActionLink(
                                              "Xóa",
                                              "Delete",
                                              "Product",
                                              new
                                              {
                                                  id = item.ProductID,
                                                  area = "Admin"
                                              },
                                              new { @class = "action-delete" }
                                          )

                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty-products">

                            @if (!string.IsNullOrWhiteSpace(currentFilter)
                                && currentCategoryId.HasValue)
                            {
                                <span>
                                    Không tìm thấy sản phẩm phù hợp với từ khóa
                                    "@currentFilter" trong danh mục đã chọn.
                                </span>
                            }
                            else if (!string.IsNullOrWhiteSpace(currentFilter))
                            {
                                <span>
                                    Không tìm thấy sản phẩm phù hợp với từ khóa
                                    "@currentFilter".
                                </span>
                            }
                            else if (currentCategoryId.HasValue)
                            {
                                <span>
                                    Không có sản phẩm trong danh mục đã chọn.
                                </span>
                            }
                            else
                            {
                                <span>
                                    Chưa có sản phẩm nào đang kinh doanh.
                                </span>
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="product-pagination">

            <div class="pagination-info">
                @if (totalItems > 0)
                {
                    <span>
                        Hiển thị
                        <strong>@((currentPage - 1) * pageSizeValue + 1)</strong>
                        -
                        <strong>@Math.Min(currentPage * pageSizeValue, totalItems)</strong>
                        trong tổng số <strong>@totalItems</strong> sản phẩm
                    </span>
                }
                else
                {
                    <span>Không có kết quả để hiển thị.</span>
                }
            </div>

            <div class="pagination-buttons">

                @if (currentPage > 1)
                {
                    @Html.ActionLink(
                             "« Trước",
                             "Index",
                             new
                             {
                                 searchString = currentFilter,
                                 sortOrder = currentSort,
                                 page = currentPage - 1,
                                 pageSize = pageSizeValue,
                                 categoryId = currentCategoryId
                             }
                         )
                }
                else
                {
                    <span class="disabled-page">« Trước</span>
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == currentPage)
                    {
                        <span class="active-page">@i</span>
                    }
                    else
                    {
                        @Html.ActionLink(
                                 i.ToString(),
                                 "Index",
                                 new
                                 {
                                     searchString = currentFilter,
                                     sortOrder = currentSort,
                                     page = i,
                                     pageSize = pageSizeValue,
                                     categoryId = currentCategoryId
                                 }
                             )
                    }
                }

                @if (currentPage < totalPages)
                {
                    @Html.ActionLink(
                             "Sau »",
                             "Index",
                             new
                             {
                                 searchString = currentFilter,
                                 sortOrder = currentSort,
                                 page = currentPage + 1,
                                 pageSize = pageSizeValue,
                                 categoryId = currentCategoryId
                             }
                         )
                }
                else
                {
                    <span class="disabled-page">Sau »</span>
                }

            </div>
        </div>

    </div>
</div>

<script>
        document.addEventListener("DOMContentLoaded", function () {

            var element = document.getElementById("pageSize");

            if (element === null) {
                return;
            }

            if (element.tagName !== "SELECT") {
                return;
            }

            var select = document.querySelector("#pageSize");

            if (select === null) {
                return;
            }

            select.addEventListener("change", function () {

                var form = document.querySelector(
                    "#pageSize"
                );

                if (form === null) {
                    return;
                }

                var formElement = form.closest("form");

                if (formElement !== null &&
                    formElement.tagName === "FORM") {

                    var submitButton = document.createElement("button");
                    submitButton.type = "submit";
                    submitButton.style.display = "none";

                    formElement.appendChild(submitButton);
                    submitButton.click();
                    formElement.removeChild(submitButton);
                }

            });

        });
</script>
