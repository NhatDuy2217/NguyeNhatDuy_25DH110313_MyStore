
@model NguyeNhatDuy_25DH110313_MyStore.Models.Product

@{
    ViewBag.Title = "Thêm sản phẩm";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .create-product-page {
        padding: 10px 0 35px;
        color: #243047;
    }

    .product-page-heading {
        margin-bottom: 25px;
    }

    .breadcrumb-text {
        margin-bottom: 13px;
        color: #8290a7;
        font-size: 13px;
    }

        .breadcrumb-text span {
            color: #31549e;
            font-weight: 700;
        }

    .page-title-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .page-title-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        border-radius: 15px;
        color: white;
        background: linear-gradient(135deg, #263d83, #4778d5);
        box-shadow: 0 6px 15px rgba(38, 61, 131, .2);
        font-size: 21px;
    }

    .page-title-row h2 {
        margin: 0;
        color: #172554;
        font-size: 26px;
        font-weight: 800;
    }

    .page-title-row p {
        margin: 6px 0 0;
        color: #8290a7;
        font-size: 13px;
    }

    .product-form-card {
        max-width: 950px;
        padding: 28px;
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(31, 48, 80, .05);
    }

    .form-card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 1px solid #edf0f6;
    }

    .form-card-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        border-radius: 12px;
        color: #31549e;
        background: #edf2ff;
        font-size: 18px;
    }

    .form-card-heading h3 {
        margin: 0 0 6px;
        color: #263653;
        font-size: 19px;
        font-weight: 800;
    }

    .form-card-heading p {
        margin: 0;
        color: #8793a7;
        font-size: 13px;
    }

    .required-note {
        margin-bottom: 21px;
        color: #8793a7;
        font-size: 12px;
    }

    .required-star {
        color: #dc5555;
    }

    .form-row {
        margin-bottom: 21px;
    }

        .form-row label {
            display: block;
            margin-bottom: 9px;
            color: #3b4962;
            font-size: 13px;
            font-weight: 700;
        }

        .form-row input,
        .form-row select,
        .form-row textarea {
            display: block;
            box-sizing: border-box;
            width: 100%;
            min-height: 45px;
            padding: 11px 13px;
            color: #34425b;
            background: #fff;
            border: 1px solid #dce3ef;
            border-radius: 9px;
            outline: none;
            font-family: Arial, sans-serif;
            font-size: 13px;
            transition: border-color .2s, box-shadow .2s;
        }

        .form-row textarea {
            min-height: 125px;
            resize: vertical;
            line-height: 1.6;
        }

            .form-row input:focus,
            .form-row select:focus,
            .form-row textarea:focus {
                border-color: #5279d0;
                box-shadow: 0 0 0 3px rgba(82, 121, 208, .12);
            }

            .form-row input::placeholder,
            .form-row textarea::placeholder {
                color: #a4afbf;
            }

    .field-validation-error {
        display: block;
        margin-top: 7px;
        color: #d04444;
        font-size: 12px;
    }

    .validation-summary-errors {
        margin-bottom: 20px;
        padding: 13px 16px;
        color: #a33434;
        background: #fff1f1;
        border: 1px solid #ffd5d5;
        border-radius: 10px;
        font-size: 13px;
        line-height: 1.7;
    }

        .validation-summary-errors ul {
            margin: 5px 0 0;
            padding-left: 20px;
        }

    .validation-summary-valid {
        display: none;
    }

    .error-alert {
        margin-bottom: 18px;
        padding: 13px 16px;
        color: #a33434;
        background: #fff1f1;
        border: 1px solid #ffd5d5;
        border-radius: 10px;
        font-size: 13px;
        line-height: 1.6;
    }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 11px;
        margin-top: 29px;
        padding-top: 22px;
        border-top: 1px solid #edf0f6;
    }

    .btn-save,
    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 0 19px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none !important;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-save {
        color: #fff;
        background: linear-gradient(135deg, #263d83, #4169bd);
        border: 1px solid #31549e;
        box-shadow: 0 4px 10px rgba(49, 84, 158, .15);
    }

        .btn-save:hover {
            color: #fff;
            transform: translateY(-3px);
            box-shadow: 0 7px 15px rgba(49, 84, 158, .22);
        }

    .btn-cancel {
        color: #52627b;
        background: #f2f5fa;
        border: 1px solid #e0e7f1;
    }

        .btn-cancel:hover {
            color: #294b99;
            background: #e9effb;
            transform: translateY(-3px);
        }

    .form-hint {
        display: block;
        margin-top: 7px;
        color: #91a0b4;
        font-size: 11px;
    }

    @@media (max-width: 768px) {
        .create-product-page {
            padding: 5px 0 25px;
        }

        .product-form-card {
            padding: 19px;
        }

        .page-title-row h2 {
            font-size: 22px;
        }

        .page-title-icon {
            width: 45px;
            height: 45px;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-save,
        .btn-cancel {
            width: 100%;
        }
    }
</style>

<div class="create-product-page">

    <div class="product-page-heading">

        <div class="breadcrumb-text">
            Admin / Sản phẩm / <span>Thêm sản phẩm</span>
        </div>

        <div class="page-title-row">
            <div class="page-title-icon">
                <i class="fa fa-plus"></i>
            </div>

            <div>
                <h2>Thêm sản phẩm mới</h2>
                <p>Thêm sách mới vào hệ thống quản lý cửa hàng BookOra.</p>
            </div>
        </div>

    </div>

    <div class="product-form-card">

        <div class="form-card-heading">
            <div class="form-card-icon">
                <i class="fa fa-book"></i>
            </div>

            <div>
                <h3>Thông tin sản phẩm</h3>
                <p>Vui lòng nhập đầy đủ thông tin sản phẩm bên dưới.</p>
            </div>
        </div>

        <div class="required-note">
            <span class="required-star">*</span>
            Các trường thông tin cần được nhập chính xác.
        </div>

        @using (Html.BeginForm(
            "Create",
            "Product",
            new { area = "Admin" },
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @* Hiển thị lỗi từ Controller *@
            if (ViewBag.ValidationErrors != null)
            {
                <div class="error-alert">
                    <i class="fa fa-exclamation-circle"></i>
                    @ViewBag.ValidationErrors
                </div>
            }

            @Html.ValidationSummary(
                     false,
                     "",
                     new { @class = "error-alert" }
                 )

            <div class="form-row">
                @Html.LabelFor(
                         model => model.CategoryID,
                         "Danh mục sản phẩm"
                     )

                @Html.DropDownList(
                         "CategoryID",
                         ViewBag.CategoryID as SelectList,
                         "-- Chọn danh mục sản phẩm --",
                         new { @class = "form-control" }
                     )

                @Html.ValidationMessageFor(
                         model => model.CategoryID,
                         "",
                         new { @class = "field-validation-error" }
                     )
            </div>

            <div class="form-row">
                @Html.LabelFor(
                         model => model.ProductName,
                         "Tên sản phẩm"
                     )

                @Html.TextBoxFor(
                         model => model.ProductName,
                         new
                         {
                             @class = "form-control",
                             placeholder = "Ví dụ: Đắc Nhân Tâm"
                         }
                     )

                @Html.ValidationMessageFor(
                         model => model.ProductName,
                         "",
                         new { @class = "field-validation-error" }
                     )
            </div>

            <div class="form-row">
                @Html.LabelFor(
                         model => model.ProductDecription,
                         "Mô tả sản phẩm"
                     )

                @Html.TextAreaFor(
                         model => model.ProductDecription,
                         new
                         {
                             @class = "form-control",
                             placeholder = "Nhập nội dung giới thiệu sách, tác giả, nhà xuất bản..."
                         }
                     )

                @Html.ValidationMessageFor(
                         model => model.ProductDecription,
                         "",
                         new { @class = "field-validation-error" }
                     )
            </div>

            <div class="form-row">
                @Html.LabelFor(
                         model => model.ProductPrice,
                         "Giá sản phẩm"
                     )

                @Html.TextBoxFor(
                         model => model.ProductPrice,
                         new
                         {
                             @class = "form-control",
                             placeholder = "Ví dụ: 85000",
                             type = "number",
                             step = "any",
                             min = "0"
                         }
                     )

                @Html.ValidationMessageFor(
                         model => model.ProductPrice,
                         "",
                         new { @class = "field-validation-error" }
                     )
            </div>

            <div class="form-row">
                @Html.LabelFor(
                         model => model.ProductImage,
                         "Đường dẫn hình ảnh"
                     )

                @Html.TextBoxFor(
                         model => model.ProductImage,
                         new
                         {
                             @class = "form-control",
                             placeholder = "Ví dụ: ~/Content/Images/dac-nhan-tam.jpg"
                         }
                     )

                <span class="form-hint">
                    Nhập đường dẫn hình ảnh bìa sách đã lưu trong dự án.
                </span>

                @Html.ValidationMessageFor(
                         model => model.ProductImage,
                         "",
                         new { @class = "field-validation-error" }
                     )
            </div>

            <div class="form-actions">

                <button type="submit" class="btn-save">
                    <i class="fa fa-save"></i>
                    Lưu sản phẩm
                </button>

                @Html.ActionLink(
                         "Quay lại danh sách",
                         "Index",
                         "Product",
                         new { area = "Admin" },
                         new { @class = "btn-cancel" }
                     )

            </div>
        }

    </div>
</div>
