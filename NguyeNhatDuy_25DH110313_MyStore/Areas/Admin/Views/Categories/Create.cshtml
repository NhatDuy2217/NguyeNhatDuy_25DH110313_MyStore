
@model NguyeNhatDuy_25DH110313_MyStore.Models.Category

@{
    ViewBag.Title = "Thêm danh mục sách";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .category-page {
        padding: 28px;
        min-height: 100vh;
        background: #f4f7fb;
        color: #243247;
        font-family: Arial, sans-serif;
    }

    .category-heading {
        margin-bottom: 25px;
    }

        .category-heading h2 {
            margin: 0 0 8px;
            font-size: 28px;
            font-weight: 700;
            color: #1e293b;
        }

        .category-heading p {
            margin: 0;
            color: #718096;
            font-size: 14px;
        }

    .category-card {
        max-width: 750px;
        padding: 30px;
        background: #fff;
        border: 1px solid #e5eaf2;
        border-radius: 14px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.05);
    }

        .category-card h3 {
            margin: 0 0 8px;
            font-size: 20px;
            font-weight: 700;
        }

        .category-card .description {
            margin-bottom: 25px;
            color: #718096;
            font-size: 13px;
        }

    .category-field {
        margin-bottom: 24px;
    }

        .category-field label {
            display: block;
            margin-bottom: 9px;
            color: #334155;
            font-size: 14px;
            font-weight: 600;
        }

        .category-field input {
            box-sizing: border-box;
            width: 100%;
            min-height: 44px;
            padding: 11px 13px;
            border: 1px solid #d8e0eb;
            border-radius: 8px;
            font-size: 14px;
        }

            .category-field input:focus {
                outline: none;
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
            }

    .text-danger {
        display: block;
        margin-top: 6px;
        color: #dc2626;
        font-size: 13px;
    }

    .category-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 20px;
        border-top: 1px solid #edf0f5;
    }

        .category-actions .btn {
            padding: 11px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

    .btn-save {
        color: #fff;
        background: #2563eb;
        border: 1px solid #2563eb;
        cursor: pointer;
    }

    .btn-back {
        color: #475569;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

    @@media (max-width: 768px) {
        .category-page {
            padding: 16px;
        }

        .category-card {
            padding: 20px;
        }
    }
</style>

<div class="category-page">
    <div class="category-heading">
        <div style="margin-bottom: 12px; color: #64748b; font-size: 13px;">
            Admin / Danh mục sách / <span style="color: #2563eb;">Thêm danh mục</span>
        </div>

        <h2>Thêm danh mục sách</h2>
        <p>Tạo danh mục để phân loại sách trong cửa hàng MyStore.</p>
    </div>

    <div class="category-card">
        <h3>Thông tin danh mục</h3>
        <p class="description">
            Nhập tên thể loại hoặc nhóm sách bạn muốn quản lý.
        </p>

        @using (Html.BeginForm(
            "Create",
            "Categories",
            new { area = "Admin" },
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" }
            )

            <div class="category-field">
                @Html.LabelFor(
                    model => model.CategoryName,
                    "Tên danh mục sách"
                )

                @Html.TextBoxFor(
                    model => model.CategoryName,
                    new
                    {
                        @class = "form-control",
                        placeholder = "Ví dụ: Văn học, Kinh tế, Kỹ năng sống"
                    }
                )

                @Html.ValidationMessageFor(
                    model => model.CategoryName,
                    "",
                    new { @class = "text-danger" }
                )
            </div>

            <div class="category-actions">
                <button type="submit" class="btn btn-save">
                    + Thêm danh mục
                </button>

                @Html.ActionLink(
                    "Quay lại danh sách",
                    "Index",
                    "Categories",
                    new { area = "Admin" },
                    new { @class = "btn btn-back" }
                )
            </div>
        }
    </div>
</div>
