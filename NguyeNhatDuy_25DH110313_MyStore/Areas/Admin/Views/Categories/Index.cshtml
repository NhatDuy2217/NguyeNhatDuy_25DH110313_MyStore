
@model IEnumerable<NguyeNhatDuy_25DH110313_MyStore.Models.Category>

@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";

    var categories = Model != null
        ? Model.ToList()
        : new List<NguyeNhatDuy_25DH110313_MyStore.Models.Category>();

    int totalCategories = categories.Count;
    int stt = 0;
}

<style>
    .category-page {
        padding: 10px 5px 35px;
        color: #1e293b;
    }

    /* Tiêu đề */
    .category-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .category-title {
        font-size: 27px;
        font-weight: 750;
        color: #172554;
        margin: 0 0 8px;
    }

    .category-subtitle {
        color: #64748b;
        font-size: 14px;
        margin: 0;
    }

    /* Nút thêm danh mục */
    .btn-add-category {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 12px 20px;
        background: linear-gradient(135deg, #1d4ed8, #2563eb);
        color: #fff !important;
        border-radius: 10px;
        text-decoration: none !important;
        font-weight: 600;
        font-size: 14px;
        box-shadow: 0 5px 12px rgba(37, 99, 235, .2);
        transition: all .25s ease;
    }

        .btn-add-category:hover {
            background: linear-gradient(135deg, #1e40af, #1d4ed8);
            transform: translateY(-3px);
            box-shadow: 0 7px 16px rgba(37, 99, 235, .25);
        }

    /* Thống kê */
    .category-summary {
        display: flex;
        align-items: center;
        gap: 18px;
        background: #fff;
        padding: 22px 25px;
        border-radius: 15px;
        border: 1px solid #e8edf5;
        box-shadow: 0 4px 15px rgba(15, 23, 42, .04);
        margin-bottom: 24px;
        max-width: 380px;
    }

    .summary-icon {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient(135deg, #dbeafe, #eff6ff);
        color: #2563eb;
        font-size: 25px;
    }

    .summary-label {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 5px;
    }

    .summary-number {
        font-size: 29px;
        line-height: 1.2;
        font-weight: 750;
        color: #172554;
    }

    /* Khung bảng */
    .category-table-card {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 15px;
        padding: 23px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, .04);
    }

    .table-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

        .table-heading h4 {
            font-size: 17px;
            font-weight: 700;
            color: #172554;
            margin: 0;
        }

    .category-count {
        background: #eff6ff;
        color: #2563eb;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 650;
    }

    /* Bảng danh mục */
    .category-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .category-table {
        width: 100%;
        min-width: 650px;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0;
    }

        .category-table thead th {
            background: #f1f5fb;
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
            padding: 16px 15px;
            border: none;
            white-space: nowrap;
        }

            .category-table thead th:first-child {
                border-radius: 9px 0 0 9px;
            }

            .category-table thead th:last-child {
                border-radius: 0 9px 9px 0;
            }

        .category-table tbody td {
            padding: 17px 15px;
            border-bottom: 1px solid #edf1f7;
            color: #334155;
            font-size: 14px;
            vertical-align: middle;
        }

        .category-table tbody tr:last-child td {
            border-bottom: none;
        }

        .category-table tbody tr {
            transition: background .2s ease;
        }

            .category-table tbody tr:hover {
                background: #f8faff;
            }

    .category-number {
        color: #64748b;
        font-weight: 600;
        text-align: center;
    }

    .category-id {
        display: inline-block;
        background: #f1f5f9;
        color: #475569;
        padding: 6px 11px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
    }

    .category-name {
        color: #172554;
        font-weight: 650;
    }

    /* Nhóm nút chức năng */
    .category-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

    /* Kiểu chung của từng nút */
    .category-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 10px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 650;
        text-decoration: none !important;
        transform: translateY(0) scale(1);
        box-shadow: 0 0 0 rgba(15, 23, 42, 0);
        transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
    }

        /* Hiệu ứng nẩy lên khi rê chuột vào từng nút */
        .category-action:hover {
            transform: translateY(-5px) scale(1.04);
            box-shadow: 0 6px 13px rgba(15, 23, 42, .16);
            position: relative;
            z-index: 2;
        }

        .category-action:active {
            transform: translateY(-1px) scale(.98);
            box-shadow: 0 2px 5px rgba(15, 23, 42, .12);
        }

    /* Nút Chi tiết */
    .action-detail {
        background: #eff6ff;
        color: #2563eb !important;
    }

        .action-detail:hover {
            background: #dbeafe;
        }

    /* Nút Sửa */
    .action-edit {
        background: #fff7ed;
        color: #ea580c !important;
    }

        .action-edit:hover {
            background: #ffedd5;
        }

    /* Nút Xóa */
    .action-delete {
        background: #fef2f2;
        color: #dc2626 !important;
    }

        .action-delete:hover {
            background: #fee2e2;
        }

    /* Khi không có danh mục */
    .category-empty {
        text-align: center;
        padding: 55px 20px !important;
        color: #64748b !important;
    }

        .category-empty i {
            display: block;
            font-size: 42px;
            color: #cbd5e1;
            margin-bottom: 15px;
        }

        .category-empty strong {
            display: block;
            color: #334155;
            font-size: 15px;
            margin-bottom: 7px;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .category-page {
            padding: 5px 0 25px;
        }

        .category-title {
            font-size: 23px;
        }

        .category-summary {
            max-width: 100%;
        }

        .category-table-card {
            padding: 15px;
        }

        .btn-add-category {
            width: 100%;
        }
    }
</style>

<div class="container-fluid category-page">

    <!-- Tiêu đề trang -->
    <div class="category-header">
        <div>
            <h2 class="category-title">Quản lý danh mục</h2>

            <p class="category-subtitle">
                Quản lý và theo dõi các danh mục sách trong cửa hàng BookOra
            </p>
        </div>

        @Html.ActionLink(
                 "＋ Thêm danh mục",
                 "Create",
                 "Categories",
                 new { area = "Admin" },
                 new { @class = "btn-add-category" }
             )
    </div>

    <!-- Thống kê tổng số danh mục -->
    <div class="category-summary">
        <div class="summary-icon">
            <i class="fa fa-book"></i>
        </div>

        <div>
            <div class="summary-label">Tổng số danh mục</div>
            <div class="summary-number">@totalCategories</div>
        </div>
    </div>

    <!-- Bảng danh mục -->
    <div class="category-table-card">

        <div class="table-heading">
            <h4>
                <i class="fa fa-folder-open"
                   style="color: #2563eb; margin-right: 8px;"></i>
                Danh sách danh mục
            </h4>

            <span class="category-count">
                @totalCategories danh mục
            </span>
        </div>

        <div class="category-table-wrapper">
            <table class="category-table">

                <thead>
                    <tr>
                        <th style="width: 90px; text-align: center;">
                            STT
                        </th>

                        <th style="width: 150px;">
                            Mã danh mục
                        </th>

                        <th>
                            Tên danh mục
                        </th>

                        <th style="width: 250px; text-align: center;">
                            Chức năng
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @if (categories.Any())
                    {
                        foreach (var item in categories)
                        {
                            stt++;

                            <tr class="category-row">
                                <td class="category-number">
                                    @stt
                                </td>

                                <td>
                                    <span class="category-id">
                                        #@item.CategoryID
                                    </span>
                                </td>

                                <td>
                                    <span class="category-name">
                                        @item.CategoryName
                                    </span>
                                </td>

                                <td>
                                    <div class="category-actions">

                                        @Html.ActionLink(
                                                 "Chi tiết",
                                                 "Details",
                                                 new { id = item.CategoryID },
                                                 new { @class = "category-action action-detail" }
                                             )

                                        @Html.ActionLink(
                                                 "Sửa",
                                                 "Edit",
                                                 new { id = item.CategoryID },
                                                 new { @class = "category-action action-edit" }
                                             )

                                        @Html.ActionLink(
                                                 "Xóa",
                                                 "Delete",
                                                 new { id = item.CategoryID },
                                                 new { @class = "category-action action-delete" }
                                             )

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="category-empty">
                                <i class="fa fa-folder-open-o"></i>

                                <strong>Chưa có danh mục nào</strong>

                                Hãy nhấn nút "Thêm danh mục" để tạo danh mục mới.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>
