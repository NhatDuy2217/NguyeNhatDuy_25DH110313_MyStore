
@model NguyeNhatDuy_25DH110313_MyStore.Models.Category

@{
    ViewBag.Title = "Sửa danh mục sách";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .category-edit-page {
        padding: 10px 5px 35px;
        color: #1e293b;
        min-height: 80vh;
    }

    /* Tiêu đề */
    .category-heading {
        margin-bottom: 25px;
    }

    .category-breadcrumb {
        font-size: 13px;
        color: #94a3b8;
        margin-bottom: 12px;
    }

        .category-breadcrumb span {
            color: #2563eb;
            font-weight: 600;
        }

    .category-heading h2 {
        margin: 0 0 8px;
        font-size: 27px;
        font-weight: 750;
        color: #172554;
    }

    .category-heading p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }

    /* Khung form */
    .category-edit-card {
        max-width: 800px;
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, .04);
    }

    .category-card-heading {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 22px;
        margin-bottom: 25px;
        border-bottom: 1px solid #edf1f7;
    }

    .category-card-icon {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: linear-gradient(135deg, #f59e0b, #ea580c);
        color: #fff;
        font-size: 22px;
        box-shadow: 0 5px 12px rgba(234, 88, 12, .18);
    }

    .category-card-heading h3 {
        margin: 0 0 6px;
        color: #172554;
        font-size: 19px;
        font-weight: 700;
    }

    .category-card-heading p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
    }

    /* Mã danh mục */
    .category-id-box {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 15px;
        margin-bottom: 24px;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
    }

    .category-id-label {
        color: #64748b;
        font-size: 13px;
    }

    .category-id-value {
        display: inline-block;
        padding: 5px 11px;
        background: #dbeafe;
        color: #1d4ed8;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
    }

    /* Trường nhập */
    .category-field {
        margin-bottom: 25px;
    }

        .category-field label {
            display: block;
            margin-bottom: 10px;
            color: #334155;
            font-size: 14px;
            font-weight: 650;
        }

    .required-mark {
        color: #dc2626;
        margin-left: 3px;
    }

    .category-input {
        box-sizing: border-box;
        width: 100%;
        min-height: 48px;
        padding: 12px 15px;
        border: 1px solid #dbe3ef;
        border-radius: 9px;
        background: #fff;
        color: #1e293b;
        font-size: 14px;
        transition: all .25s ease;
    }

        .category-input::placeholder {
            color: #a0aec0;
        }

        .category-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, .10);
        }

    .field-hint {
        display: block;
        margin-top: 8px;
        color: #94a3b8;
        font-size: 12px;
    }

    /* Thông báo lỗi */
    .text-danger {
        display: block;
        margin-top: 7px;
        color: #dc2626;
        font-size: 13px;
    }

    .validation-summary-errors {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 9px;
        padding: 12px 16px;
        margin-bottom: 20px;
        color: #b91c1c;
        font-size: 13px;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }

    /* Nhóm nút */
    .category-form-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 22px;
        border-top: 1px solid #edf1f7;
    }

    .category-form-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 11px 20px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 650;
        text-decoration: none !important;
        cursor: pointer;
        transition: all .25s ease;
    }

        .category-form-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 13px rgba(15, 23, 42, .15);
        }

        .category-form-btn:active {
            transform: translateY(-1px);
        }

    .btn-save-category {
        background: linear-gradient(135deg, #ea580c, #f59e0b);
        color: #fff !important;
        border: 1px solid #ea580c;
        box-shadow: 0 4px 10px rgba(234, 88, 12, .15);
    }

        .btn-save-category:hover {
            background: linear-gradient(135deg, #c2410c, #ea580c);
        }

    .btn-back-category {
        background: #f1f5f9;
        color: #475569 !important;
        border: 1px solid #e2e8f0;
    }

        .btn-back-category:hover {
            background: #e2e8f0;
        }

    @@media (max-width: 768px) {
        .category-edit-page {
            padding: 5px 0 25px;
        }

        .category-heading h2 {
            font-size: 23px;
        }

        .category-edit-card {
            padding: 20px;
        }

        .category-form-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .category-form-btn {
            width: 100%;
            box-sizing: border-box;
        }
    }
</style>

<div class="container-fluid category-edit-page">

    <!-- Tiêu đề trang -->
    <div class="category-heading">

        <div class="category-breadcrumb">
            BookOra / Trang quản trị / Quản lý danh mục /
            <span>Sửa danh mục</span>
        </div>

        <h2>Sửa danh mục sách</h2>

        <p>
            Cập nhật thông tin danh mục để quản lý các đầu sách trong cửa hàng BookOra.
        </p>

    </div>

    <!-- Form sửa danh mục -->
    <div class="category-edit-card">

        <div class="category-card-heading">

            <div class="category-card-icon">
                <i class="fa fa-pencil"></i>
            </div>

            <div>
                <h3>Thông tin danh mục</h3>
                <p>Chỉnh sửa thông tin danh mục sách bên dưới.</p>
            </div>

        </div>

        @using (Html.BeginForm(
            "Edit",
            "Categories",
            new { area = "Admin" },
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(model => model.CategoryID)

            @Html.ValidationSummary(
                     true,
                     "",
                     new { @class = "text-danger" }
                 )

            <!-- Mã danh mục -->
            <div class="category-id-box">

                <span class="category-id-label">
                    <i class="fa fa-tag"></i>
                    Mã danh mục:
                </span>

                <span class="category-id-value">
                    #@Model.CategoryID
                </span>

            </div>

            <!-- Tên danh mục -->
            <div class="category-field">

                @Html.LabelFor(
                         model => model.CategoryName,
                         "Tên danh mục sách"
                     )

                <span class="required-mark">*</span>

                @Html.TextBoxFor(
                         model => model.CategoryName,
                         new
                         {
                             @class = "category-input",
                             placeholder = "Ví dụ: Văn học, Ngoại ngữ, Kỹ năng sống",
                             autocomplete = "off"
                         }
                     )

                @Html.ValidationMessageFor(
                         model => model.CategoryName,
                         "",
                         new { @class = "text-danger" }
                     )

                <span class="field-hint">
                    <i class="fa fa-info-circle"></i>
                    Hãy nhập tên danh mục mới mà bạn muốn cập nhật.
                </span>

            </div>

            <!-- Nút chức năng -->
            <div class="category-form-actions">

                <button type="submit"
                        class="category-form-btn btn-save-category">
                    <i class="fa fa-save"></i>
                    Lưu thay đổi
                </button>

                @Html.ActionLink(
                         "Quay lại danh sách",
                         "Index",
                         "Categories",
                         new { area = "Admin" },
                         new
                         {
                             @class = "category-form-btn btn-back-category"
                         }
                     )

            </div>
        }

    </div>

</div>
