
@model NguyeNhatDuy_25DH110313_MyStore.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục sách";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .category-page {
        padding: 25px;
    }

    .category-heading {
        margin-bottom: 25px;
    }

        .category-heading h2 {
            font-size: 26px;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .category-heading p {
            color: #7f8c8d;
            margin: 0;
        }

    .category-card {
        background: #fff;
        border-radius: 10px;
        padding: 30px;
        max-width: 750px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    }

    .category-info {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 18px 0;
        border-bottom: 1px solid #ecf0f1;
    }

    .category-label {
        color: #7f8c8d;
        font-size: 14px;
    }

    .category-value {
        color: #2c3e50;
        font-size: 17px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .category-actions {
        display: flex;
        gap: 12px;
        margin-top: 25px;
        flex-wrap: wrap;
    }

    .btn-edit-category {
        background: #2980b9;
        color: white;
        padding: 11px 20px;
        border-radius: 6px;
        text-decoration: none;
    }

        .btn-edit-category:hover {
            background: #216a9b;
            color: white;
            text-decoration: none;
        }

    .btn-back-category {
        background: #ecf0f1;
        color: #34495e;
        padding: 11px 20px;
        border-radius: 6px;
        text-decoration: none;
    }

        .btn-back-category:hover {
            background: #dfe6e9;
            color: #2c3e50;
            text-decoration: none;
        }

    @@media (max-width: 600px) {
        .category-page {
            padding: 15px;
        }

        .category-card {
            padding: 20px;
        }
    }
</style>

<div class="category-page">

    <div class="category-heading">
        <h2>Chi tiết danh mục sách</h2>
        <p>Xem thông tin danh mục trong cửa hàng sách.</p>
    </div>

    <div class="category-card">

        <div class="category-info">
            <span class="category-label">Mã danh mục</span>
            <span class="category-value">@Model.CategoryID</span>
        </div>

        <div class="category-info">
            <span class="category-label">Tên danh mục sách</span>
            <span class="category-value">@Model.CategoryName</span>
        </div>

        <div class="category-actions">
            @Html.ActionLink(
                "Chỉnh sửa",
                "Edit",
                "Categories",
                new { id = Model.CategoryID, area = "Admin" },
                new { @class = "btn-edit-category" }
            )

            @Html.ActionLink(
                "Quay lại danh sách",
                "Index",
                "Categories",
                new { area = "Admin" },
                new { @class = "btn-back-category" }
            )
        </div>

    </div>
</div>
