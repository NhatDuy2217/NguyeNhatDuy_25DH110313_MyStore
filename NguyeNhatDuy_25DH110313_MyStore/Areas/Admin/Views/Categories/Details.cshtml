
@model NguyeNhatDuy_25DH110313_MyStore.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục sách";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .category-details-page {
        padding: 10px 5px 35px;
        color: #1e293b;
        min-height: 80vh;
    }

    /* Tiêu đề */
    .category-heading {
        margin-bottom: 25px;
    }

    .category-breadcrumb {
        font-size: 13px;
        color: #94a3b8;
        margin-bottom: 12px;
    }

        .category-breadcrumb span {
            color: #2563eb;
            font-weight: 600;
        }

    .category-heading h2 {
        margin: 0 0 8px;
        font-size: 27px;
        font-weight: 750;
        color: #172554;
    }

    .category-heading p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }

    /* Khung thông tin */
    .category-details-card {
        max-width: 800px;
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, .04);
    }

    .category-card-heading {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 22px;
        margin-bottom: 15px;
        border-bottom: 1px solid #edf1f7;
    }

    .category-card-icon {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: linear-gradient(135deg, #2563eb, #1e40af);
        color: #fff;
        font-size: 22px;
        box-shadow: 0 5px 12px rgba(37, 99, 235, .2);
    }

    .category-card-heading h3 {
        margin: 0 0 6px;
        color: #172554;
        font-size: 19px;
        font-weight: 700;
    }

    .category-card-heading p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
    }

    /* Nội dung thông tin */
    .category-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 5px;
        border-bottom: 1px solid #edf1f7;
    }

        .category-info:last-of-type {
            border-bottom: none;
        }

    .category-info-label {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #64748b;
        font-size: 14px;
        font-weight: 600;
    }

        .category-info-label i {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: #eff6ff;
            color: #2563eb;
            font-size: 14px;
        }

    .category-info-value {
        color: #172554;
        font-size: 15px;
        font-weight: 700;
        text-align: right;
        overflow-wrap: anywhere;
    }

    .category-id-value {
        display: inline-block;
        padding: 7px 13px;
        background: #eff6ff;
        color: #2563eb;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
    }

    .category-name-value {
        color: #172554;
        font-size: 16px;
        font-weight: 700;
    }

    /* Nhóm nút */
    .category-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 25px;
        margin-top: 10px;
        border-top: 1px solid #edf1f7;
    }

    .category-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 11px 20px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 650;
        text-decoration: none !important;
        transition: all .25s ease;
    }

        .category-action-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 13px rgba(15, 23, 42, .15);
        }

        .category-action-btn:active {
            transform: translateY(-1px);
        }

    /* Nút chỉnh sửa */
    .btn-edit-category {
        background: linear-gradient(135deg, #1d4ed8, #2563eb);
        color: #fff !important;
        border: 1px solid #2563eb;
        box-shadow: 0 4px 10px rgba(37, 99, 235, .15);
    }

        .btn-edit-category:hover {
            background: linear-gradient(135deg, #1e40af, #1d4ed8);
        }

    /* Nút quay lại */
    .btn-back-category {
        background: #f1f5f9;
        color: #475569 !important;
        border: 1px solid #e2e8f0;
    }

        .btn-back-category:hover {
            background: #e2e8f0;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .category-details-page {
            padding: 5px 0 25px;
        }

        .category-heading h2 {
            font-size: 23px;
        }

        .category-details-card {
            padding: 20px;
        }

        .category-info {
            align-items: flex-start;
            flex-direction: column;
            gap: 12px;
        }

        .category-info-value {
            padding-left: 42px;
            text-align: left;
        }

        .category-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .category-action-btn {
            width: 100%;
            box-sizing: border-box;
        }
    }
</style>

<div class="container-fluid category-details-page">

    <!-- Tiêu đề trang -->
    <div class="category-heading">

        <div class="category-breadcrumb">
            BookOra / Trang quản trị / Quản lý danh mục /
            <span>Chi tiết danh mục</span>
        </div>

        <h2>Chi tiết danh mục sách</h2>

        <p>
            Xem thông tin chi tiết danh mục sách trong cửa hàng BookOra.
        </p>

    </div>

    <!-- Khung thông tin danh mục -->
    <div class="category-details-card">

        <div class="category-card-heading">

            <div class="category-card-icon">
                <i class="fa fa-book"></i>
            </div>

            <div>
                <h3>Thông tin danh mục</h3>
                <p>Thông tin chi tiết của danh mục đang được chọn.</p>
            </div>

        </div>

        <!-- Mã danh mục -->
        <div class="category-info">

            <div class="category-info-label">
                <i class="fa fa-tag"></i>
                Mã danh mục
            </div>

            <div class="category-info-value">
                <span class="category-id-value">
                    #@Model.CategoryID
                </span>
            </div>

        </div>

        <!-- Tên danh mục -->
        <div class="category-info">

            <div class="category-info-label">
                <i class="fa fa-folder-open"></i>
                Tên danh mục sách
            </div>

            <div class="category-info-value category-name-value">
                @Model.CategoryName
            </div>

        </div>

        <!-- Nút chức năng -->
        <div class="category-actions">

            @Html.ActionLink(
                     "Chỉnh sửa",
                     "Edit",
                     "Categories",
                     new { id = Model.CategoryID, area = "Admin" },
                     new { @class = "category-action-btn btn-edit-category" }
                 )

            @Html.ActionLink(
                     "Quay lại danh sách",
                     "Index",
                     "Categories",
                     new { area = "Admin" },
                     new { @class = "category-action-btn btn-back-category" }
                 )

        </div>

    </div>

</div>
