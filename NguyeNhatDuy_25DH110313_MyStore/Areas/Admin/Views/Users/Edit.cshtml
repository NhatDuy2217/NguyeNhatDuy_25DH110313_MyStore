
@model NguyeNhatDuy_25DH110313_MyStore.Models.User

@{
    ViewBag.Title = "Chỉnh sửa tài khoản";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .user-edit-page {
        min-height: 100vh;
        padding: 35px 20px;
        background: #f5f7fb;
    }

    .user-edit-header {
        text-align: center;
        margin-bottom: 28px;
    }

        .user-edit-header h2 {
            color: #243247;
            font-size: 27px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .user-edit-header p {
            color: #8492a6;
            font-size: 14px;
            margin: 0;
        }

    .user-edit-container {
        max-width: 620px;
        margin: 0 auto;
    }

    .user-edit-card {
        max-width: 550px;
        margin: 0 auto;
        padding: 30px 38px;
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 16px;
        box-shadow: 0 6px 24px rgba(30, 50, 80, 0.07);
    }

    .edit-avatar {
        width: 78px;
        height: 78px;
        margin: 0 auto 14px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e8efff, #d7e3ff);
        color: #3867d6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        font-weight: 700;
        border: 4px solid #f4f7ff;
    }

    .edit-username {
        text-align: center;
        color: #243247;
        font-size: 21px;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .edit-subtitle {
        text-align: center;
        color: #98a3b3;
        font-size: 13px;
        margin-top: -18px;
        margin-bottom: 25px;
    }

    .edit-form-group {
        margin-bottom: 17px;
        padding: 14px 17px;
        background: #f7f9fc;
        border: 1px solid #edf0f5;
        border-radius: 10px;
    }

        .edit-form-group > label {
            display: block;
            color: #8492a6;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 8px;
        }

    .edit-input {
        display: block;
        width: 100%;
        height: 40px;
        padding: 8px 12px;
        color: #243247;
        background: #fff;
        border: 1px solid #dfe5ee;
        border-radius: 7px;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .edit-input:focus {
            border-color: #3867d6;
            box-shadow: 0 0 0 3px rgba(56, 103, 214, 0.10);
        }

        .edit-input[readonly] {
            background: #edf0f5;
            color: #8492a6;
            cursor: not-allowed;
        }

    /* Khung mật khẩu */
    .password-wrapper {
        position: relative;
    }

        .password-wrapper .edit-input {
            padding-right: 48px;
        }

    /* Nút con mắt */
    .password-eye {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        cursor: pointer;
        font-size: 18px;
        color: #8492a6;
        padding: 0;
    }

        .password-eye:hover {
            color: #3867d6;
        }

    .field-validation-error {
        display: block;
        color: #dc3545;
        font-size: 12px;
        margin-top: 6px;
    }

    .validation-summary-errors {
        color: #dc3545;
        background: #fff1f1;
        border: 1px solid #ffdada;
        border-radius: 8px;
        padding: 12px 15px;
        margin-bottom: 18px;
        font-size: 13px;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }

    .edit-actions {
        display: flex;
        justify-content: center;
        gap: 13px;
        margin-top: 27px;
    }

    .btn-save,
    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 140px;
        padding: 11px 20px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-save {
        background: #3867d6;
        color: #fff;
    }

        .btn-save:hover {
            background: #2853bb;
            color: #fff;
            transform: translateY(-2px);
        }

    .btn-back {
        background: #f0f2f6;
        color: #536174;
    }

        .btn-back:hover {
            background: #e1e6ef;
            color: #243247;
            text-decoration: none;
            transform: translateY(-2px);
        }

    @@media (max-width: 576px) {
        .user-edit-page {
            padding: 25px 12px;
        }

        .user-edit-card {
            padding: 25px 20px;
        }

        .user-edit-header h2 {
            font-size: 23px;
        }

        .edit-actions {
            flex-direction: column;
        }

        .btn-save,
        .btn-back {
            width: 100%;
        }
    }
</style>

<div class="user-edit-page">

    <div class="user-edit-header">
        <h2>Chỉnh sửa tài khoản</h2>
        <p>Cập nhật thông tin tài khoản trong hệ thống.</p>
    </div>

    <div class="user-edit-container">

        <div class="user-edit-card">

            @using (Html.BeginForm("Edit", "Users", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.Username)

                <!-- Avatar -->
                <div class="edit-avatar">
                    @(string.IsNullOrEmpty(Model.Username)
                        ? "U"
                        : Model.Username.Substring(0, 1).ToUpper())
                </div>

                <div class="edit-username">
                    @Model.Username
                </div>

                <div class="edit-subtitle">
                    Thông tin tài khoản người dùng
                </div>

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <!-- Username -->
                <div class="edit-form-group">
                    <label>Tên đăng nhập</label>

                    @Html.TextBoxFor(model => model.Username, new
                    {
                        @class = "edit-input",
                        @readonly = "readonly"
                    })
                </div>

                <!-- Password -->
                <div class="edit-form-group">
                    <label>Mật khẩu</label>

                    <div class="password-wrapper">

                        @Html.TextBoxFor(model => model.Password, new
                        {
                            @class = "edit-input",
                            type = "password",
                            id = "Password",
                            autocomplete = "off"
                        })

                        <button type="button"
                                id="btnShowPassword"
                                class="password-eye"
                                title="Hiện mật khẩu"
                                onclick="togglePassword()">
                            👁
                        </button>

                    </div>

                    @Html.ValidationMessageFor(
                        model => model.Password,
                        "",
                        new { @class = "field-validation-error" }
                    )
                </div>

                <!-- UserRole -->
                <div class="edit-form-group">
                    <label>Vai trò tài khoản</label>

                    @Html.DropDownListFor(
                        model => model.UserRole,
                        new SelectList(
                            new[]
                            {
                                new { Value = "Admin", Text = "Admin" },
                                new { Value = "Customer", Text = "Customer" }
                            },
                            "Value",
                            "Text",
                            Model.UserRole
                        ),
                        "-- Chọn vai trò tài khoản --",
                        new { @class = "edit-input" }
                    )

                    @Html.ValidationMessageFor(
                        model => model.UserRole,
                        "",
                        new { @class = "field-validation-error" }
                    )
                </div>

                <!-- Nút chức năng -->
                <div class="edit-actions">

                    <button type="submit" class="btn-save">
                        Lưu thay đổi
                    </button>

                    @Html.ActionLink(
                        "Quay lại",
                        "Index",
                        null,
                        new { @class = "btn-back" }
                    )

                </div>
            }

        </div>
    </div>
</div>

<script>
        function togglePassword() {
            var passwordInput = document.getElementById("Password");
            var eyeButton = document.getElementById("btnShowPassword");

            if (!(passwordInput instanceof HTMLInputElement) ||
                !(eyeButton instanceof HTMLButtonElement)) {
                return;
            }

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                eyeButton.textContent = "🙈";
                eyeButton.title = "Ẩn mật khẩu";
            } else {
                passwordInput.type = "password";
                eyeButton.textContent = "👁";
                eyeButton.title = "Hiện mật khẩu";
            }
        }
</script>
