
@model NguyeNhatDuy_25DH110313_MyStore.Models.User

@{
    ViewBag.Title = "Chỉnh sửa tài khoản";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";

    string username = string.IsNullOrWhiteSpace(Model.Username)
        ? "U"
        : Model.Username.Trim();

    string avatarLetter = username.Substring(0, 1).ToUpper();
}

<style>
    .user-edit-page {
        min-height: 100vh;
        padding: 35px 20px 55px;
        background: #f4f6fb;
    }

    .user-edit-header {
        max-width: 1050px;
        margin: 0 auto 28px;
    }

    .user-edit-breadcrumb {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
        margin-bottom: 17px;
        color: #8995a8;
        font-size: 13px;
    }

        .user-edit-breadcrumb a {
            color: #526b91;
            text-decoration: none;
        }

            .user-edit-breadcrumb a:hover {
                color: #315fc2;
            }

    .user-edit-heading {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .user-edit-heading-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        color: #fff;
        font-size: 23px;
        background: linear-gradient(135deg, #263f70, #4778d5);
        box-shadow: 0 6px 16px rgba(49, 95, 194, 0.2);
    }

    .user-edit-heading h2 {
        margin: 0 0 5px;
        color: #243653;
        font-size: 25px;
        font-weight: 750;
    }

    .user-edit-heading p {
        margin: 0;
        color: #8995a8;
        font-size: 14px;
    }

    .user-edit-container {
        max-width: 1050px;
        margin: 0 auto;
    }

    .user-edit-card {
        max-width: 650px;
        margin: 0 auto;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e9edf5;
        border-radius: 18px;
        box-shadow: 0 8px 28px rgba(35, 54, 83, 0.07);
    }

    .edit-card-top {
        padding: 30px 35px 25px;
        text-align: center;
        border-bottom: 1px solid #edf0f5;
        background: linear-gradient(135deg, #f8faff, #eef3ff);
    }

    .edit-avatar {
        width: 88px;
        height: 88px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        border: 5px solid #fff;
        border-radius: 50%;
        background: linear-gradient(135deg, #29477e, #5685e0);
        color: #fff;
        font-size: 34px;
        font-weight: 750;
        box-shadow: 0 5px 18px rgba(49, 95, 194, 0.2);
    }

    .edit-username {
        margin: 0 0 8px;
        color: #243653;
        font-size: 22px;
        font-weight: 750;
        word-break: break-word;
    }

    .edit-subtitle {
        margin: 0;
        color: #8995a8;
        font-size: 13px;
    }

    .edit-form-content {
        padding: 28px 35px 32px;
    }

    .edit-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        color: #304568;
        font-size: 15px;
        font-weight: 700;
    }

        .edit-section-title i {
            color: #4778d5;
            font-size: 17px;
        }

    .edit-form-group {
        margin-bottom: 18px;
    }

        .edit-form-group > label {
            display: block;
            margin-bottom: 9px;
            color: #52627a;
            font-size: 13px;
            font-weight: 700;
        }

    .edit-input {
        display: block;
        width: 100%;
        height: 46px;
        padding: 10px 14px;
        color: #293d5c;
        background: #f8faff;
        border: 1px solid #e1e7f0;
        border-radius: 9px;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .edit-input:focus {
            background: #fff;
            border-color: #4778d5;
            box-shadow: 0 0 0 3px rgba(56, 103, 214, 0.1);
        }

    /* Khung chứa ô mật khẩu và nút con mắt */
    .edit-password-wrapper {
        position: relative;
        display: block;
        width: 100%;
    }

    .edit-password-input {
        display: block;
        width: 100%;
        height: 46px;
        padding: 10px 48px 10px 14px;
        color: #293d5c;
        background: #f8faff;
        border: 1px solid #e1e7f0;
        border-radius: 9px;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .edit-password-input:focus {
            background: #fff;
            border-color: #4778d5;
            box-shadow: 0 0 0 3px rgba(56, 103, 214, 0.1);
        }

    /* Nút con mắt */
    .edit-password-eye {
        position: absolute;
        top: 50%;
        right: 7px;
        z-index: 10;
        width: 36px;
        height: 36px;
        padding: 0;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: translateY(-50%);
        border: none;
        border-radius: 7px;
        background: #edf2fc;
        color: #315fc2;
        font-size: 21px;
        line-height: 1;
        cursor: pointer;
        visibility: visible;
        opacity: 1;
    }

        .edit-password-eye:hover {
            background: #dce7ff;
            color: #244fa9;
        }

        .edit-password-eye:focus {
            outline: none;
        }

    .edit-hint {
        display: block;
        margin-top: 7px;
        color: #8995a8;
        font-size: 12px;
        line-height: 1.5;
    }

    .field-validation-error {
        display: block;
        margin-top: 7px;
        color: #dc3545;
        font-size: 12px;
    }

    .validation-summary-errors {
        margin-bottom: 20px;
        padding: 13px 16px;
        color: #bd3542;
        background: #fff1f2;
        border: 1px solid #ffd9dd;
        border-radius: 9px;
        font-size: 13px;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }

    .edit-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        padding-top: 23px;
        margin-top: 25px;
        border-top: 1px solid #edf0f5;
    }

    .btn-save,
    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 160px;
        padding: 12px 20px;
        border: none;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-save {
        background: linear-gradient(135deg, #315fc2, #4778d5);
        color: #fff;
        box-shadow: 0 4px 12px rgba(49, 95, 194, 0.16);
    }

        .btn-save:hover {
            color: #fff;
            transform: translateY(-3px);
            box-shadow: 0 7px 16px rgba(49, 95, 194, 0.23);
        }

    .btn-back {
        background: #edf1f7;
        color: #52627a;
    }

        .btn-back:hover {
            background: #e1e8f3;
            color: #293d5c;
            text-decoration: none;
            transform: translateY(-3px);
        }

    @@media (max-width: 576px) {
        .user-edit-page {
            padding: 25px 12px 40px;
        }

        .user-edit-heading h2 {
            font-size: 21px;
        }

        .edit-card-top {
            padding: 25px 18px 22px;
        }

        .edit-form-content {
            padding: 23px 18px 25px;
        }

        .edit-actions {
            flex-direction: column;
        }

        .btn-save,
        .btn-back {
            width: 100%;
        }
    }
</style>

<div class="user-edit-page">

    <div class="user-edit-header">

        <div class="user-edit-breadcrumb">

            <a href="@Url.Action("Index", "Home", new { area = "Admin" })">
                <i class="fa fa-home"></i> Tổng quan
            </a>

            <i class="fa fa-angle-right"></i>

            <a href="@Url.Action("Index", "Users", new { area = "Admin" })">
                Quản lý tài khoản
            </a>

            <i class="fa fa-angle-right"></i>

            <span>Chỉnh sửa tài khoản</span>

        </div>

        <div class="user-edit-heading">

            <div class="user-edit-heading-icon">
                <i class="fa fa-user"></i>
            </div>

            <div>
                <h2>Chỉnh sửa tài khoản</h2>
                <p>Cập nhật thông tin tài khoản trong hệ thống BookOra.</p>
            </div>

        </div>

    </div>

    <div class="user-edit-container">

        <div class="user-edit-card">

            <div class="edit-card-top">

                <div class="edit-avatar">
                    @avatarLetter
                </div>

                <h3 class="edit-username">
                    @username
                </h3>

                <p class="edit-subtitle">
                    Thông tin tài khoản người dùng
                </p>

            </div>

            @using (Html.BeginForm("Edit", "Users", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @* Lưu tên đăng nhập ban đầu để Controller tìm đúng tài khoản *@
                <input type="hidden"
                       name="oldUsername"
                       value="@Model.Username" />

                <div class="edit-form-content">

                    <div class="edit-section-title">
                        <i class="fa fa-id-card"></i>
                        Thông tin tài khoản
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="edit-form-group">

                        <label for="Username">Tên đăng nhập</label>

                        @Html.TextBoxFor(model => model.Username, new
                        {
                            @class = "edit-input",
                            placeholder = "Nhập tên đăng nhập",
                            autocomplete = "username"
                        })

                        @Html.ValidationMessageFor(
                                 model => model.Username,
                                 "",
                                 new { @class = "field-validation-error" }
                             )

                        <small class="edit-hint">
                            Bạn có thể thay đổi tên đăng nhập của tài khoản.
                        </small>

                    </div>

                    <div class="edit-form-group">

                        <label for="Password">Mật khẩu</label>

                        <div class="edit-password-wrapper">

                            @Html.TextBoxFor(model => model.Password, new
                            {
                                @class = "edit-password-input",
                                type = "password",
                                id = "Password",
                                autocomplete = "off"
                            })

                            <button type="button"
                                    id="btnShowPassword"
                                    class="edit-password-eye"
                                    onclick="togglePasswordVisibility()"
                                    title="Hiện mật khẩu"
                                    aria-label="Hiện mật khẩu">
                                &#128065;
                            </button>

                        </div>

                        @Html.ValidationMessageFor(
                                 model => model.Password,
                                 "",
                                 new { @class = "field-validation-error" }
                             )

                        <small class="edit-hint">
                            Bấm biểu tượng con mắt để xem mật khẩu hiện tại.
                            Bạn có thể xóa mật khẩu cũ và nhập mật khẩu mới.
                        </small>

                    </div>

                    <div class="edit-form-group">

                        <label for="UserRole">Vai trò tài khoản</label>

                        @Html.DropDownListFor(
                                 model => model.UserRole,
                                 new SelectList(
                                     new[]
                                     {
                                    new { Value = "Admin", Text = "Admin" },
                                    new { Value = "Customer", Text = "Customer" }
                             },
                                     "Value",
                                     "Text",
                                     Model.UserRole
                                 ),
                                 "-- Chọn vai trò tài khoản --",
                                 new { @class = "edit-input" }
                             )

                        @Html.ValidationMessageFor(
                                 model => model.UserRole,
                                 "",
                                 new { @class = "field-validation-error" }
                             )

                    </div>

                    <div class="edit-actions">

                        <button type="submit" class="btn-save">
                            <i class="fa fa-save"></i>
                            Lưu thay đổi
                        </button>

                        @Html.ActionLink(
                                 "Quay lại",
                                 "Index",
                                 null,
                                 new { @class = "btn-back" }
                             )

                    </div>

                </div>
            }

        </div>

    </div>

</div>

<script>
        function togglePasswordVisibility() {
            var passwordInput = document.getElementById("Password");
            var eyeButton = document.getElementById("btnShowPassword");

            if (passwordInput == null || eyeButton == null) {
                return;
            }

            var currentType = passwordInput.getAttribute("type");

            if (currentType === "password") {
                passwordInput.setAttribute("type", "text");
                eyeButton.innerHTML = "&#128064;";
                eyeButton.setAttribute("title", "Ẩn mật khẩu");
                eyeButton.setAttribute("aria-label", "Ẩn mật khẩu");
            } else {
                passwordInput.setAttribute("type", "password");
                eyeButton.innerHTML = "&#128065;";
                eyeButton.setAttribute("title", "Hiện mật khẩu");
                eyeButton.setAttribute("aria-label", "Hiện mật khẩu");
            }
        }
</script>
