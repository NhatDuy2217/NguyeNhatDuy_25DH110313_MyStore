
@model IEnumerable<NguyeNhatDuy_25DH110313_MyStore.Models.User>

@{
    ViewBag.Title = "Quản lý tài khoản";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";

    int currentPage = ViewBag.CurrentPage == null ? 1 : (int)ViewBag.CurrentPage;
    int pageSize = ViewBag.PageSize == null ? 10 : (int)ViewBag.PageSize;
    int totalPages = ViewBag.TotalPages == null ? 1 : (int)ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems == null ? 0 : (int)ViewBag.TotalItems;

    if (currentPage < 1) { currentPage = 1; }
    if (pageSize < 1) { pageSize = 10; }
    if (totalPages < 1) { totalPages = 1; }
}

<style>
    .users-page {
        min-height: 100vh;
        padding: 30px;
        background: #f4f7fb;
        color: #243247;
        font-family: Arial, sans-serif;
    }

    .users-container {
        max-width: 1250px;
        margin: 0 auto;
    }

    .users-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 25px;
    }

    .breadcrumb-text {
        margin-bottom: 10px;
        color: #64748b;
        font-size: 13px;
    }

        .breadcrumb-text span {
            color: #2563eb;
            font-weight: 600;
        }

    .users-title h2 {
        margin: 0 0 8px;
        color: #172554;
        font-size: 28px;
        font-weight: 700;
    }

    .users-title p {
        margin: 0;
        color: #8492a6;
        font-size: 14px;
    }

    .btn-create {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 44px;
        padding: 0 20px;
        color: #fff !important;
        background: #2563eb;
        border: 1px solid #2563eb;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none !important;
        transition: all 0.2s ease;
    }

        .btn-create:hover {
            color: #fff;
            background: #1d4ed8;
            border-color: #1d4ed8;
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(37, 99, 235, 0.2);
        }

    .users-card {
        padding: 25px;
        background: #fff;
        border: 1px solid #e5eaf2;
        border-radius: 15px;
        box-shadow: 0 6px 22px rgba(15, 23, 42, 0.04);
    }

    .users-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 23px;
    }

    .search-form {
        display: flex;
        flex: 1;
        max-width: 600px;
        gap: 9px;
    }

    .search-input {
        flex: 1;
        min-width: 150px;
        height: 43px;
        padding: 0 14px;
        color: #334155;
        background: #fff;
        border: 1px solid #dce2eb;
        border-radius: 8px;
        outline: none;
        font-size: 14px;
        transition: border-color 0.2s;
    }

        .search-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
        }

    .btn-search {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 18px;
        color: #fff;
        background: #2563eb;
        border: 1px solid #2563eb;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .btn-search:hover {
            background: #1d4ed8;
            transform: translateY(-2px);
        }

    .btn-reset {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        height: 43px;
        padding: 0 14px;
        color: #64748b;
        background: #fff;
        border: 1px solid #dce2eb;
        border-radius: 8px;
        font-size: 13px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-reset:hover {
            color: #2563eb;
            background: #f8fafc;
            border-color: #2563eb;
            text-decoration: none;
        }

    .page-size {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #64748b;
        font-size: 13px;
    }

        .page-size select {
            height: 42px;
            padding: 0 12px;
            color: #334155;
            background: #fff;
            border: 1px solid #dce2eb;
            border-radius: 8px;
            outline: none;
            cursor: pointer;
        }

    .users-table {
        width: 100%;
        border-collapse: collapse;
    }

        .users-table th {
            padding: 16px 14px;
            text-align: left;
            color: #64748b;
            background: #f8fafc;
            border-bottom: 1px solid #e8edf4;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .users-table td {
            padding: 17px 14px;
            color: #334155;
            border-bottom: 1px solid #edf0f5;
            font-size: 14px;
            vertical-align: middle;
        }

        .users-table tbody tr {
            transition: background 0.2s ease;
        }

            .users-table tbody tr:hover {
                background: #f8fbff;
            }

    .sort-link {
        color: #64748b;
        text-decoration: none;
        transition: color 0.2s;
    }

        .sort-link:hover {
            color: #2563eb;
            text-decoration: none;
        }

    .user-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 37px;
        height: 37px;
        margin-right: 10px;
        color: #2563eb;
        background: #eff6ff;
        border-radius: 11px;
        font-size: 15px;
        vertical-align: middle;
    }

    .username-text {
        color: #1e293b;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        color: #2563eb;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

        .role-badge.admin {
            color: #7c3aed;
            background: #f5f3ff;
            border-color: #ede9fe;
        }

    .action-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

        .action-links a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 32px;
            padding: 0 10px;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .action-links a:hover {
                transform: translateY(-3px);
                text-decoration: none;
                box-shadow: 0 4px 10px rgba(15, 23, 42, 0.09);
            }

    .btn-details {
        color: #2563eb;
        background: #eff6ff;
    }

        .btn-details:hover {
            color: #1d4ed8;
            background: #dbeafe;
        }

    .btn-edit {
        color: #b7791f;
        background: #fffbeb;
    }

        .btn-edit:hover {
            color: #92400e;
            background: #fef3c7;
        }

    .btn-delete {
        color: #dc2626;
        background: #fef2f2;
    }

        .btn-delete:hover {
            color: #b91c1c;
            background: #fee2e2;
        }

    .users-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 23px;
    }

    .total-info {
        color: #64748b;
        font-size: 13px;
    }

        .total-info strong {
            color: #1e293b;
            font-size: 15px;
        }

    .pagination {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

        .pagination a,
        .pagination span {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 36px;
            height: 36px;
            padding: 0 10px;
            color: #475569;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 7px;
            text-decoration: none;
            font-size: 13px;
            transition: all 0.2s ease;
        }

            .pagination a:hover {
                color: #2563eb;
                border-color: #2563eb;
                background: #eff6ff;
            }

        .pagination .active {
            color: #fff;
            background: #2563eb;
            border-color: #2563eb;
            font-weight: 700;
        }

    .empty-message {
        padding: 45px 20px !important;
        color: #94a3b8 !important;
        text-align: center;
    }

        .empty-message i {
            display: block;
            margin-bottom: 12px;
            font-size: 30px;
        }

    .success-message,
    .error-message {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 17px;
        margin-bottom: 18px;
        border-radius: 9px;
        font-size: 14px;
    }

    .success-message {
        color: #047857;
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
    }

    .error-message {
        color: #dc2626;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    @@media (max-width: 768px) {
        .users-page {
            padding: 16px;
        }

        .users-card {
            padding: 17px;
        }

        .users-header {
            align-items: flex-start;
        }

        .users-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .search-form {
            max-width: none;
            flex-wrap: wrap;
        }

        .search-input {
            min-width: 100%;
        }

        .btn-search,
        .btn-reset {
            flex: 1;
        }

        .page-size {
            justify-content: flex-start;
        }

        .table-responsive {
            overflow-x: auto;
        }

        .users-table {
            min-width: 760px;
        }

        .users-footer {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="users-page">
    <div class="users-container">

        <div class="users-header">
            <div class="users-title">
                <div class="breadcrumb-text">
                    Admin / Quản lý / <span>Tài khoản</span>
                </div>

                <h2>
                    <i class="fa fa-users"></i>
                    Quản lý tài khoản
                </h2>

                <p>Quản lý thông tin đăng nhập và quyền truy cập của tài khoản.</p>
            </div>

            <div>
                @Html.ActionLink(
                         "Thêm tài khoản",
                         "Create",
                         null,
                         new { @class = "btn-create fa fa-plus" }
                     )
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-message">
                <i class="fa fa-check-circle"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="error-message">
                <i class="fa fa-exclamation-circle"></i>
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="users-card">

            <div class="users-toolbar">

                @using (Html.BeginForm("Index", "Users", FormMethod.Get, new { @class = "search-form" }))
                {
                    <input type="text"
                           name="searchString"
                           value="@ViewBag.CurrentFilter"
                           class="search-input"
                           placeholder="Tìm kiếm tên đăng nhập hoặc vai trò..." />

                    <input type="hidden"
                           name="sortOrder"
                           value="@ViewBag.CurrentSort" />

                    <input type="hidden"
                           name="pageSize"
                           value="@pageSize" />

                    <button type="submit" class="btn-search">
                        <i class="fa fa-search"></i>
                        Tìm kiếm
                    </button>

                    @Html.ActionLink(
                             "Đặt lại",
                             "Index",
                             null,
                             new { @class = "btn-reset fa fa-refresh" }
                         )
                }

                <div class="page-size">
                    <span>Hiển thị:</span>

                    @using (Html.BeginForm("Index", "Users", FormMethod.Get))
                    {
                        <input type="hidden"
                               name="searchString"
                               value="@ViewBag.CurrentFilter" />

                        <input type="hidden"
                               name="sortOrder"
                               value="@ViewBag.CurrentSort" />

                        <select name="pageSize">
                            <option value="5" @(pageSize == 5 ? "selected" : "")>5 / trang</option>
                            <option value="10" @(pageSize == 10 ? "selected" : "")>10 / trang</option>
                            <option value="20" @(pageSize == 20 ? "selected" : "")>20 / trang</option>
                        </select>

                        <button type="submit" class="btn-search" style="height:42px;">
                            Áp dụng
                        </button>
                    }
                </div>

            </div>

            <div class="table-responsive">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th style="width:70px;">STT</th>

                            <th>
                                @Html.ActionLink(
                                         "Tên đăng nhập",
                                         "Index",
                                         new
                                         {
                                             searchString = ViewBag.CurrentFilter,
                                             sortOrder = ViewBag.UsernameSortParm,
                                             pageSize = pageSize
                                         },
                                         new { @class = "sort-link" }
                                     )
                            </th>

                            <th>
                                @Html.ActionLink(
                                         "Vai trò",
                                         "Index",
                                         new
                                         {
                                             searchString = ViewBag.CurrentFilter,
                                             sortOrder = ViewBag.RoleSortParm,
                                             pageSize = pageSize
                                         },
                                         new { @class = "sort-link" }
                                     )
                            </th>

                            <th style="width:260px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int stt = ((currentPage - 1) * pageSize) + 1;

                            foreach (var item in Model)
                            {
                                bool isAdmin = string.Equals(
                                    item.UserRole,
                                    "Admin",
                                    StringComparison.OrdinalIgnoreCase
                                );

                                <tr>
                                    <td>@stt</td>

                                    <td>
                                        <span class="user-avatar">
                                            <i class="fa fa-user"></i>
                                        </span>

                                        <span class="username-text">
                                            @item.Username
                                        </span>
                                    </td>

                                    <td>
                                        <span class="role-badge @(isAdmin ? "admin" : "")">
                                            <i class="fa @(isAdmin ? "fa-shield" : "fa-user")"></i>
                                            @item.UserRole
                                        </span>
                                    </td>

                                    <td>
                                        <div class="action-links">
                                            @Html.ActionLink(
                                                     "Chi tiết",
                                                     "Details",
                                                     new { id = item.Username },
                                                     new { @class = "btn-details fa fa-eye" }
                                                 )

                                            @Html.ActionLink(
                                                     "Sửa",
                                                     "Edit",
                                                     new { id = item.Username },
                                                     new { @class = "btn-edit fa fa-pencil" }
                                                 )

                                            @Html.ActionLink(
                                                     "Xóa",
                                                     "Delete",
                                                     new { id = item.Username },
                                                     new { @class = "btn-delete fa fa-trash" }
                                                 )
                                        </div>
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="empty-message">
                                    <i class="fa fa-user-times"></i>
                                    Không tìm thấy tài khoản nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="users-footer">

                <div class="total-info">
                    Tổng số:
                    <strong>@totalItems</strong>
                    tài khoản
                </div>

                <div class="pagination">

                    @if (currentPage > 1)
                    {
                        @Html.ActionLink(
                                 "‹",
                                 "Index",
                                 new
                                 {
                                     page = currentPage - 1,
                                     searchString = ViewBag.CurrentFilter,
                                     sortOrder = ViewBag.CurrentSort,
                                     pageSize = pageSize
                                 }
                             )
                    }

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == currentPage)
                        {
                            <span class="active">@i</span>
                        }
                        else
                        {
                            @Html.ActionLink(
                                     i.ToString(),
                                     "Index",
                                     new
                                     {
                                         page = i,
                                         searchString = ViewBag.CurrentFilter,
                                         sortOrder = ViewBag.CurrentSort,
                                         pageSize = pageSize
                                     }
                                 )
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        @Html.ActionLink(
                                 "›",
                                 "Index",
                                 new
                                 {
                                     page = currentPage + 1,
                                     searchString = ViewBag.CurrentFilter,
                                     sortOrder = ViewBag.CurrentSort,
                                     pageSize = pageSize
                                 }
                             )
                    }

                </div>

            </div>

        </div>
    </div>
</div>
