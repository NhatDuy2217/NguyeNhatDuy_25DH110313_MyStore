
@model NguyeNhatDuy_25DH110313_MyStore.Models.User

@{
    ViewBag.Title = "Thêm tài khoản";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .user-create-page {
        min-height: 100vh;
        padding: 35px 20px;
        background: #f4f7fb;
        color: #243247;
        font-family: Arial, sans-serif;
    }

    .user-create-container {
        max-width: 850px;
        margin: 0 auto;
    }

    .user-create-heading {
        margin-bottom: 25px;
    }

    .breadcrumb-text {
        margin-bottom: 12px;
        color: #64748b;
        font-size: 13px;
    }

        .breadcrumb-text span {
            color: #2563eb;
            font-weight: 600;
        }

    .user-create-heading h2 {
        margin: 0 0 8px;
        color: #172554;
        font-size: 28px;
        font-weight: 700;
    }

    .user-create-heading p {
        margin: 0;
        color: #8492a6;
        font-size: 14px;
        line-height: 1.6;
    }

    .user-create-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e5eaf2;
        border-radius: 16px;
        box-shadow: 0 7px 25px rgba(15, 23, 42, 0.05);
    }

    .user-card-heading {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 25px 30px;
        border-bottom: 1px solid #edf0f5;
    }

    .user-card-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 48px;
        width: 48px;
        height: 48px;
        color: #2563eb;
        background: #eff6ff;
        border-radius: 13px;
        font-size: 21px;
    }

    .user-card-heading h3 {
        margin: 0 0 6px;
        color: #1e293b;
        font-size: 19px;
        font-weight: 700;
    }

    .user-card-heading p {
        margin: 0;
        color: #8492a6;
        font-size: 13px;
        line-height: 1.5;
    }

    .user-create-form {
        max-width: 620px;
        margin: 0 auto;
        padding: 30px;
    }

    .user-create-group {
        margin-bottom: 23px;
    }

        .user-create-group label {
            display: block;
            margin-bottom: 9px;
            color: #334155;
            font-size: 14px;
            font-weight: 600;
        }

    .required-mark {
        color: #dc2626;
    }

    .user-create-group .form-control {
        display: block;
        width: 100%;
        height: 45px;
        padding: 0 14px;
        color: #334155;
        background: #fff;
        border: 1px solid #dce2eb;
        border-radius: 9px;
        outline: none;
        box-shadow: none;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .user-create-group .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.09);
        }

        .user-create-group .form-control::placeholder {
            color: #a0aabb;
        }

    .field-hint {
        display: block;
        margin-top: 7px;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.5;
    }

    .user-create-group .field-validation-error {
        display: block;
        margin-top: 7px;
        color: #dc2626;
        font-size: 12px;
    }

    .user-create-validation {
        margin-bottom: 22px;
        padding: 12px 15px;
        color: #dc2626;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 9px;
        font-size: 13px;
    }

        .user-create-validation:empty {
            display: none;
        }

    .user-create-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
        padding-top: 23px;
        border-top: 1px solid #edf0f5;
    }

        .user-create-actions .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            min-width: 155px;
            min-height: 44px;
            margin: 0;
            padding: 0 20px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s ease;
        }

    .btn-user-save {
        color: #fff;
        background: #2563eb;
        border: 1px solid #2563eb;
    }

        .btn-user-save:hover,
        .btn-user-save:focus {
            color: #fff;
            background: #1d4ed8;
            border-color: #1d4ed8;
            transform: translateY(-3px);
            box-shadow: 0 6px 14px rgba(37, 99, 235, 0.2);
        }

    .btn-user-back {
        color: #475569;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .btn-user-back:hover,
        .btn-user-back:focus {
            color: #1e293b;
            background: #f1f5f9;
            border-color: #cbd5e1;
            transform: translateY(-3px);
            text-decoration: none;
        }

    @@media (max-width: 576px) {
        .user-create-page {
            padding: 20px 14px;
        }

        .user-card-heading {
            padding: 20px;
        }

        .user-create-form {
            padding: 22px 20px;
        }

        .user-create-heading h2 {
            font-size: 24px;
        }

        .user-create-actions {
            flex-direction: column;
        }

            .user-create-actions .btn {
                width: 100%;
            }
    }
</style>

<div class="user-create-page">
    <div class="user-create-container">

        <div class="user-create-heading">
            <div class="breadcrumb-text">
                Admin / Quản lý tài khoản / <span>Thêm tài khoản</span>
            </div>

            <h2>
                <i class="fa fa-user-plus"></i>
                Thêm tài khoản
            </h2>

            <p>Tạo tài khoản mới và thiết lập quyền truy cập vào hệ thống BookOra.</p>
        </div>

        <div class="user-create-card">

            <div class="user-card-heading">
                <div class="user-card-icon">
                    <i class="fa fa-user-plus"></i>
                </div>

                <div>
                    <h3>Thông tin tài khoản</h3>
                    <p>Vui lòng nhập đầy đủ thông tin bên dưới.</p>
                </div>
            </div>

            @using (Html.BeginForm(
                "Create",
                "Users",
                new { area = "Admin" },
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="user-create-form">

                    @Html.ValidationSummary(
                             true,
                             "",
                             new { @class = "text-danger user-create-validation" }
                         )

                    <div class="user-create-group">

                        @Html.LabelFor(
                                 model => model.Username,
                                 "Tên đăng nhập"
                             )

                        @Html.TextBoxFor(
                                 model => model.Username,
                                 new
                                 {
                                     @class = "form-control",
                                     placeholder = "Nhập tên đăng nhập"
                                 }
                             )

                        @Html.ValidationMessageFor(
                                 model => model.Username,
                                 "",
                                 new { @class = "text-danger" }
                             )

                        <span class="field-hint">
                            Tên đăng nhập được sử dụng để đăng nhập vào hệ thống.
                        </span>

                    </div>

                    <div class="user-create-group">

                        @Html.LabelFor(
                                 model => model.Password,
                                 "Mật khẩu"
                             )

                        @Html.PasswordFor(
                                 model => model.Password,
                                 new
                                 {
                                     @class = "form-control",
                                     placeholder = "Nhập mật khẩu"
                                 }
                             )

                        @Html.ValidationMessageFor(
                                 model => model.Password,
                                 "",
                                 new { @class = "text-danger" }
                             )

                        <span class="field-hint">
                            Nhập mật khẩu cho tài khoản mới.
                        </span>

                    </div>

                    <div class="user-create-group">

                        @Html.LabelFor(
                                 model => model.UserRole,
                                 "Vai trò tài khoản"
                             )

                        @Html.DropDownListFor(
                                 model => model.UserRole,
                                 new SelectList(
                                     new[]
                                     {
                                    new
                                    {
                                        Value = "Admin",
                                        Text = "Admin"
                                    },
                                    new
                                    {
                                        Value = "Customer",
                                        Text = "Customer"
                                    }
                             },
                                     "Value",
                                     "Text"
                                 ),
                                 "-- Chọn vai trò tài khoản --",
                                 new { @class = "form-control" }
                             )

                        @Html.ValidationMessageFor(
                                 model => model.UserRole,
                                 "",
                                 new { @class = "text-danger" }
                             )

                        <span class="field-hint">
                            Admin có quyền quản lý hệ thống; Customer sử dụng các chức năng dành cho khách hàng.
                        </span>

                    </div>

                    <div class="user-create-actions">

                        <button type="submit" class="btn btn-user-save">
                            <i class="fa fa-plus"></i>
                            Thêm tài khoản
                        </button>

                        @Html.ActionLink(
                                 "Quay lại",
                                 "Index",
                                 "Users",
                                 new { area = "Admin" },
                                 new { @class = "btn btn-user-back" }
                             )

                    </div>

                </div>
            }

        </div>
    </div>
</div>
