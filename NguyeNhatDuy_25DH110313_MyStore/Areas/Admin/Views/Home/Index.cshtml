@{
    ViewBag.Title = "Tổng quan quản trị";
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<style>
    .dashboard-page {
        width: 100%;
        color: #24334d;
    }

    /* WELCOME */
    .dashboard-welcome {
        position: relative;
        overflow: hidden;
        padding: 30px 32px;
        margin-bottom: 27px;
        border-radius: 17px;
        background: linear-gradient(115deg, #142747, #24569c);
        box-shadow: 0 8px 22px rgba(26, 61, 112, .12);
    }

        .dashboard-welcome::after {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            top: -120px;
            right: 35px;
            border: 35px solid rgba(255,255,255,.06);
            border-radius: 50%;
        }

    .welcome-content {
        position: relative;
        z-index: 1;
    }

    .welcome-label {
        margin-bottom: 10px;
        color: #f5c76b;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .dashboard-welcome h2 {
        margin: 0 0 10px;
        color: #fff;
        font-size: 27px;
        font-weight: 800;
    }

    .dashboard-welcome p {
        margin: 0;
        color: #d5e2f5;
        font-size: 13px;
        line-height: 1.7;
    }

    .welcome-date {
        display: inline-block;
        margin-top: 17px;
        padding: 8px 13px;
        color: #e8effb;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 8px;
        font-size: 11px;
    }

    /* SECTION */
    .dashboard-section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 27px 0 16px;
    }

        .dashboard-section-heading h3 {
            margin: 0;
            color: #172744;
            font-size: 17px;
            font-weight: 800;
        }

        .dashboard-section-heading p {
            margin: 5px 0 0;
            color: #94a0b2;
            font-size: 12px;
        }

    .section-tag {
        padding: 7px 11px;
        color: #315b98;
        background: #edf4ff;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* STATISTICS */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 25px;
    }

    .dashboard-card {
        min-width: 0;
        padding: 20px 17px;
        background: #fff;
        border: 1px solid #e9edf4;
        border-radius: 13px;
        box-shadow: 0 4px 15px rgba(25, 45, 80, .035);
        transition: .2s;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 9px 22px rgba(25, 45, 80, .08);
        }

    .card-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 17px;
        border-radius: 12px;
        font-size: 21px;
    }

        .card-icon.blue {
            color: #2563eb;
            background: #eaf1ff;
        }

        .card-icon.purple {
            color: #8253d8;
            background: #f1eaff;
        }

        .card-icon.cyan {
            color: #0891b2;
            background: #e2f8fc;
        }

        .card-icon.orange {
            color: #d97706;
            background: #fff4df;
        }

        .card-icon.green {
            color: #15945a;
            background: #e4f8ed;
        }

    .card-label {
        min-height: 34px;
        color: #7b8799;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.5;
    }

    .card-number {
        margin: 7px 0 0;
        color: #192b49;
        font-size: 28px;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .card-caption {
        margin-top: 8px;
        color: #a0aabc;
        font-size: 10px;
    }

    /* REVENUE */
    .revenue-box {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 25px 28px;
        margin-bottom: 28px;
        color: white;
        background: linear-gradient(110deg, #1e4f96, #2877ca);
        border-radius: 15px;
        box-shadow: 0 7px 20px rgba(37, 99, 235, .13);
    }

        .revenue-box::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: 80px;
            top: -100px;
            border: 25px solid rgba(255,255,255,.07);
            border-radius: 50%;
        }

    .revenue-content {
        position: relative;
        z-index: 1;
    }

    .revenue-label {
        margin-bottom: 12px;
        color: #dbeafe;
        font-size: 13px;
        font-weight: 600;
    }

    .revenue-amount {
        color: #fff;
        font-size: 31px;
        font-weight: 900;
        overflow-wrap: anywhere;
    }

    .revenue-description {
        margin-top: 9px;
        color: #d1e3fa;
        font-size: 11px;
    }

    .revenue-icon {
        position: relative;
        z-index: 1;
        width: 62px;
        height: 62px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 16px;
        font-size: 29px;
    }

    /* CHARTS */
    .chart-grid {
        display: grid;
        grid-template-columns: 1.45fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .chart-card {
        min-width: 0;
        padding: 23px;
        background: #fff;
        border: 1px solid #e9edf4;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(25, 45, 80, .035);
    }

    .chart-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 20px;
    }

    .chart-title {
        margin: 0;
        color: #1c2d49;
        font-size: 16px;
        font-weight: 800;
    }

    .chart-description {
        margin: 7px 0 0;
        color: #9aa5b5;
        font-size: 11px;
        line-height: 1.6;
    }

    .chart-badge {
        padding: 6px 9px;
        color: #315b98;
        background: #edf4ff;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .chart-container {
        position: relative;
        width: 100%;
        height: 290px;
    }

    .top-products-card {
        margin-bottom: 25px;
    }

        .top-products-card .chart-container {
            height: 270px;
        }

    /* PAYMENT SUMMARY */
    .payment-summary {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-top: 18px;
    }

    .payment-item {
        padding: 14px;
        background: #f7f9fc;
        border: 1px solid #edf0f5;
        border-radius: 10px;
    }

        .payment-item span {
            display: block;
            margin-bottom: 9px;
            color: #8490a3;
            font-size: 11px;
            font-weight: 600;
        }

        .payment-item strong {
            font-size: 23px;
            font-weight: 800;
        }

    .paid-number {
        color: #15945a;
    }

    .unpaid-number {
        color: #dc6b42;
    }

    /* EMPTY CHART */
    .chart-empty {
        display: none;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #94a0b2;
        text-align: center;
        font-size: 13px;
    }

    @@media (max-width: 1200px) {
        .dashboard-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 900px) {
        .chart-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .dashboard-welcome {
            padding: 24px 20px;
        }

            .dashboard-welcome h2 {
                font-size: 22px;
            }

        .dashboard-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .dashboard-card {
            padding: 16px 13px;
        }

        .card-number {
            font-size: 24px;
        }

        .card-icon {
            width: 38px;
            height: 38px;
            font-size: 19px;
        }

        .revenue-box {
            padding: 21px 18px;
        }

        .revenue-amount {
            font-size: 24px;
        }

        .revenue-icon {
            width: 48px;
            height: 48px;
            font-size: 23px;
        }

        .chart-card {
            padding: 17px 13px;
        }

        .chart-container {
            height: 250px;
        }

        .top-products-card .chart-container {
            height: 250px;
        }

        .payment-summary {
            gap: 8px;
        }

        .payment-item {
            padding: 12px 10px;
        }

            .payment-item strong {
                font-size: 20px;
            }
    }

    @@media (max-width: 360px) {
        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-page">

    <!-- WELCOME -->
    <div class="dashboard-welcome">
        <div class="welcome-content">
            <div class="welcome-label">
                BOOKORA ADMINISTRATION
            </div>

            <h2>Chào mừng trở lại! 👋</h2>

            <p>
                Chào mừng bạn đến với hệ thống quản lý nhà sách BookOra.
                Theo dõi và quản lý hoạt động kinh doanh tại đây.
            </p>

            <div class="welcome-date">
                📅 @DateTime.Now.ToString("dd/MM/yyyy")
            </div>
        </div>
    </div>

    <!-- STATISTICS -->
    <div class="dashboard-section-heading">
        <div>
            <h3>Thống kê tổng quan</h3>
            <p>Tình hình hoạt động của hệ thống</p>
        </div>

        <span class="section-tag">📊 Dashboard</span>
    </div>

    <div class="dashboard-grid">

        <div class="dashboard-card">
            <div class="card-icon blue">📚</div>
            <div class="card-label">Tổng số sản phẩm</div>
            <p class="card-number">@ViewBag.TotalProducts</p>
            <div class="card-caption">Sách đang hoạt động</div>
        </div>

        <div class="dashboard-card">
            <div class="card-icon purple">📂</div>
            <div class="card-label">Tổng danh mục</div>
            <p class="card-number">@ViewBag.TotalCategories</p>
            <div class="card-caption">Danh mục sản phẩm</div>
        </div>

        <div class="dashboard-card">
            <div class="card-icon cyan">👥</div>
            <div class="card-label">Tổng khách hàng</div>
            <p class="card-number">@ViewBag.TotalCustomers</p>
            <div class="card-caption">Khách hàng hệ thống</div>
        </div>

        <div class="dashboard-card">
            <div class="card-icon orange">👤</div>
            <div class="card-label">Tổng tài khoản</div>
            <p class="card-number">@ViewBag.TotalUsers</p>
            <div class="card-caption">Tài khoản người dùng</div>
        </div>

        <div class="dashboard-card">
            <div class="card-icon green">🛒</div>
            <div class="card-label">Tổng đơn hàng</div>
            <p class="card-number">@ViewBag.TotalOrders</p>
            <div class="card-caption">Đơn hàng đã ghi nhận</div>
        </div>

    </div>

    <!-- REVENUE -->
    <div class="dashboard-section-heading">
        <div>
            <h3>Doanh thu kinh doanh</h3>
            <p>Tổng giá trị đơn hàng đã thanh toán</p>
        </div>
    </div>

    <div class="revenue-box">
        <div class="revenue-content">
            <div class="revenue-label">
                💰 Tổng doanh thu
            </div>

            <div class="revenue-amount">
                @String.Format("{0:N0} VNĐ", ViewBag.TotalRevenue)
            </div>

            <div class="revenue-description">
                Doanh thu từ các đơn hàng đã thanh toán
            </div>
        </div>

        <div class="revenue-icon">💵</div>
    </div>

    <!-- CHART TITLE -->
    <div class="dashboard-section-heading">
        <div>
            <h3>Phân tích kinh doanh</h3>
            <p>Theo dõi doanh thu, thanh toán và sản phẩm bán chạy</p>
        </div>

        <span class="section-tag">Business Analytics</span>
    </div>

    <div class="chart-grid">

        <!-- MONTHLY REVENUE -->
        <div class="chart-card">
            <div class="chart-card-header">
                <div>
                    <h4 class="chart-title">📈 Doanh thu theo tháng</h4>
                    <p class="chart-description">
                        Biến động doanh thu trong năm @DateTime.Now.Year
                    </p>
                </div>

                <span class="chart-badge">12 tháng</span>
            </div>

            <div class="chart-container">
                <canvas id="monthlyRevenueChart"></canvas>

                <div class="chart-empty" id="monthlyEmpty">
                    Chưa có dữ liệu doanh thu trong năm nay.
                </div>
            </div>
        </div>

        <!-- PAYMENT STATUS -->
        <div class="chart-card">
            <div class="chart-card-header">
                <div>
                    <h4 class="chart-title">💳 Trạng thái thanh toán</h4>
                    <p class="chart-description">
                        Tỷ lệ đơn hàng đã và chưa thanh toán
                    </p>
                </div>

                <span class="chart-badge">Đơn hàng</span>
            </div>

            <div class="chart-container">
                <canvas id="paymentChart"></canvas>

                <div class="chart-empty" id="paymentEmpty">
                    Chưa có dữ liệu đơn hàng.
                </div>
            </div>

            <div class="payment-summary">
                <div class="payment-item">
                    <span>✓ Đã thanh toán</span>
                    <strong class="paid-number">
                        @ViewBag.PaidOrders
                    </strong>
                </div>

                <div class="payment-item">
                    <span>◷ Chưa thanh toán</span>
                    <strong class="unpaid-number">
                        @ViewBag.UnpaidOrders
                    </strong>
                </div>
            </div>
        </div>

    </div>

    <!-- TOP 5 PRODUCTS -->
    <div class="chart-card top-products-card">
        <div class="chart-card-header">
            <div>
                <h4 class="chart-title">🏆 Top 5 sách bán chạy</h4>
                <p class="chart-description">
                    Xếp hạng theo tổng số lượng sách trong các đơn hàng đã thanh toán
                </p>
            </div>

            <span class="chart-badge">Top 5</span>
        </div>

        <div class="chart-container">
            <canvas id="topProductsChart"></canvas>

            <div class="chart-empty" id="topProductsEmpty">
                Chưa có dữ liệu sách bán chạy.
            </div>
        </div>
    </div>

</div>

<!-- DATA FOR DASHBOARD -->
<div id="dashboardData"
     data-paid="@ViewBag.PaidOrders"
     data-unpaid="@ViewBag.UnpaidOrders"
     style="display:none;">
</div>

<!-- MONTHLY REVENUE DATA -->
<script id="monthlyRevenueLabels" type="application/json">
    @Html.Raw(System.Web.Helpers.Json.Encode(ViewBag.MonthlyRevenueLabels ?? new string[0]))
</script>

<script id="monthlyRevenueValues" type="application/json">
    @Html.Raw(System.Web.Helpers.Json.Encode(ViewBag.MonthlyRevenueValues ?? new decimal[0]))
</script>

<!-- TOP PRODUCTS DATA -->
<script id="topSellingLabels" type="application/json">
    @Html.Raw(System.Web.Helpers.Json.Encode(ViewBag.TopSellingLabels ?? new string[0]))
</script>

<script id="topSellingValues" type="application/json">
    @Html.Raw(System.Web.Helpers.Json.Encode(ViewBag.TopSellingValues ?? new int[0]))
</script>

<!-- CHART.JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
        // Không sử dụng TypeScript hoặc kiểu dữ liệu TypeScript trong file Razor.
        document.addEventListener("DOMContentLoaded", function () {

            // =========================================
            // 1. ĐỌC DỮ LIỆU JSON
            // =========================================

            var monthlyLabels = [];
            var monthlyValues = [];
            var topLabels = [];
            var topValues = [];

            var monthlyLabelsElement =
                document.getElementById("monthlyRevenueLabels");

            var monthlyValuesElement =
                document.getElementById("monthlyRevenueValues");

            var topLabelsElement =
                document.getElementById("topSellingLabels");

            var topValuesElement =
                document.getElementById("topSellingValues");

            try {
                if (monthlyLabelsElement) {
                    monthlyLabels = JSON.parse(
                        monthlyLabelsElement.textContent || "[]"
                    );
                }

                if (monthlyValuesElement) {
                    monthlyValues = JSON.parse(
                        monthlyValuesElement.textContent || "[]"
                    );
                }

                if (topLabelsElement) {
                    topLabels = JSON.parse(
                        topLabelsElement.textContent || "[]"
                    );
                }

                if (topValuesElement) {
                    topValues = JSON.parse(
                        topValuesElement.textContent || "[]"
                    );
                }
            }
            catch (error) {
                console.error("Không thể đọc dữ liệu biểu đồ:", error);
                return;
            }

            // =========================================
            // 2. ĐỌC THỐNG KÊ THANH TOÁN
            // =========================================

            var dashboardData =
                document.getElementById("dashboardData");

            if (!dashboardData) {
                console.error("Không tìm thấy dữ liệu dashboard.");
                return;
            }

            var paidOrders =
                Number(dashboardData.getAttribute("data-paid")) || 0;

            var unpaidOrders =
                Number(dashboardData.getAttribute("data-unpaid")) || 0;

            // =========================================
            // 3. KIỂM TRA CHART.JS
            // =========================================

            var ChartLibrary = Reflect.get(window, "Chart");

            if (typeof ChartLibrary !== "function") {
                console.error("Không tải được thư viện Chart.js.");
                return;
            }

            // =========================================
            // 4. BIỂU ĐỒ DOANH THU THEO THÁNG
            // =========================================

            var revenueCanvas =
                document.getElementById("monthlyRevenueChart");

            var monthlyEmpty =
                document.getElementById("monthlyEmpty");

            var hasRevenue = false;
            var i;

            for (i = 0; i < monthlyValues.length; i++) {
                if (Number(monthlyValues[i]) > 0) {
                    hasRevenue = true;
                    break;
                }
            }

            if (revenueCanvas instanceof HTMLCanvasElement && hasRevenue) {

                var revenueConfig = {
                    type: "line",

                    data: {
                        labels: monthlyLabels,

                        datasets: [{
                            label: "Doanh thu",

                            data: monthlyValues,

                            borderColor: "#347bd0",
                            backgroundColor: "rgba(52,123,208,0.12)",

                            borderWidth: 3,
                            fill: true,
                            tension: 0.38,

                            pointRadius: 4,
                            pointHoverRadius: 7,
                            pointBackgroundColor: "#ffffff",
                            pointBorderColor: "#347bd0",
                            pointBorderWidth: 2
                        }]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,

                        interaction: {
                            intersect: false,
                            mode: "index"
                        },

                        plugins: {
                            legend: {
                                display: false
                            },

                            tooltip: {
                                enabled: true
                            }
                        },

                        scales: {
                            y: {
                                beginAtZero: true,

                                ticks: {
                                    precision: 0
                                },

                                grid: {
                                    color: "#edf1f7"
                                }
                            },

                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                };

                Reflect.construct(
                    ChartLibrary,
                    [revenueCanvas, revenueConfig]
                );

            }
            else if (monthlyEmpty instanceof HTMLElement) {
                monthlyEmpty.style.display = "flex";
            }

            // =========================================
            // 5. BIỂU ĐỒ TRẠNG THÁI THANH TOÁN
            // =========================================

            var paymentCanvas =
                document.getElementById("paymentChart");

            var paymentEmpty =
                document.getElementById("paymentEmpty");

            if (
                paymentCanvas instanceof HTMLCanvasElement &&
                (paidOrders + unpaidOrders) > 0
            ) {

                var paymentConfig = {
                    type: "doughnut",

                    data: {
                        labels: [
                            "Đã thanh toán",
                            "Chưa thanh toán"
                        ],

                        datasets: [{
                            data: [
                                paidOrders,
                                unpaidOrders
                            ],

                            backgroundColor: [
                                "#16a36a",
                                "#f59e0b"
                            ],

                            borderWidth: 3,
                            borderColor: "#ffffff",
                            hoverOffset: 8
                        }]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,

                        plugins: {
                            legend: {
                                position: "bottom",

                                labels: {
                                    usePointStyle: true,
                                    padding: 18,

                                    font: {
                                        size: 11
                                    }
                                }
                            }
                        },

                        cutout: "66%"
                    }
                };

                Reflect.construct(
                    ChartLibrary,
                    [paymentCanvas, paymentConfig]
                );

            }
            else if (paymentEmpty instanceof HTMLElement) {
                paymentEmpty.style.display = "flex";
            }

            // =========================================
            // 6. BIỂU ĐỒ TOP 5 SÁCH BÁN CHẠY
            // =========================================

            var topProductsCanvas =
                document.getElementById("topProductsChart");

            var topProductsEmpty =
                document.getElementById("topProductsEmpty");

            if (
                topProductsCanvas instanceof HTMLCanvasElement &&
                topLabels.length > 0
            ) {

                var topProductsConfig = {
                    type: "bar",

                    data: {
                        labels: topLabels,

                        datasets: [{
                            label: "Số lượng đã bán",

                            data: topValues,

                            backgroundColor: [
                                "#347bd0",
                                "#568fda",
                                "#78a6e3",
                                "#9abce9",
                                "#b8d0f0"
                            ],

                            borderRadius: 7,
                            maxBarThickness: 32
                        }]
                    },

                    options: {
                        indexAxis: "y",

                        responsive: true,
                        maintainAspectRatio: false,

                        plugins: {
                            legend: {
                                display: false
                            }
                        },

                        scales: {
                            x: {
                                beginAtZero: true,

                                ticks: {
                                    precision: 0
                                },

                                grid: {
                                    color: "#edf1f7"
                                }
                            },

                            y: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                };

                Reflect.construct(
                    ChartLibrary,
                    [topProductsCanvas, topProductsConfig]
                );

            }
            else if (topProductsEmpty instanceof HTMLElement) {
                topProductsEmpty.style.display = "flex";
