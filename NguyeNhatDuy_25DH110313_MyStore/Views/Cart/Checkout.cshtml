
@model NguyeNhatDuy_25DH110313_MyStore.Models.Customer

@using NguyeNhatDuy_25DH110313_MyStore.Models
@using System.Collections.Generic
@using System.Linq

@{
    ViewBag.Title = "Xác nhận đặt hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    var cart = Session["Cart"] as List<CartItem>
               ?? new List<CartItem>();

    decimal total = cart.Sum(x => x.UnitPrice * x.Quantity);
}

<style>
    .checkout-page {
        background: #f4f7fc;
        min-height: 80vh;
        padding: 45px 15px 65px;
        font-family: Arial, sans-serif;
    }

    .checkout-container {
        max-width: 1120px;
        margin: auto;
    }

    /* HEADER */

    .checkout-heading {
        text-align: center;
        margin-bottom: 35px;
    }

        .checkout-heading .eyebrow {
            display: inline-block;
            color: #2563eb;
            background: #e8efff;
            padding: 7px 15px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 12px;
        }

        .checkout-heading h2 {
            color: #172554;
            font-size: 30px;
            font-weight: 800;
            margin: 0 0 10px;
        }

        .checkout-heading p {
            color: #718096;
            font-size: 14px;
            margin: 0;
        }

    /* PROGRESS */

    .checkout-progress {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 35px;
    }

    .progress-step {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #2563eb;
        font-size: 13px;
        font-weight: 700;
    }

    .progress-number {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #2563eb;
        color: white;
        font-size: 14px;
    }

    .progress-line {
        width: 65px;
        height: 2px;
        background: #cbd5e1;
        margin: 0 15px;
    }

    .progress-step.active .progress-number {
        background: #172554;
    }

    /* CARDS */

    .checkout-card {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 17px;
        padding: 28px;
        box-shadow: 0 8px 28px rgba(23, 37, 84, .045);
        margin-bottom: 22px;
    }

    .checkout-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 25px;
        padding-bottom: 18px;
        border-bottom: 1px solid #edf1f7;
    }

    .checkout-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf0ff;
        color: #2563eb;
        border-radius: 12px;
        font-size: 20px;
    }

    .checkout-card-header h4 {
        color: #172554;
        font-size: 18px;
        font-weight: 800;
        margin: 0 0 4px;
    }

    .checkout-card-header p {
        color: #94a3b8;
        font-size: 12px;
        margin: 0;
    }

    /* FORM */

    .checkout-form-group {
        margin-bottom: 19px;
    }

        .checkout-form-group label {
            display: block;
            color: #334155;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 8px;
        }

            .checkout-form-group label span {
                color: #ef4444;
            }

        .checkout-form-group .form-control {
            height: 47px;
            border: 1px solid #dce3ee;
            border-radius: 9px;
            padding: 10px 14px;
            color: #334155;
            font-size: 14px;
            box-shadow: none;
            transition: .2s;
            margin-bottom: 0;
        }

            .checkout-form-group .form-control:focus {
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, .10);
            }

            .checkout-form-group .form-control::placeholder {
                color: #a0aec0;
            }

    /* ORDER */

    .order-product {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        padding: 16px 0;
        border-bottom: 1px solid #edf1f7;
    }

    .order-product-info {
        min-width: 0;
        flex: 1;
    }

    .order-product-name {
        color: #263653;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.5;
        word-break: break-word;
    }

    .order-product-quantity {
        color: #94a3b8;
        font-size: 12px;
        margin-top: 6px;
    }

    .order-product-price {
        color: #334155;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
    }

    .order-summary {
        margin-top: 20px;
        padding: 17px;
        background: #f7f9fd;
        border-radius: 12px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        color: #64748b;
        font-size: 13px;
        margin-bottom: 13px;
    }

        .summary-row:last-child {
            margin-bottom: 0;
        }

    .summary-total {
        border-top: 1px dashed #cbd5e1;
        padding-top: 16px;
        margin-top: 15px;
        align-items: center;
    }

        .summary-total span:first-child {
            color: #172554;
            font-size: 15px;
            font-weight: 800;
        }

        .summary-total span:last-child {
            color: #e05252;
            font-size: 23px;
            font-weight: 800;
            white-space: nowrap;
        }

    /* PAYMENT */

    .payment-method {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 16px;
        border: 1px solid #bfdbfe;
        background: #eff6ff;
        border-radius: 12px;
        margin-top: 20px;
    }

    .payment-icon {
        width: 40px;
        height: 40px;
        background: #dbeafe;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 19px;
        flex-shrink: 0;
    }

    .payment-info strong {
        display: block;
        color: #1e3a8a;
        font-size: 13px;
        margin-bottom: 4px;
    }

    .payment-info span {
        color: #64748b;
        font-size: 12px;
    }

    /* BUTTON */

    .checkout-btn {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 16px;
        margin-top: 20px;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        font-weight: 800;
        font-size: 14px;
        letter-spacing: .4px;
        cursor: pointer;
        transition: .25s;
        box-shadow: 0 6px 15px rgba(37, 99, 235, .2);
    }

        .checkout-btn:hover {
            background: linear-gradient(135deg, #1d4ed8, #1e40af);
            transform: translateY(-2px);
            box-shadow: 0 9px 20px rgba(37, 99, 235, .25);
        }

        .checkout-btn:active {
            transform: translateY(0);
        }

    .checkout-back {
        display: block;
        text-align: center;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
        margin-top: 17px;
        text-decoration: none;
    }

        .checkout-back:hover {
            color: #2563eb;
            text-decoration: none;
        }

    /* NOTICE */

    .checkout-note {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        background: #fffbeb;
        border: 1px solid #fde68a;
        padding: 13px 15px;
        border-radius: 10px;
        margin-top: 18px;
        color: #92400e;
        font-size: 12px;
        line-height: 1.6;
    }

    .checkout-error {
        color: #dc2626;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 12px 15px;
        margin-bottom: 20px;
        font-size: 13px;
    }

        .checkout-error ul {
            margin: 0;
            padding-left: 20px;
        }

    /* EMPTY CART */

    .checkout-empty {
        background: white;
        border-radius: 17px;
        padding: 55px 20px;
        text-align: center;
        box-shadow: 0 8px 28px rgba(23, 37, 84, .045);
    }

    .checkout-empty-icon {
        font-size: 48px;
        margin-bottom: 15px;
    }

    .checkout-empty h3 {
        color: #172554;
        font-size: 21px;
        font-weight: 800;
    }

    .checkout-empty p {
        color: #718096;
        font-size: 14px;
        margin-bottom: 22px;
    }

    .checkout-empty a {
        display: inline-block;
        padding: 12px 25px;
        border-radius: 9px;
        color: white;
        background: #2563eb;
        font-weight: 700;
        text-decoration: none;
    }

    /* RESPONSIVE */

    @@media (max-width: 767px) {
        .checkout-page {
            padding: 30px 12px 45px;
        }

        .checkout-heading h2 {
            font-size: 24px;
        }

        .checkout-card {
            padding: 20px;
        }

        .checkout-progress {
            margin-bottom: 25px;
        }

        .progress-line {
            width: 25px;
            margin: 0 8px;
        }

        .progress-step {
            font-size: 11px;
            gap: 6px;
        }

        .progress-number {
            width: 28px;
            height: 28px;
            font-size: 12px;
        }

        .summary-total span:last-child {
            font-size: 20px;
        }
    }

    @@media (max-width: 400px) {
        .progress-step {
            font-size: 10px;
        }

        .progress-line {
            width: 15px;
            margin: 0 5px;
        }

        .checkout-card {
            padding: 16px;
        }
    }
</style>

<div class="checkout-page">
    <div class="checkout-container">

        <!-- TIÊU ĐỀ -->
        <div class="checkout-heading">
            <span class="eyebrow">BOOKORA CHECKOUT</span>
            <h2>Xác nhận đặt hàng</h2>
            <p>Chỉ còn một bước nữa để những cuốn sách yêu thích đến với bạn.</p>
        </div>

        @if (cart == null || !cart.Any())
        {
            <div class="checkout-empty">
                <div class="checkout-empty-icon">🛒</div>
                <h3>Giỏ hàng của bạn đang trống</h3>
                <p>Hãy khám phá và chọn những cuốn sách yêu thích tại BookOra nhé!</p>
                <a href="@Url.Action("Index", "Home")">
                    Tiếp tục mua sắm
                </a>
            </div>
        }
        else
        {
            <!-- TIẾN TRÌNH ĐẶT HÀNG -->
            <div class="checkout-progress">
                <div class="progress-step">
                    <span class="progress-number">1</span>
                    <span>Giỏ hàng</span>
                </div>

                <div class="progress-line"></div>

                <div class="progress-step active">
                    <span class="progress-number">2</span>
                    <span>Đặt hàng</span>
                </div>

                <div class="progress-line"></div>

                <div class="progress-step">
                    <span class="progress-number">3</span>
                    <span>Hoàn tất</span>
                </div>
            </div>

            using (Html.BeginForm("Checkout", "Cart", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                         false,
                         "",
                         new { @class = "checkout-error" }
                     )

                <div class="row">

                    <!-- THÔNG TIN GIAO HÀNG -->
                    <div class="col-md-7">
                        <div class="checkout-card">

                            <div class="checkout-card-header">
                                <div class="checkout-icon">📍</div>
                                <div>
                                    <h4>Thông tin giao hàng</h4>
                                    <p>Vui lòng cung cấp thông tin nhận hàng chính xác</p>
                                </div>
                            </div>

                            <div class="checkout-form-group">
                                <label>Họ và tên <span>*</span></label>
                                @Html.TextBoxFor(
                                         m => m.CustomerName,
                                         new
                                         {
                                             @class = "form-control",
                                             placeholder = "Nhập họ và tên người nhận",
                                             required = "required"
                                         }
                                     )
                            </div>

                            <div class="checkout-form-group">
                                <label>Số điện thoại <span>*</span></label>
                                @Html.TextBoxFor(
                                         m => m.CustomerPhone,
                                         new
                                         {
                                             @class = "form-control",
                                             placeholder = "Nhập số điện thoại liên hệ",
                                             type = "tel",
                                             required = "required"
                                         }
                                     )
                            </div>

                            <div class="checkout-form-group">
                                <label>Email <span>*</span></label>
                                @Html.TextBoxFor(
                                         m => m.CustomerEmail,
                                         new
                                         {
                                             @class = "form-control",
                                             placeholder = "example@email.com",
                                             type = "email",
                                             required = "required"
                                         }
                                     )
                            </div>

                            <div class="checkout-form-group" style="margin-bottom:0;">
                                <label>Địa chỉ giao hàng <span>*</span></label>
                                @Html.TextBoxFor(
                                         m => m.CustomerAddress,
                                         new
                                         {
                                             @class = "form-control",
                                             placeholder = "Số nhà, tên đường, phường/xã, quận/huyện...",
                                             required = "required"
                                         }
                                     )
                            </div>

                        </div>

                        <div class="checkout-note">
                            <span>💡</span>
                            <span>
                                Vui lòng kiểm tra kỹ số điện thoại và địa chỉ
                                để BookOra có thể giao sách đến đúng nơi bạn mong muốn.
                            </span>
                        </div>
                    </div>

                    <!-- TÓM TẮT ĐƠN HÀNG -->
                    <div class="col-md-5">
                        <div class="checkout-card">

                            <div class="checkout-card-header">
                                <div class="checkout-icon">🛍️</div>
                                <div>
                                    <h4>Đơn hàng của bạn</h4>
                                    <p>@cart.Count sản phẩm trong giỏ hàng</p>
                                </div>
                            </div>

                            @foreach (var item in cart)
                            {
                                <div class="order-product">
                                    <div class="order-product-info">
                                        <div class="order-product-name">
                                            @item.ProductName
                                        </div>

                                        <div class="order-product-quantity">
                                            Số lượng: @item.Quantity
                                        </div>
                                    </div>

                                    <div class="order-product-price">
                                        @((item.UnitPrice * item.Quantity).ToString("N0")) đ
                                    </div>
                                </div>
                            }

                            <!-- TỔNG TIỀN -->
                            <div class="order-summary">
                                <div class="summary-row">
                                    <span>Tạm tính</span>
                                    <strong>@total.ToString("N0") đ</strong>
                                </div>

                                <div class="summary-row">
                                    <span>Phí vận chuyển</span>
                                    <strong>Được thông báo khi xác nhận</strong>
                                </div>

                                <div class="summary-row summary-total">
                                    <span>Tổng tiền</span>
                                    <span>@total.ToString("N0") đ</span>
                                </div>
                            </div>

                            <!-- PHƯƠNG THỨC THANH TOÁN -->
                            <div class="payment-method">
                                <div class="payment-icon">💵</div>
                                <div class="payment-info">
                                    <strong>Thanh toán khi nhận hàng (COD)</strong>
                                    <span>Thanh toán trực tiếp khi nhận sách</span>
                                </div>
                            </div>

                            <!-- XÁC NHẬN -->
                            <button type="submit" class="checkout-btn">
                                XÁC NHẬN ĐẶT HÀNG &nbsp; →
                            </button>

                            <a href="@Url.Action("Index", "Cart")" class="checkout-back">
                                ← Quay lại giỏ hàng
                            </a>

                        </div>
                    </div>

                </div>
            }
        }

    </div>
</div>
