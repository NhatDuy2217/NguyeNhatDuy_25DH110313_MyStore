
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - BookOra</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            background: #f5f7fb;
            font-family: Arial, Helvetica, sans-serif;
            color: #24344d;
        }

        a {
            transition: .2s ease;
        }

        /* HEADER */
        .customer-header {
            position: relative;
            z-index: 1000;
            background: #fff;
            box-shadow: 0 3px 15px rgba(15, 40, 70, .07);
        }

        .customer-header-top {
            padding: 9px 15px;
            background: #102b50;
            color: #fff;
            text-align: center;
            font-size: 13px;
            letter-spacing: .2px;
        }

        .customer-navbar {
            max-width: 1240px;
            min-height: 82px;
            margin: auto;
            padding: 14px 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 28px;
        }

        /* LOGO */
        .customer-logo {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #174b7c;
            font-size: 27px;
            font-weight: 900;
            text-decoration: none;
            white-space: nowrap;
            letter-spacing: -.8px;
        }

            .customer-logo:hover {
                color: #f59e0b;
                text-decoration: none;
            }

        .customer-logo-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 39px;
            height: 39px;
            background: #edf4fc;
            border-radius: 11px;
            font-size: 22px;
        }

        .customer-logo span:last-child {
            color: #174b7c;
        }

        /* MENU */
        .customer-nav-links {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 27px;
        }

            .customer-nav-links a {
                position: relative;
                color: #334155;
                text-decoration: none;
                font-size: 14px;
                font-weight: 700;
                white-space: nowrap;
            }

                .customer-nav-links a::after {
                    content: "";
                    position: absolute;
                    bottom: -8px;
                    left: 0;
                    width: 0;
                    height: 2px;
                    background: #f59e0b;
                    transition: .2s;
                }

                .customer-nav-links a:hover {
                    color: #174b7c;
                    text-decoration: none;
                }

                    .customer-nav-links a:hover::after {
                        width: 100%;
                    }

        /* ACTIONS */
        .customer-nav-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
            flex-wrap: wrap;
        }

            .customer-nav-actions > a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 38px;
                padding: 9px 12px;
                color: #334155;
                text-decoration: none;
                font-size: 13px;
                font-weight: 700;
                border-radius: 8px;
                white-space: nowrap;
            }

                .customer-nav-actions > a:hover {
                    color: #174b7c;
                    background: #edf4fc;
                    text-decoration: none;
                }

        .customer-user {
            color: #174b7c;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
        }

        /* CART */
        .customer-nav-actions > a.customer-cart {
            padding: 10px 15px;
            background: #fff5e6;
            color: #bd7200;
            border: 1px solid #ffe3b3;
        }

            .customer-nav-actions > a.customer-cart:hover {
                background: #f59e0b;
                border-color: #f59e0b;
                color: white;
            }

        /* ADMIN */
        .customer-nav-actions > a.customer-admin-link {
            background: #102b50;
            color: white;
        }

            .customer-nav-actions > a.customer-admin-link:hover {
                background: #174b7c;
                color: white;
            }

        /* MAIN */
        .customer-content {
            min-height: 65vh;
        }

        /* FOOTER */
        .customer-footer {
            margin-top: 50px;
            padding: 48px 25px 20px;
            background: #102b50;
            color: #cbd5e1;
        }

        .customer-footer-container {
            display: grid;
            grid-template-columns: 2fr 1fr 1.3fr;
            gap: 45px;
            max-width: 1200px;
            margin: auto;
        }

        .footer-brand {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 14px;
            color: white;
            font-size: 25px;
            font-weight: 900;
        }

        .footer-brand-icon {
            font-size: 24px;
        }

        .customer-footer h4 {
            margin: 4px 0 18px;
            color: white;
            font-size: 16px;
            font-weight: 800;
        }

        .customer-footer p {
            margin-bottom: 9px;
            color: #cbd5e1;
            font-size: 13px;
            line-height: 1.9;
        }

        .customer-footer a {
            display: block;
            width: fit-content;
            margin-bottom: 12px;
            color: #cbd5e1;
            font-size: 13px;
            text-decoration: none;
        }

            .customer-footer a:hover {
                color: #fbbf24;
                text-decoration: none;
            }

        .footer-description {
            max-width: 390px;
        }

        .customer-footer-bottom {
            max-width: 1200px;
            margin: 30px auto 0;
            padding-top: 19px;
            border-top: 1px solid rgba(255,255,255,.15);
            color: #94a3b8;
            text-align: center;
            font-size: 12px;
        }

        /* MOBILE BUTTON */
        .customer-menu-toggle {
            display: none;
            width: 42px;
            height: 42px;
            border: 1px solid #dce6f2;
            border-radius: 9px;
            background: #edf4fc;
            color: #174b7c;
            font-size: 23px;
            cursor: pointer;
        }

        /* TABLET */
        @@media (max-width: 1050px) {
            .customer-navbar {
                gap: 15px;
                padding: 14px 18px;
            }

            .customer-nav-links {
                gap: 15px;
            }

            .customer-nav-actions {
                gap: 5px;
            }

                .customer-nav-actions > a {
                    padding: 8px;
                    font-size: 12px;
                }

            .customer-logo {
                font-size: 24px;
            }
        }

        /* MOBILE */
        @@media (max-width: 768px) {
            .customer-header-top {
                padding: 8px 10px;
                font-size: 11px;
            }

            .customer-navbar {
                min-height: auto;
                padding: 13px 16px;
                flex-wrap: wrap;
                gap: 13px;
            }

            .customer-logo {
                font-size: 24px;
            }

            .customer-menu-toggle {
                display: block;
                margin-left: auto;
            }

            .customer-nav-links {
                display: none;
                order: 3;
                width: 100%;
                flex-direction: column;
                align-items: stretch;
                gap: 0;
                padding: 7px 0;
                border-top: 1px solid #edf0f5;
            }

                .customer-nav-links.show {
                    display: flex;
                }

                .customer-nav-links a {
                    padding: 12px 5px;
                    border-bottom: 1px solid #f0f2f5;
                }

                    .customer-nav-links a::after {
                        display: none;
                    }

            .customer-nav-actions {
                order: 4;
                width: 100%;
                justify-content: flex-start;
                gap: 7px;
                padding: 10px 0 3px;
                border-top: 1px solid #edf0f5;
            }

                .customer-nav-actions > a {
                    min-height: 36px;
                    padding: 8px 10px;
                    font-size: 12px;
                }

            .customer-user {
                width: 100%;
                padding: 5px 0;
            }

            .customer-footer {
                padding: 35px 20px 18px;
            }

            .customer-footer-container {
                grid-template-columns: 1fr;
                gap: 24px;
            }

            .customer-footer-bottom {
                margin-top: 20px;
            }
        }

        @@media (max-width: 380px) {
            .customer-nav-actions > a {
                font-size: 11px;
                padding: 7px 8px;
            }

            .customer-logo {
                font-size: 22px;
            }
        }
    </style>

    @RenderSection("styles", required: false)
</head>

<body>

    <!-- HEADER -->
    <header class="customer-header">

        <div class="customer-header-top">
            📚 BookOra - Không gian dành cho những người yêu sách
        </div>

        <div class="customer-navbar">

            <!-- LOGO BOOKORA -->
            @Html.ActionLink(
                     "📚 BookOra",
                     "Index",
                     "Home",
                     new { area = "" },
                     new { @class = "customer-logo" }
                 )

            <!-- MOBILE MENU -->
            <button type="button"
                    class="customer-menu-toggle"
                    id="customerMenuToggle"
                    aria-label="Mở menu"
                    aria-expanded="false"
                    aria-controls="customerNavLinks">
                ☰
            </button>

            <!-- MAIN NAVIGATION -->
            <nav class="customer-nav-links" id="customerNavLinks">

                @Html.ActionLink(
                         "Trang chủ",
                         "Index",
                         "Home",
                         new { area = "" },
                         null
                     )

                @Html.ActionLink(
                         "Danh mục sách",
                         "ProductList",
                         "Home",
                         new { area = "" },
                         null
                     )

                @Html.ActionLink(
                         "Sản phẩm",
                         "Index",
                         "Home",
                         new { area = "" },
                         null
                     )

                @Html.ActionLink(
                         "Giới thiệu",
                         "About",
                         "Home",
                         new { area = "" },
                         null
                     )

                @Html.ActionLink(
                         "Liên hệ",
                         "Contact",
                         "Home",
                         new { area = "" },
                         null
                     )

            </nav>

            <!-- ACCOUNT AND CART -->
            <div class="customer-nav-actions">

                @if (Session["Username"] != null)
                {
                    <span class="customer-user">
                        👤 Xin chào, @Session["Username"]
                    </span>

                    @* ADMIN CHUYỂN VỀ TRANG QUẢN TRỊ *@
                    if (Session["UserRole"] != null &&
                        Session["UserRole"].ToString() == "Admin")
                    {
                        @Html.ActionLink(
                                 "⚙️ Quản trị",
                                 "Index",
                                 "Home",
                                 new { area = "Admin" },
                                 new { @class = "customer-admin-link" }
                             )
                    }

                    @* KHÁCH HÀNG XEM LỊCH SỬ MUA HÀNG *@
                    if (Session["UserRole"] != null &&
                        Session["UserRole"].ToString() == "Customer")
                    {
                        @Html.ActionLink(
                                 "📦 Đơn hàng",
                                 "Index",
                                 "PurchaseHistory",
                                 new { area = "" },
                                 null
                             )
                    }

                    @Html.ActionLink(
                             "Đăng xuất",
                             "Logout",
                             "Account",
                             new { area = "" },
                             null
                         )
                }
                else
                {
                    @Html.ActionLink(
                             "Đăng nhập",
                             "Login",
                             "Account",
                             new { area = "" },
                             null
                         )

                    @Html.ActionLink(
                             "Đăng ký",
                             "Register",
                             "Account",
                             new { area = "" },
                             null
                         )
                }

                <!-- CART -->
                @Html.ActionLink(
                         "🛒 Giỏ hàng",
                         "Index",
                         "Cart",
                         new { area = "" },
                         new { @class = "customer-cart" }
                     )

            </div>

        </div>

    </header>

    <!-- MAIN CONTENT -->
    <main class="customer-content">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="customer-footer">

        <div class="customer-footer-container">

            <!-- BRAND -->
            <div>
                <div class="footer-brand">
                    <span class="footer-brand-icon">📚</span>
                    <span>BookOra</span>
                </div>

                <p class="footer-description">
                    BookOra là không gian mua sắm sách trực tuyến,
                    nơi bạn có thể khám phá nhiều đầu sách và tìm
                    thấy những câu chuyện, kiến thức mà mình yêu thích.
                </p>

                <p>
                    Cảm ơn bạn đã đồng hành cùng BookOra!
                </p>
            </div>

            <!-- INFORMATION -->
            <div>
                <h4>Khám phá BookOra</h4>

                @Html.ActionLink(
                         "Trang chủ",
                         "Index",
                         "Home",
                         new { area = "" },
                         null
                     )

                @Html.ActionLink(
                         "Danh mục sách",
                         "ProductList",
                         "Home",
                         new { area = "" },
                         null
                     )

                @Html.ActionLink(
                         "Giới thiệu",
                         "About",
                         "Home",
                         new { area = "" },
                         null
                     )

                @Html.ActionLink(
                         "Liên hệ",
                         "Contact",
                         "Home",
                         new { area = "" },
                         null
                     )
            </div>

            <!-- CUSTOMER SUPPORT -->
            <div>
                <h4>Hỗ trợ khách hàng</h4>

                @Html.ActionLink(
                         "Tài khoản của tôi",
                         "Login",
                         "Account",
                         new { area = "" },
                         null
                     )

                @Html.ActionLink(
                         "Giỏ hàng",
                         "Index",
                         "Cart",
                         new { area = "" },
                         null
                     )

                @if (Session["Username"] != null &&
                     Session["UserRole"] != null &&
                     Session["UserRole"].ToString() == "Customer")
                {
                    @Html.ActionLink(
                             "Lịch sử mua hàng",
                             "Index",
                             "PurchaseHistory",
                             new { area = "" },
                             null
                         )
                }
            </div>

        </div>

        <div class="customer-footer-bottom">
            © @DateTime.Now.Year BookOra - Website bán sách trực tuyến.
            All rights reserved.
        </div>

    </footer>

    <!-- JAVASCRIPT -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const menuElement = document.getElementById("customerNavLinks");
        const toggleElement = document.getElementById("customerMenuToggle");

        // Kiểm tra đúng kiểu phần tử và tránh lỗi null
        if (!(menuElement instanceof HTMLElement)) {
            return;
        }

        if (!(toggleElement instanceof HTMLButtonElement)) {
            return;
        }

        // Gán vào các biến đã xác định chắc chắn tồn tại
        const menu = menuElement;
        const toggle = toggleElement;

        toggle.addEventListener("click", function () {

            const isOpen = menu.classList.toggle("show");

            toggle.setAttribute(
                "aria-expanded",
                isOpen ? "true" : "false"
            );

            toggle.innerHTML = isOpen ? "×" : "☰";
        });

    });
</script>

    @RenderSection("scripts", required: false)

</body>
</html>
