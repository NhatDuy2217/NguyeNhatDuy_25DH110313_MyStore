
@model NguyeNhatDuy_25DH110313_MyStore.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    .order-detail-page {
        min-height: 80vh;
        background: #f4f7fc;
        padding: 45px 15px 65px;
        font-family: Arial, sans-serif;
    }

    .order-detail-container {
        max-width: 1120px;
        margin: auto;
    }

    /* HEADER */

    .order-detail-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 28px;
    }

    .order-heading-label {
        display: inline-block;
        color: #2563eb;
        background: #e8efff;
        padding: 7px 14px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1px;
        margin-bottom: 12px;
    }

    .order-detail-header h2 {
        color: #172554;
        font-size: 27px;
        font-weight: 800;
        margin: 0 0 9px;
    }

    .order-detail-header p {
        color: #718096;
        font-size: 13px;
        margin: 0;
    }

    .order-header-code {
        background: white;
        border: 1px solid #e8edf5;
        border-radius: 12px;
        padding: 15px 20px;
        box-shadow: 0 4px 15px rgba(23, 37, 84, .04);
    }

        .order-header-code span {
            display: block;
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .order-header-code strong {
            color: #2563eb;
            font-size: 19px;
            font-weight: 800;
        }

    /* STATUS */

    .order-status-banner {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 22px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 13px;
        margin-bottom: 23px;
    }

    .order-status-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #dbeafe;
        color: #2563eb;
        font-size: 20px;
        flex-shrink: 0;
    }

    .order-status-content {
        flex: 1;
    }

        .order-status-content strong {
            display: block;
            color: #1e3a8a;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .order-status-content span {
            color: #64748b;
            font-size: 12px;
            line-height: 1.5;
        }

    .order-status-paid,
    .order-status-unpaid {
        display: inline-block;
        padding: 8px 13px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
    }

    .order-status-paid {
        color: #15803d;
        background: #dcfce7;
    }

    .order-status-unpaid {
        color: #b45309;
        background: #fef3c7;
    }

    /* CARD */

    .order-detail-card {
        background: white;
        border: 1px solid #e8edf5;
        border-radius: 16px;
        padding: 27px;
        margin-bottom: 22px;
        box-shadow: 0 7px 25px rgba(23, 37, 84, .04);
    }

    .order-card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding-bottom: 19px;
        margin-bottom: 22px;
        border-bottom: 1px solid #edf1f7;
    }

    .order-card-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf0ff;
        color: #2563eb;
        border-radius: 11px;
        font-size: 19px;
    }

    .order-card-heading h4 {
        color: #172554;
        font-size: 17px;
        font-weight: 800;
        margin: 0 0 4px;
    }

    .order-card-heading p {
        color: #94a3b8;
        font-size: 12px;
        margin: 0;
    }

    /* ORDER INFO */

    .order-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .order-info-item {
        background: #f7f9fd;
        border: 1px solid #edf1f7;
        border-radius: 10px;
        padding: 15px 16px;
        min-width: 0;
    }

        .order-info-item label {
            display: block;
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

        .order-info-item span {
            color: #334155;
            font-size: 13px;
            font-weight: 700;
            line-height: 1.6;
            word-break: break-word;
        }

        .order-info-item.full-width {
            grid-column: 1 / -1;
        }

    /* PRODUCT TABLE */

    .order-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .order-product-table {
        width: 100%;
        border-collapse: collapse;
    }

        .order-product-table thead th {
            background: #f4f7fc;
            color: #64748b;
            padding: 14px 12px;
            text-align: center;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .order-product-table thead th:first-child {
                text-align: left;
                border-radius: 9px 0 0 9px;
            }

            .order-product-table thead th:last-child {
                border-radius: 0 9px 9px 0;
            }

        .order-product-table td {
            padding: 17px 12px;
            border-bottom: 1px solid #edf1f7;
            text-align: center;
            vertical-align: middle;
            color: #334155;
            font-size: 13px;
        }

        .order-product-table tbody tr:last-child td {
            border-bottom: none;
        }

    .order-product-name {
        display: flex;
        align-items: center;
        gap: 13px;
        text-align: left !important;
        min-width: 220px;
    }

        .order-product-name img {
            width: 58px;
            height: 72px;
            object-fit: contain;
            background: #f6f8fc;
            border: 1px solid #edf1f7;
            border-radius: 7px;
            padding: 3px;
            flex-shrink: 0;
        }

        .order-product-name strong {
            color: #263653;
            font-size: 13px;
            font-weight: 700;
            line-height: 1.5;
        }

    .order-product-price {
        font-weight: 700;
        white-space: nowrap;
    }

    .order-product-quantity {
        display: inline-block;
        min-width: 34px;
        padding: 6px 9px;
        background: #eff6ff;
        color: #2563eb;
        border-radius: 7px;
        font-weight: 800;
    }

    .order-product-subtotal {
        color: #e05252 !important;
        font-weight: 800;
        white-space: nowrap;
    }

    /* TOTAL */

    .order-total-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px dashed #cbd5e1;
    }

    .order-total-box {
        width: 330px;
        max-width: 100%;
        background: #f7f9fd;
        border-radius: 12px;
        padding: 18px 20px;
    }

    .order-total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .order-total-row span:first-child {
            color: #172554;
            font-size: 14px;
            font-weight: 800;
        }

        .order-total-row strong {
            color: #e05252;
            font-size: 23px;
            font-weight: 800;
            white-space: nowrap;
        }

    /* ACTIONS */

    .order-detail-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 27px;
    }

    .btn-order-back,
    .btn-order-shopping {
        display: inline-block;
        padding: 12px 20px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        transition: .2s;
    }

    .btn-order-back {
        background: white;
        color: #475569;
        border: 1px solid #dce3ee;
    }

        .btn-order-back:hover {
            background: #f1f5f9;
            color: #172554;
            text-decoration: none;
        }

    .btn-order-shopping {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        box-shadow: 0 5px 14px rgba(37, 99, 235, .18);
    }

        .btn-order-shopping:hover {
            background: #1d4ed8;
            color: white;
            text-decoration: none;
            transform: translateY(-2px);
        }

    /* RESPONSIVE */

    @@media (max-width: 768px) {
        .order-detail-page {
            padding: 30px 12px 45px;
        }

        .order-detail-header {
            align-items: flex-start;
            flex-direction: column;
        }

            .order-detail-header h2 {
                font-size: 23px;
            }

        .order-header-code {
            width: 100%;
        }

        .order-detail-card {
            padding: 19px;
        }

        .order-info-grid {
            grid-template-columns: 1fr;
        }

        .order-info-item.full-width {
            grid-column: auto;
        }

        .order-product-table {
            min-width: 680px;
        }

        .order-detail-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-order-back,
        .btn-order-shopping {
            text-align: center;
        }
    }

    @@media (max-width: 420px) {
        .order-status-banner {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .order-status-paid,
        .order-status-unpaid {
            margin-left: 56px;
        }

        .order-detail-card {
            padding: 15px;
        }

        .order-total-row strong {
            font-size: 20px;
        }
    }
</style>

<div class="order-detail-page">
    <div class="order-detail-container">

        <!-- HEADER -->
        <div class="order-detail-header">
            <div>
                <span class="order-heading-label">BOOKORA ORDER DETAILS</span>
                <h2>Chi tiết đơn hàng</h2>
                <p>Kiểm tra thông tin và các sản phẩm trong đơn hàng của bạn.</p>
            </div>

            <div class="order-header-code">
                <span>MÃ ĐƠN HÀNG</span>
                <strong>#@Model.OrderID</strong>
            </div>
        </div>

        <!-- TRẠNG THÁI -->
        <div class="order-status-banner">
            <div class="order-status-icon">📦</div>

            <div class="order-status-content">
                <strong>Thông tin trạng thái đơn hàng</strong>
                <span>
                    Cảm ơn bạn đã mua sắm tại BookOra. Dưới đây là thông tin đơn hàng của bạn.
                </span>
            </div>

            @if (Model.PaymentStatus != null &&
                 Model.PaymentStatus.Trim() == "Đã thanh toán")
            {
                <span class="order-status-paid">
                    ✓ Đã thanh toán
                </span>
            }
            else
            {
                <span class="order-status-unpaid">
                    Chưa thanh toán
                </span>
            }
        </div>

        <!-- THÔNG TIN ĐƠN HÀNG -->
        <div class="order-detail-card">

            <div class="order-card-heading">
                <div class="order-card-icon">📋</div>
                <div>
                    <h4>Thông tin đơn hàng</h4>
                    <p>Thông tin đặt hàng và người nhận</p>
                </div>
            </div>

            <div class="order-info-grid">

                <div class="order-info-item">
                    <label>Mã đơn hàng</label>
                    <span>#@Model.OrderID</span>
                </div>

                <div class="order-info-item">
                    <label>Ngày đặt hàng</label>
                    <span>
                        @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div class="order-info-item">
                    <label>Khách hàng</label>
                    <span>
                        @(Model.Customer != null
                            ? Model.Customer.CustomerName
                            : "Không có thông tin")
                    </span>
                </div>

                <div class="order-info-item">
                    <label>Số điện thoại</label>
                    <span>
                        @(Model.Customer != null
                            ? Model.Customer.CustomerPhone
                            : "Không có thông tin")
                    </span>
                </div>

                <div class="order-info-item">
                    <label>Email</label>
                    <span>
                        @(Model.Customer != null
                            ? Model.Customer.CustomerEmail
                            : "Không có thông tin")
                    </span>
                </div>

                <div class="order-info-item">
                    <label>Trạng thái thanh toán</label>

                    @if (Model.PaymentStatus != null &&
                         Model.PaymentStatus.Trim() == "Đã thanh toán")
                    {
                        <span class="order-status-paid">
                            Đã thanh toán
                        </span>
                    }
                    else
                    {
                        <span class="order-status-unpaid">
                            @(String.IsNullOrEmpty(Model.PaymentStatus)
                                ? "Chưa xác định"
                                : Model.PaymentStatus)
                        </span>
                    }
                </div>

                <div class="order-info-item full-width">
                    <label>Địa chỉ giao hàng</label>
                    <span>
                        @Model.AddressDelivery
                    </span>
                </div>

            </div>
        </div>

        <!-- DANH SÁCH SẢN PHẨM -->
        <div class="order-detail-card">

            <div class="order-card-heading">
                <div class="order-card-icon">📚</div>
                <div>
                    <h4>Sản phẩm trong đơn hàng</h4>
                    <p>Danh sách những cuốn sách bạn đã đặt</p>
                </div>
            </div>

            <div class="order-table-wrapper">
                <table class="order-product-table">
                    <thead>
                        <tr>
                            <th style="text-align:left;">Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="order-product-name">

                                        @if (item.Product != null &&
                                             !String.IsNullOrEmpty(item.Product.ProductImage))
                                        {
                                            <img src="@Url.Content(item.Product.ProductImage)"
                                                 alt="@item.Product.ProductName" />
                                        }
                                        else
                                        {
                                            <img src="https://placehold.co/58x72?text=Book"
                                                 alt="Chưa có hình ảnh" />
                                        }

                                        <strong>
                                            @(item.Product != null
                                                ? item.Product.ProductName
                                                : "Sản phẩm không tồn tại")
                                        </strong>

                                    </div>
                                </td>

                                <td class="order-product-price">
                                    @item.UnitPrice.ToString("N0") đ
                                </td>

                                <td>
                                    <span class="order-product-quantity">
                                        @item.Quantity
                                    </span>
                                </td>

                                <td class="order-product-subtotal">
                                    @((item.UnitPrice * item.Quantity).ToString("N0")) đ
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- TỔNG TIỀN -->
            <div class="order-total-wrapper">
                <div class="order-total-box">
                    <div class="order-total-row">
                        <span>Tổng thanh toán</span>
                        <strong>@Model.TotalAmount.ToString("N0") đ</strong>
                    </div>
                </div>
            </div>

        </div>

        <!-- NÚT ĐIỀU HƯỚNG -->
        <div class="order-detail-actions">

            <a href="@Url.Action("Index", "PurchaseHistory")"
               class="btn-order-back">
                ← Quay lại lịch sử mua hàng
            </a>

            <a href="@Url.Action("ProductList", "Home")"
               class="btn-order-shopping">
                Tiếp tục mua sắm &nbsp; →
            </a>

        </div>

    </div>
</div>
