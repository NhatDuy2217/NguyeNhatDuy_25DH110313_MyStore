
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    .login-page {
        min-height: 78vh;
        padding: 55px 20px;
        background: radial-gradient(circle at 10% 15%, rgba(69, 112, 190, .10), transparent 28%), radial-gradient(circle at 90% 85%, rgba(231, 170, 54, .12), transparent 25%), #f4f7fc;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-container {
        width: 100%;
        max-width: 980px;
        min-height: 540px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 18px 55px rgba(27, 48, 87, .10);
    }

    /* LEFT BRAND PANEL */
    .login-brand {
        position: relative;
        padding: 55px 45px;
        background: linear-gradient(145deg, #172f61, #3157a4);
        color: #fff;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
    }

        .login-brand::before,
        .login-brand::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
        }

        .login-brand::before {
            width: 300px;
            height: 300px;
            top: -120px;
            right: -100px;
        }

        .login-brand::after {
            width: 230px;
            height: 230px;
            bottom: -100px;
            left: -90px;
        }

    .brand-content {
        position: relative;
        z-index: 1;
    }

    .brand-logo {
        font-size: 29px;
        font-weight: 800;
        letter-spacing: -.5px;
        margin-bottom: 45px;
    }

        .brand-logo span {
            color: #f2bb50;
        }

    .brand-icon {
        font-size: 55px;
        margin-bottom: 20px;
    }

    .login-brand h2 {
        font-size: 29px;
        line-height: 1.4;
        font-weight: 800;
        margin-bottom: 17px;
    }

    .login-brand p {
        color: rgba(255,255,255,.82);
        font-size: 15px;
        line-height: 1.8;
        margin-bottom: 28px;
    }

    .brand-benefit {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 17px;
        color: rgba(255,255,255,.94);
        font-size: 14px;
    }

    .brand-benefit-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(255,255,255,.15);
        display: flex;
        justify-content: center;
        align-items: center;
        color: #f2bb50;
        flex-shrink: 0;
    }

    /* RIGHT LOGIN FORM */
    .login-form-panel {
        padding: 55px 50px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .login-heading {
        color: #172b4d;
        font-size: 29px;
        font-weight: 800;
        margin-bottom: 9px;
    }

    .login-subtitle {
        color: #8993a6;
        font-size: 14px;
        margin-bottom: 30px;
        line-height: 1.6;
    }

    .login-label {
        display: block;
        color: #34445e;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .login-input-group {
        position: relative;
        margin-bottom: 22px;
    }

    .login-input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #8993a6;
        font-size: 17px;
        z-index: 2;
    }

    .login-input {
        width: 100%;
        height: 49px;
        border: 1px solid #e0e5ef;
        border-radius: 10px;
        padding: 0 15px 0 45px;
        color: #263753;
        font-size: 14px;
        outline: none;
        transition: .2s;
        background: #fff;
        box-sizing: border-box;
    }

        .login-input:focus {
            border-color: #3157a4;
            box-shadow: 0 0 0 3px rgba(49, 87, 164, .09);
        }

        .login-input::placeholder {
            color: #aab2c0;
        }

    .login-btn {
        width: 100%;
        height: 49px;
        border: none;
        border-radius: 10px;
        background: #3157a4;
        color: #fff;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: .4px;
        cursor: pointer;
        transition: .25s;
        margin-top: 5px;
    }

        .login-btn:hover {
            background: #203f82;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(49, 87, 164, .2);
        }

    .login-footer {
        text-align: center;
        color: #778197;
        font-size: 14px;
        margin-top: 25px;
    }

        .login-footer a {
            color: #3157a4;
            font-weight: 700;
            text-decoration: none;
        }

            .login-footer a:hover {
                color: #e49b18;
                text-decoration: underline;
            }

    .login-error {
        padding: 12px 14px;
        margin-bottom: 18px;
        background: #fff0f0;
        border: 1px solid #ffd5d5;
        border-radius: 9px;
        color: #c83232;
        font-size: 13px;
        line-height: 1.5;
    }

    .login-success {
        padding: 12px 14px;
        margin-bottom: 18px;
        background: #edfaf2;
        border: 1px solid #c9eed7;
        border-radius: 9px;
        color: #198754;
        font-size: 13px;
        line-height: 1.5;
    }

    .login-security-note {
        text-align: center;
        color: #a0a8b6;
        font-size: 12px;
        margin-top: 25px;
    }

    /* RESPONSIVE */
    @@media (max-width: 768px) {
        .login-page {
            padding: 30px 15px;
        }

        .login-container {
            grid-template-columns: 1fr;
            max-width: 470px;
        }

        .login-brand {
            padding: 30px;
        }

        .brand-logo {
            font-size: 25px;
            margin-bottom: 20px;
        }

        .brand-icon {
            font-size: 38px;
            margin-bottom: 10px;
        }

        .login-brand h2 {
            font-size: 23px;
        }

        .login-brand p {
            margin-bottom: 15px;
        }

        .brand-benefit {
            margin-top: 10px;
        }

        .login-form-panel {
            padding: 35px 28px;
        }

        .login-heading {
            font-size: 25px;
        }
    }
</style>

<div class="login-page">
    <div class="login-container">

        <!-- LEFT BRAND -->
        <div class="login-brand">
            <div class="brand-content">

                <div class="brand-logo">
                    Book<span>Ora</span>
                </div>

                <div class="brand-icon">📚</div>

                <h2>Mỗi cuốn sách là một hành trình mới</h2>

                <p>
                    Chào mừng bạn đến với BookOra – nơi kết nối những người
                    yêu sách với kho tàng tri thức và những câu chuyện thú vị.
                </p>

                <div class="brand-benefit">
                    <span class="brand-benefit-icon">✓</span>
                    Khám phá nhiều đầu sách hấp dẫn
                </div>

                <div class="brand-benefit">
                    <span class="brand-benefit-icon">✓</span>
                    Quản lý đơn hàng thuận tiện
                </div>

                <div class="brand-benefit">
                    <span class="brand-benefit-icon">✓</span>
                    Mua sắm dễ dàng và nhanh chóng
                </div>

            </div>
        </div>

        <!-- RIGHT LOGIN FORM -->
        <div class="login-form-panel">

            <h2 class="login-heading">Đăng nhập</h2>

            <p class="login-subtitle">
                Đăng nhập để tiếp tục khám phá thế giới sách tại BookOra.
            </p>

            @if (TempData["Success"] != null)
            {
                <div class="login-success">
                    ✓ @TempData["Success"]
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="login-error">
                    @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <label class="login-label">Tên đăng nhập</label>

                <div class="login-input-group">
                    <span class="login-input-icon glyphicon glyphicon-user"></span>

                    <input type="text"
                           name="username"
                           class="login-input"
                           placeholder="Nhập tên đăng nhập"
                           autocomplete="username"
                           required />
                </div>

                <label class="login-label">Mật khẩu</label>

                <div class="login-input-group">
                    <span class="login-input-icon glyphicon glyphicon-lock"></span>

                    <input type="password"
                           name="password"
                           class="login-input"
                           placeholder="Nhập mật khẩu"
                           autocomplete="current-password"
                           required />
                </div>

                <button type="submit" class="login-btn">
                    ĐĂNG NHẬP
                    <span class="glyphicon glyphicon-arrow-right"></span>
                </button>
            }

            <div class="login-footer">
                Chưa có tài khoản?
                <a href="@Url.Action("Register", "Account")">
                    Đăng ký ngay
                </a>
            </div>

            <div class="login-security-note">
                🔒 Thông tin đăng nhập của bạn được bảo vệ
            </div>

        </div>
    </div>
</div>
