
@{
    ViewBag.Title = "Giới thiệu BookOra";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    .about-page {
        background: #f5f7fb;
        color: #17365d;
        padding-bottom: 60px;
    }

    .about-container {
        max-width: 1200px;
        margin: auto;
        padding: 0 15px;
    }

    /* BANNER GIỚI THIỆU */
    .about-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(115deg, #102f55, #174d7d 60%, #2878a8);
        color: white;
        border-radius: 18px;
        margin: 28px 0 35px;
        padding: 75px 35px;
        text-align: center;
        box-shadow: 0 10px 28px rgba(16, 47, 85, .13);
    }

        .about-hero::before,
        .about-hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
            pointer-events: none;
        }

        .about-hero::before {
            width: 260px;
            height: 260px;
            top: -150px;
            left: -65px;
        }

        .about-hero::after {
            width: 300px;
            height: 300px;
            bottom: -210px;
            right: -70px;
        }

    .about-hero-content {
        position: relative;
        z-index: 1;
        max-width: 800px;
        margin: auto;
    }

    .about-label {
        display: inline-block;
        padding: 8px 17px;
        margin-bottom: 20px;
        border: 1px solid rgba(255,255,255,.3);
        border-radius: 30px;
        background: rgba(255,255,255,.1);
        font-size: 13px;
        font-weight: 600;
    }

    .about-hero h1 {
        color: white;
        font-size: 42px;
        font-weight: 800;
        margin-bottom: 18px;
    }

        .about-hero h1 span {
            color: #ffab32;
        }

    .about-hero p {
        max-width: 700px;
        margin: auto;
        color: #e5effa;
        font-size: 17px;
        line-height: 1.9;
    }

    /* TIÊU ĐỀ CÁC KHU VỰC */
    .about-heading {
        text-align: center;
        margin: 48px 0 25px;
    }

        .about-heading .about-small-title {
            color: #ed9418;
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 9px;
        }

        .about-heading h2 {
            color: #123b68;
            font-size: 29px;
            font-weight: 800;
            margin: 0 0 12px;
        }

        .about-heading p {
            max-width: 720px;
            margin: auto;
            color: #64748b;
            font-size: 15px;
            line-height: 1.8;
        }

    /* CÂU CHUYỆN BOOKORA */
    .about-story {
        display: grid;
        grid-template-columns: 1.1fr .9fr;
        gap: 28px;
        align-items: stretch;
        margin-top: 30px;
    }

    .about-story-content {
        background: white;
        padding: 35px;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(15, 45, 80, .05);
    }

        .about-story-content h2 {
            color: #123b68;
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 20px;
        }

        .about-story-content p {
            color: #526276;
            font-size: 15px;
            line-height: 1.95;
            margin-bottom: 15px;
        }

    .about-story-highlight {
        background: #fff7e9;
        border-left: 4px solid #f59e0b;
        border-radius: 8px;
        padding: 17px 20px;
        margin-top: 22px;
        color: #684b1e;
        line-height: 1.8;
        font-size: 15px;
    }

    .about-story-visual {
        min-height: 330px;
        border-radius: 16px;
        background: linear-gradient(145deg, #e4effa, #fff1dc);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 30px;
        box-shadow: 0 4px 18px rgba(15, 45, 80, .05);
    }

    .about-book-icon {
        font-size: 90px;
        margin-bottom: 15px;
    }

    .about-story-visual h3 {
        color: #123b68;
        font-size: 25px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .about-story-visual p {
        color: #526276;
        font-size: 15px;
        line-height: 1.8;
        max-width: 320px;
        margin: 0;
    }

    /* SỨ MỆNH */
    .about-mission {
        background: #123b68;
        color: white;
        padding: 38px 35px;
        border-radius: 16px;
        margin-top: 45px;
        text-align: center;
    }

    .about-mission-icon {
        font-size: 42px;
        margin-bottom: 12px;
    }

    .about-mission h2 {
        color: white;
        font-size: 27px;
        font-weight: 800;
        margin-bottom: 15px;
    }

    .about-mission p {
        max-width: 820px;
        margin: auto;
        color: #e2edf8;
        font-size: 15px;
        line-height: 1.9;
    }

    .about-mission strong {
        color: #ffb13b;
    }

    /* GIÁ TRỊ */
    .about-values {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
        margin-top: 28px;
    }

    .about-value-card {
        background: white;
        border: 1px solid #edf1f6;
        border-radius: 15px;
        padding: 30px 23px;
        text-align: center;
        box-shadow: 0 4px 16px rgba(15, 45, 80, .04);
        transition: .25s;
    }

        .about-value-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(15, 45, 80, .09);
        }

    .about-value-icon {
        width: 68px;
        height: 68px;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 18px;
        border-radius: 18px;
        background: #edf5ff;
        font-size: 32px;
    }

    .about-value-card:nth-child(2) .about-value-icon {
        background: #fff4e4;
    }

    .about-value-card:nth-child(3) .about-value-icon {
        background: #e9f8f1;
    }

    .about-value-card h3 {
        color: #123b68;
        font-size: 19px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .about-value-card p {
        color: #64748b;
        font-size: 14px;
        line-height: 1.8;
        margin: 0;
    }

    /* LỜI KẾT */
    .about-cta {
        background: linear-gradient(110deg, #fff, #fff8ec);
        border: 1px solid #f5e7ce;
        border-radius: 16px;
        text-align: center;
        padding: 42px 25px;
        margin-top: 48px;
    }

        .about-cta h2 {
            color: #123b68;
            font-size: 27px;
            font-weight: 800;
            margin-bottom: 13px;
        }

        .about-cta p {
            color: #64748b;
            font-size: 15px;
            line-height: 1.8;
            margin-bottom: 22px;
        }

    .about-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: #f59e0b;
        color: white;
        padding: 13px 27px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 15px;
        font-weight: 700;
        transition: .2s;
    }

        .about-button:hover {
            background: #d97706;
            color: white;
            text-decoration: none;
            transform: translateY(-2px);
        }

    /* RESPONSIVE */
    @@media (max-width: 768px) {
        .about-hero {
            padding: 50px 20px;
        }

            .about-hero h1 {
                font-size: 30px;
            }

            .about-hero p {
                font-size: 15px;
            }

        .about-story {
            grid-template-columns: 1fr;
        }

        .about-story-content {
            padding: 25px 22px;
        }

        .about-story-visual {
            min-height: 260px;
        }

        .about-values {
            grid-template-columns: 1fr;
        }

        .about-heading h2 {
            font-size: 24px;
        }

        .about-mission {
            padding: 30px 22px;
        }

            .about-mission h2,
            .about-cta h2 {
                font-size: 23px;
            }

        .about-cta {
            padding: 32px 20px;
        }
    }
</style>

<div class="about-page">
    <div class="about-container">

        <!-- BANNER -->
        <section class="about-hero">
            <div class="about-hero-content">

                <div class="about-label">
                    📚 KHÔNG GIAN DÀNH CHO NGƯỜI YÊU SÁCH
                </div>

                <h1>
                    Khám phá thế giới cùng <span>BookOra</span>
                </h1>

                <p>
                    Mỗi cuốn sách là một hành trình mới.
                    BookOra mong muốn đồng hành cùng bạn trên con đường
                    khám phá tri thức, nuôi dưỡng ước mơ và phát triển bản thân.
                </p>

            </div>
        </section>

        <!-- CÂU CHUYỆN -->
        <div class="about-heading">
            <div class="about-small-title">Về chúng tôi</div>
            <h2>Một không gian dành cho tri thức</h2>
            <p>
                BookOra được xây dựng với mong muốn đưa sách đến gần hơn
                với mọi người và tạo nên trải nghiệm mua sắm thuận tiện.
            </p>
        </div>

        <section class="about-story">

            <div class="about-story-content">
                <h2>📖 Câu chuyện của BookOra</h2>

                <p>
                    BookOra là cửa hàng sách trực tuyến được xây dựng
                    với mong muốn mang những cuốn sách hữu ích đến gần hơn
                    với độc giả.
                </p>

                <p>
                    Tại BookOra, bạn có thể khám phá nhiều thể loại sách
                    khác nhau như văn học, kinh tế, kỹ năng sống,
                    giáo dục, khoa học và phát triển bản thân.
                </p>

                <p>
                    Chúng tôi hướng đến một không gian mua sắm trực tuyến
                    thân thiện, nơi khách hàng có thể dễ dàng tìm kiếm,
                    lựa chọn và đặt mua những cuốn sách phù hợp.
                </p>

                <div class="about-story-highlight">
                    <strong>BookOra – Tri thức mở lối, ước mơ bay xa.</strong>
                    <br />
                    Hãy để mỗi trang sách mở ra một hành trình mới.
                </div>
            </div>

            <div class="about-story-visual">
                <div class="about-book-icon">📚</div>
                <h3>BookOra</h3>
                <p>
                    Đọc sách hôm nay – Kiến tạo ngày mai.
                    Cùng nhau lan tỏa niềm yêu thích đọc sách.
                </p>
            </div>

        </section>

        <!-- SỨ MỆNH -->
        <section class="about-mission">

            <div class="about-mission-icon">🎯</div>

            <h2>Sứ mệnh của chúng tôi</h2>

            <p>
                BookOra mong muốn lan tỏa văn hóa đọc, khuyến khích
                tinh thần học hỏi và tạo điều kiện để mọi người tiếp cận
                với nguồn tri thức đa dạng thông qua sách.
                <br /><br />
                <strong>
                    Mỗi cuốn sách là một cánh cửa mở ra kiến thức,
                    trải nghiệm và những cơ hội mới.
                </strong>
            </p>

        </section>

        <!-- GIÁ TRỊ -->
        <div class="about-heading">
            <div class="about-small-title">Điều chúng tôi hướng đến</div>
            <h2>Giá trị của BookOra</h2>
            <p>
                Những giá trị làm nền tảng cho trải nghiệm mua sắm
                và hành trình đồng hành cùng độc giả.
            </p>
        </div>

        <section class="about-values">

            <div class="about-value-card">
                <div class="about-value-icon">📖</div>
                <h3>Tri thức</h3>
                <p>
                    Mang đến nhiều lựa chọn sách đa dạng,
                    giúp độc giả không ngừng học hỏi và phát triển.
                </p>
            </div>

            <div class="about-value-card">
                <div class="about-value-icon">🤝</div>
                <h3>Tận tâm</h3>
                <p>
                    Đặt trải nghiệm và sự hài lòng của khách hàng
                    làm ưu tiên trong quá trình phục vụ.
                </p>
            </div>

            <div class="about-value-card">
                <div class="about-value-icon">💙</div>
                <h3>Tiện lợi</h3>
                <p>
                    Xây dựng trải nghiệm mua sắm trực tuyến
                    đơn giản, dễ sử dụng và thuận tiện.
                </p>
            </div>

        </section>

        <!-- LỜI KẾT -->
        <section class="about-cta">

            <h2>Bắt đầu hành trình khám phá tri thức!</h2>

            <p>
                Một cuốn sách hay có thể mở ra một góc nhìn mới.
                Hãy tìm cuốn sách tiếp theo dành cho bạn tại BookOra.
            </p>

            <a href="@Url.Action("ProductList", "Home")"
               class="about-button">
                📚 Khám phá sách ngay
                <span>→</span>
            </a>

        </section>

    </div>
</div>
